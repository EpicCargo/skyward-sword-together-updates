+static bool motion_source_live(const SstMotionTrack *track, const SstPlayer *players,
+                              int count, uint64_t now) {
+    bool previous = track->from != motion.owner;
+    if (previous && (track->from != motion.previous_owner || now < motion.owner_since_ms ||
+        now - motion.owner_since_ms > SST_MOTION_HANDOFF_MS)) return false;
+    for (int i = 0; i < count; i++) {
+        const SstPlayer *p = &players[i];
+        if (!p->active || p->id != track->from || !p->has_pose ||
+            p->presence_generation != track->presence_generation || strcmp(p->team, g_sst.team) ||
+            !sst_world_same_area(&p->scene, &motion.scene) || !p->pose.health ||
+            p->pose_time_ms > now || now - p->pose_time_ms > SST_MOTION_FRESH_MS) continue;
+        // An old owner's last in-flight sample may bridge a menu handoff, but
+        // never a departed/rejoined/dead/boss source or one with motion disabled.
+        return previous ? (p->pose.equip_flags & 0xa0) == SST_MOTION_CAPABLE :
+            sst_motion_eligible(p->pose.equip_flags, p->pose.health, p->pose_time_ms, now);
+    }
+    return false;
+}
+static void follow_frame(uint64_t now) {
+    if (!motion_follow) return;
+    now = sst_now_ms();
+    bool progress, enemy; sst_world_options(&progress, &enemy); (void)progress;
+    if (!enemy || !g_sst.sync_enemies || !g_sst.sync_enemy_motion || !sst_motion_enabled() ||
+        sst_net_status(NULL, 0) != SST_ONLINE || motion_follow_generation != sst_net_generation()) {
+        motion_clear(); return;
+    }
+    if (now < paused_until || boss_latch || event_active() || native_paused() || !reloader_idle() ||
+        r32(DELETE_REQUEST) != 0xf81e0ff3u || r32(TRIGGER_ENTRANCE) != 0xd10203ffu) return;
+    SstLocal local = sst_game_read_local(&SST_LAYOUT_SSHD_100, 0);
+    uint64_t player = local.player_address;
+    if (!local.valid || !local.pose.health || !local.pose.max_health || !ptr(player, 0x470) ||
+        player != r64(PLAYER) || r16(player + 0x10) != 0xc8 || r8(player + 0x12) != 1 ||
+        r8(player + 0x13) || r8(player + 0x14) || r32(player + 8) != motion.load ||
+        !sst_world_same_area(&local.scene, &motion.scene) ||
+        sst_world_trial_stage(local.scene.stage) || sst_world_boss_stage(local.scene.stage)) {
+        motion_clear(); return;
+    }
+    uint16_t mine = sst_net_my_id();
+    if (!mine || motion.owner == mine ||
+        sst_net_motion_owner(&local.scene, true) != motion.owner) return;
+    // Every write follows a complete fresh bounded tree traversal on this native
+    // thread. Old heap bytes, cached addresses or packet IDs never prove liveness.
+    if (find_actors(player, local.scene.room) || actor_overflow) { motion_clear(); return; }
+    SstPlayer players[SST_MAX_PLAYERS]; int count = sst_net_players(players, SST_MAX_PLAYERS);
+    for (unsigned i = 0; i < actor_count; i++) {
+        const Actor *a = &actors[i];
+        if (!motion_actor_live(a, local.scene.room)) continue;
+        bool ambiguous = false;
+        for (unsigned j = 0; j < actor_count; j++)
+            if (j != i && actors[j].key == a->key && actors[j].profile == a->profile) ambiguous = true;
+        if (ambiguous) continue;
+        const SstMotionTrack *track = NULL;
+        for (unsigned j = 0; j < SST_ENEMIES; j++) {
+            const SstMotionTrack *candidate = &motion.actors[j];
+            if (candidate->used && candidate->has_target && candidate->key == a->key &&
+                candidate->instance == a->instance && candidate->profile == a->profile) {
+                track = candidate; break;
+            }
+        }
+        float pos[3], velocity[3]; int16_t rotation[3];
+        if (!track || !motion_source_live(track, players, count, now) ||
+            !sst_motion_sample(&motion, a->key, a->instance, now, pos, rotation, velocity)) continue;
+        bool valid = true;
+        for (unsigned j = 0; j < 3; j++)
+            if (!isfinite(pos[j]) || fabsf(pos[j]) > 1e6f ||
+                !isfinite(velocity[j]) || fabsf(velocity[j]) > 1000) valid = false;
+        if (!valid) continue;
+        if (sst_net_status(NULL, 0) != SST_ONLINE || motion_follow_generation != sst_net_generation()) {
+            motion_clear(); return;
+        }
+        // Current transform only: never health, AI, animation, home/spawn copies,
+        // scripts or lifecycle. A native health0 actor can never be resurrected.
+        memcpy((void *)(uintptr_t)(a->address + 0x144), pos, sizeof pos);
+        memcpy((void *)(uintptr_t)(a->address + 0x13c), rotation, sizeof rotation);
+        memcpy((void *)(uintptr_t)(a->address + 0x1e8), velocity, sizeof velocity);
+        motion_applied++;
+    }
+}
