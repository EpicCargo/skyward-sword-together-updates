diff --git a/runtime/hle/sst_dev.c b/runtime/hle/sst_dev.c
new file mode 100644
index 0000000..9d4ae3a
--- /dev/null
+++ b/runtime/hle/sst_dev.c
@@ -0,0 +1,330 @@
+// SSHD developer tools: queued UI intent, executed only on the game thread.
+#include "../hle.h"
+#include "sst_dev.h"
+#include "../ui/menu.h"
+#include "../sst/sst_game.h"
+#include "../sst/sst_dev_tools.h"
+#include "../sst/sst_destinations.h"
+#include "../sst/sst_teleport.h"
+#include <math.h>
+#include <pthread.h>
+extern bool menu_input_captured(void);
+#include <stdatomic.h>
+#include <stdio.h>
+#include <string.h>
+
+#define PLAYER UINT64_C(0x7002bf9940)
+#define RELOADER UINT64_C(0x7002bf9930)
+#define EVENT UINT64_C(0x700182ded8)
+#define PLAYER_VT UINT64_C(0x7001637d28)
+#define PLAYER_UPDATE UINT64_C(0x7000ab7cf4)
+#define SET_POS_ROT UINT64_C(0x7000adb964)
+#define ENTRANCE UINT64_C(0x7000df4fdc)
+#define CRR_POS UINT64_C(0x7000facfe4)
+#define START_SMALL_JUMP UINT64_C(0x7000a90be4)
+#define ACCH 0x3ca8u
+#define BIT(n) (UINT64_C(1)<<(n))
+static uint64_t read64(uint64_t p){uint64_t v;memcpy(&v,(void *)(uintptr_t)p,8);return v;}
+static uint32_t read32(uint64_t p){uint32_t v;memcpy(&v,(void *)(uintptr_t)p,4);return v;}
+static uint16_t read16(uint64_t p){uint16_t v;memcpy(&v,(void *)(uintptr_t)p,2);return v;}
+static void write32(uint64_t p,uint32_t v){memcpy((void *)(uintptr_t)p,&v,4);}
+static void write_float(uint64_t p,float v){memcpy((void *)(uintptr_t)p,&v,4);}
+static bool ptr(uint64_t p,size_t size){return p>=GUEST_LO && p<GUEST_HI && size<=GUEST_HI-p;}
+static GuestFn original_update;
+static bool registered,bindings;
+static atomic_bool noclip_capable, input_allowed;
+static _Thread_local bool in_dev, in_update;
+typedef struct {uint64_t buttons,at;int32_t x,y;bool captured;} DevInput;
+static DevInput input;
+static pthread_mutex_t input_mutex=PTHREAD_MUTEX_INITIALIZER;
+static SstDevRequest pending;
+static SstTeleport teleport;
+static uint64_t pending_since,scratch,tracked_actor;
+static uint32_t tracked_instance;
+static SstScene tracked_scene;
+static bool destination_loading;
+static uint32_t before_destination_load;
+static SstScene destination_scene;
+static uint64_t last_flight_ms;
+static float flight_pos[3];
+static bool was_flying;
+
+// Bounded scalar counters for native verification. No palettes/guest pointers retained.
+struct {uint64_t updates,moon_writes,noclip_scopes,noclip_restores,placements,loads,flight_steps,rejections;
+        uint32_t flags_before,flags_after;float last_position[3];uint32_t moon_launches;} sst_dev_native_stats;
+
+static bool actor_same(uint64_t player,uint32_t instance) {
+    return ptr(player,0x6b00) && read64(PLAYER)==player && read64(player)==PLAYER_VT &&
+        read32(player+8)==instance && read16(player+0x10)==0xc8 &&
+        *(uint8_t *)(uintptr_t)(player+0x12)==1 && read64(player+0x38)==player;
+}
+static bool acch_owned(uint64_t player) {
+    uint64_t a=player+ACCH;
+    return ptr(a,0xf8) && read64(a+0x68)==player+0x144 && read64(a+0x70)==player+0x1b0 &&
+        read64(a+0x88)==player+0x1e8 && read64(a+0xe0)==player;
+}
+static bool loader_idle(void) {uint64_t p=read64(RELOADER);return ptr(p,0x352)&&read16(p+0x350)==703;}
+static bool ordinary_game(SstLocal *out) {
+    if(!g_is_skyward || ENV("SST_NO_PLAYER_READ"))return false;
+    SstLocal l=sst_game_read_local(&SST_LAYOUT_SSHD_100,0);
+    if(!l.valid || !l.pose.health || !l.pose.max_health || !actor_same(l.player_address,l.player_instance))return false;
+    if(out)*out=l; // preserve valid identity/area while temporarily paused or loading
+    uint64_t e=read64(EVENT);
+    if(!ptr(e,0x24c)||read32(e+0x248)||read32(UINT64_C(0x7001827370))||
+       read32(UINT64_C(0x7001827374))||read32(UINT64_C(0x7001827378))||!loader_idle())return false;
+    return true;
+}
+static bool same_scene(const SstScene *a,const SstScene *b) {
+    return !strcmp(a->stage,b->stage) && a->room==b->room && a->layer==b->layer && a->entrance==b->entrance;
+}
+static bool foot_action(uint16_t action) {return action<=22;}
+static bool travel_action(uint16_t action) {return action==0 || action==2 || action==3;}
+static bool catalogue_scene(const SstScene *s) {
+    return s && sst_destination_valid(s->stage,s->room,s->layer,s->entrance);
+}
+// Native normal SmallJump initializer: this, yaw pointer, type0, NULL actor.
+// Its own state/animation setup releases the grounded FSM; raw VY alone does not.
+static bool launch_moon(Cpu *c,const SstLocal *local) {
+    if(!actor_same(local->player_address,local->player_instance) || !ptr(c->sp-128,128) ||
+       read32(START_SMALL_JUMP)!=0xfc1b0fe8 || read32(START_SMALL_JUMP+0x24)!=0x52800201 ||
+       read32(START_SMALL_JUMP+0x40)!=0x97fe1487 || !dispatch_lookup(START_SMALL_JUMP))return false;
+    if(!scratch)scratch=(uint64_t)(uintptr_t)hle_alloc(64);
+    uint16_t yaw=(uint16_t)local->pose.rot[1];memcpy((void *)(uintptr_t)(scratch+48),&yaw,2);
+    float forward;memcpy(&forward,(void *)(uintptr_t)(local->player_address+0x1dc),4);
+    if(!isfinite(forward) || fabsf(forward)>1000)return false;
+    Cpu saved=*c;c->x[0]=local->player_address;c->x[1]=scratch+48;c->x[2]=0;c->x[3]=0;
+    c->x[4]=c->x[5]=c->x[6]=c->x[7]=0;guest_call(c,START_SMALL_JUMP);*c=saved;
+    if(!actor_same(local->player_address,local->player_instance) || read32(local->player_address+0x468)!=16)return false;
+    // Keep the existing movement intent instead of the initializer's forward boost.
+    write_float(local->player_address+0x1dc,forward);sst_dev_native_stats.moon_launches++;
+    return true;
+}
+static void zero_velocity(uint64_t player) {
+    write_float(player+0x1dc,0);write_float(player+0x1e8,0);write_float(player+0x1ec,0);write_float(player+0x1f0,0);
+}
+static bool place(Cpu *c,SstLocal local,const float pos[3],const int16_t rot[3]) {
+    if(!bindings || !actor_same(local.player_address,local.player_instance) || !ptr(c->sp-128,128))return false;
+    for(unsigned i=0;i<3;i++)if(!isfinite(pos[i])||fabsf(pos[i])>1e6f)return false;
+    if(!scratch)scratch=(uint64_t)(uintptr_t)hle_alloc(64);
+    memcpy((void *)(uintptr_t)(scratch+16),pos,12);memcpy((void *)(uintptr_t)(scratch+32),rot,6);
+    Cpu saved=*c;c->x[0]=local.player_address;c->x[1]=scratch+16;c->x[2]=scratch+32;
+    c->x[3]=1;c->x[4]=0;c->x[5]=0;c->x[6]=0;c->x[7]=0;
+    guest_call(c,SET_POS_ROT);*c=saved;
+    if(!actor_same(local.player_address,local.player_instance))return false;
+    float actual[3];memcpy(actual,(void *)(uintptr_t)(local.player_address+0x144),12);
+    for(unsigned i=0;i<3;i++)if(!isfinite(actual[i])||fabsf(actual[i]-pos[i])>.05f)return false;
+    zero_velocity(local.player_address);sst_dev_native_stats.placements++;
+    memcpy(sst_dev_native_stats.last_position,pos,12);return true;
+}
+static bool load_area(Cpu *c,const SstScene *scene) {
+    if(!bindings || !catalogue_scene(scene)||!loader_idle()||!ptr(c->sp-64,64))return false;
+    if(!scratch)scratch=(uint64_t)(uintptr_t)hle_alloc(64);
+    memset((void *)(uintptr_t)scratch,0,16);memcpy((void *)(uintptr_t)scratch,scene->stage,strnlen(scene->stage,8));
+    Cpu saved=*c;c->sp-=64;memset((void *)(uintptr_t)c->sp,0,32);
+    uint16_t option=15;memcpy((void *)(uintptr_t)c->sp,&option,2);write32(c->sp+16,0xff);
+    c->x[0]=read64(RELOADER);c->x[1]=scratch;c->x[2]=scene->room;c->x[3]=scene->layer;c->x[4]=scene->entrance;
+    c->x[5]=2;c->x[6]=2;c->x[7]=0;guest_call(c,ENTRANCE);*c=saved;sst_dev_native_stats.loads++;
+    return true;
+}
+// A player's SCENE entrance can be the old entry after walking between rooms.
+// Load another real arrival in the SAME stage/room/layer, then wait for a fresh
+// peer pose. Never substitute another room/layer or copy progress to force one.
+static bool peer_arrival(const SstScene *target,SstScene *out) {
+    const SstDestination *d=sst_destination_find(target->stage,target->room,target->layer,target->entrance);
+    if(d && !(d->flags&SST_DEST_EVENT_OR_TITLE)){*out=*target;return true;}
+    for(size_t i=0;i<sst_destination_count();i++) {
+        d=sst_destination_at(i);
+        if(!(d->flags&SST_DEST_EVENT_OR_TITLE) && !strcmp(d->stage,target->stage) && d->room==target->room && d->layer==target->layer) {
+            *out=*target;out->entrance=d->entrance;return true;
+        }
+    }
+    return false;
+}
+static void clear_motion(void) {
+    SstDevControls v=sst_dev_controls();v.noclip=v.moon_jump=false;sst_dev_set_controls(v);was_flying=false;last_flight_ms=0;
+}
+static void finish(bool ok,const char *text) {
+    pending=(SstDevRequest){0};destination_loading=false;sst_teleport_reset(&teleport);
+    if(!ok)sst_dev_native_stats.rejections++;sst_dev_finish(ok,text);
+}
+static void test_input(void) {
+    if(!ENV("LARECOMP_DEBUG_DATA"))return;
+    const char *path=ENV("SST_DEV_REQUEST_FILE");if(!path)return;
+    FILE *f=fopen(path,"r");if(!f)return;
+    char command[32]={0};unsigned number=0;float speed=600;
+    int n=fscanf(f,"%31s %u %f",command,&number,&speed);fclose(f);remove(path);
+    if(n>=2 && !strcmp(command,"warp"))sst_dev_queue_destination(number);
+    else if(n>=2 && !strcmp(command,"peer") && number<=65535)sst_dev_queue_peer((uint16_t)number);
+    else if(n>=2 && (!strcmp(command,"moon")||!strcmp(command,"noclip"))) {
+        SstDevControls v=sst_dev_controls();if(!strcmp(command,"moon"))v.moon_jump=number!=0;else v.noclip=number!=0;sst_dev_set_controls(v);
+    } else if(n>=3 && !strcmp(command,"speed")){SstDevControls v=sst_dev_controls();v.flight_speed=speed;sst_dev_set_controls(v);}
+}
+static void dev_update(Cpu *c) {
+    if(!g_is_skyward || in_dev)return;
+    in_dev=true;test_input();uint64_t now=sst_now_ms();SstLocal local={0};bool ready=bindings && ordinary_game(&local);
+    if(ready && tracked_actor && (local.player_address!=tracked_actor||local.player_instance!=tracked_instance||!same_scene(&local.scene,&tracked_scene)))clear_motion();
+    if(ready){tracked_actor=local.player_address;tracked_instance=local.player_instance;tracked_scene=local.scene;}
+    SstDevRequest request;
+    if(!pending.kind && sst_dev_take_request(&request)) {
+        pending=request;pending_since=request.queued_ms;clear_motion();
+        if(now<pending_since || now-pending_since>SST_TELEPORT_WAIT_TIMEOUT_MS){finish(false,"Teleport request expired");in_dev=false;return;}
+        if(!bindings){finish(false,"Developer tools require the supported SSHD 1.0.0 build");in_dev=false;return;}
+        if(request.kind==SST_DEV_PEER) {
+            SstPlayer peers[SST_MAX_PLAYERS];int n=sst_net_players(peers,SST_MAX_PLAYERS);bool begun=false;
+            if(sst_net_status(NULL,0)==SST_ONLINE && sst_net_generation()==request.connection_generation)
+                for(int i=0;i<n;i++)if(peers[i].id==request.peer && peers[i].presence_generation==request.presence_generation &&
+                    !strcmp(peers[i].scene.stage,request.peer_scene.stage) && peers[i].scene.room==request.peer_scene.room &&
+                    peers[i].scene.layer==request.peer_scene.layer &&
+                    (!request.peer_scene_generation || !peers[i].udp_scene || request.peer_scene_generation==peers[i].udp_scene))
+                    begun=sst_teleport_begin(&teleport,&peers[i],request.connection_generation,now);
+            if(!begun)finish(false,"Player is no longer available");
+        }
+    }
+    bool travel_ready=ready && travel_action(local.pose.action) && !menu_input_captured();
+    if(pending.kind==SST_DEV_DESTINATION) {
+        const SstDestination *d=sst_destination_at(pending.destination);
+        if(!d || (d->flags&SST_DEST_EVENT_OR_TITLE)){finish(false,"This entry is not a playable arrival");}
+        else if(now<pending_since || now-pending_since>45000){finish(false,"Teleport timed out while waiting for gameplay");}
+        else if(destination_loading) {
+            if(travel_ready && local.player_instance!=before_destination_load) {
+                bool match=!strcmp(local.scene.stage,destination_scene.stage)&&local.scene.room==destination_scene.room;
+                char message[192];
+                if(match && (local.scene.layer!=destination_scene.layer || local.scene.entrance!=destination_scene.entrance))
+                    snprintf(message,sizeof message,"Destination loaded; game selected story layer %u, arrival %u",local.scene.layer,local.scene.entrance);
+                else snprintf(message,sizeof message,"%s",match?"Destination loaded":"Game loaded another area; arrival cancelled");
+                finish(match,message);
+            }
+        } else if(travel_ready) {
+            destination_scene=(SstScene){.room=d->room,.layer=d->layer,.entrance=d->entrance};
+            snprintf(destination_scene.stage,sizeof destination_scene.stage,"%s",d->stage);
+            if(load_area(c,&destination_scene)){before_destination_load=local.player_instance;destination_loading=true;}
+        }
+    } else if(pending.kind==SST_DEV_PEER) {
+        SstPlayer peers[SST_MAX_PLAYERS],*peer=NULL;int n=sst_net_players(peers,SST_MAX_PLAYERS);
+        for(int i=0;i<n;i++)if(peers[i].id==pending.peer)peer=&peers[i];
+        uint32_t gen=sst_net_status(NULL,0)==SST_ONLINE?sst_net_generation():UINT32_MAX;
+        SstTeleportDecision d=sst_teleport_step(&teleport,peer,gen,&local.scene,travel_ready,local.player_instance,now);
+        if(d.action==SST_TELEPORT_LOAD_AREA) {
+            SstScene arrival;
+            if(!peer_arrival(&d.scene,&arrival))finish(false,"No verified arrival exists for the player's area");
+            else if(load_area(c,&arrival))sst_teleport_load_accepted(&teleport,d.nonce,local.player_instance);
+        } else if(d.action==SST_TELEPORT_PLACE) {
+            if(place(c,local,d.pose.pos,d.pose.rot)) {sst_teleport_complete(&teleport,d.nonce);finish(true,"Teleported to player; no progress snapshot requested");}
+        } else if(d.action==SST_TELEPORT_CANCEL)finish(false,sst_teleport_reason_text(d.reason));
+        else if(d.action==SST_TELEPORT_WAIT)sst_dev_report(ready,true,sst_teleport_reason_text(d.reason));
+    }
+    sst_dev_report(ready,pending.kind!=SST_DEV_NONE,NULL);in_dev=false;
+}
+
+// SDK input may be polled more than once: it only queues test intent. All guest
+// writes/native calls are performed by the identity-checked player update below.
+void sst_dev_game_tick(Cpu *c) {
+    (void)c;if(!g_is_skyward || in_dev)return;
+    test_input();
+    // Input continues on title/loading screens even when the player update does
+    // not. Invalidate cached readiness there without writing guest memory or
+    // touching the game-thread-only movement anchor.
+    SstLocal local={0};
+    if(!bindings || !ordinary_game(&local)) {
+        atomic_store(&input_allowed,false);atomic_store(&noclip_capable,false);
+        SstDevControls value=sst_dev_controls();value.moon_jump=value.noclip=false;sst_dev_set_controls(value);
+        SstDevStatus status=sst_dev_status();sst_dev_report(false,status.busy,NULL);
+    }
+}
+
+void sst_dev_input(uint64_t raw,uint64_t *buttons,int32_t *lx,int32_t *ly,int32_t *rx,int32_t *ry,bool captured) {
+    DevInput value={.buttons=raw,.x=*lx,.y=*ly,.at=sst_now_ms(),.captured=captured};
+    pthread_mutex_lock(&input_mutex);input=value;pthread_mutex_unlock(&input_mutex);
+    if(captured || !atomic_load(&input_allowed))return;
+    SstDevControls v=sst_dev_controls();
+    if(v.moon_jump && !v.noclip && (raw&BIT(6)) && (raw&BIT(0))) *buttons&=~BIT(0); // hold L+A; do not interact
+    if(v.noclip && atomic_load(&noclip_capable)) {
+        *lx=*ly=0;
+        // Keep right-stick camera look; suppress movement/actions that fight free flight.
+        *buttons=(*buttons&(BIT(10)|BIT(11)|(UINT64_C(0xf)<<20)))|BIT(6);
+    }
+    (void)rx;(void)ry;
+}
+static void player_update(Cpu *c) {
+    if(!original_update)return;
+    if(!g_is_skyward || ENV("SST_NO_PLAYER_READ") || in_update){original_update(c);return;}
+    if(!ptr(c->x[0],0x6b00) || c->x[0]!=read64(PLAYER) || read64(c->x[0])!=PLAYER_VT){original_update(c);return;}
+    in_update=true;sst_dev_native_stats.updates++;
+    if(ptr(c->x[0],0x6b00) && c->x[0]==read64(PLAYER) && read64(c->x[0])==PLAYER_VT)dev_update(c);
+    DevInput held;pthread_mutex_lock(&input_mutex);held=input;pthread_mutex_unlock(&input_mutex);
+    SstLocal before={0};bool ready=ordinary_game(&before) && c->x[0]==before.player_address && foot_action(before.pose.action);
+    atomic_store(&input_allowed,ready);
+    SstDevControls controls=sst_dev_controls();uint64_t player=before.player_address;uint32_t instance=before.player_instance;
+    bool owned=ready && bindings && acch_owned(player);
+    uint64_t flight_now=sst_now_ms();
+    double flight_dt=last_flight_ms && flight_now>=last_flight_ms?(flight_now-last_flight_ms)/1000.0:0;
+    if(flight_dt>.05)flight_dt=.05;
+    bool live_input=!held.captured && flight_now>=held.at && flight_now-held.at<250;
+    SstCamera camera;float view[12],flight_delta[3]={0};
+    bool camera_ok=ready && sst_game_read_camera(&SST_LAYOUT_SSHD_100,16,9,&camera);
+    if(camera_ok){
+        // read_camera stores a scaled view basis; recover the same affine view
+        // used by renderer replay without reading mutable native camera twice.
+        for(unsigned row=0;row<3;row++) {
+            float norm=0;for(unsigned col=0;col<3;col++)norm+=camera.view_proj[row*4+col]*camera.view_proj[row*4+col];
+            float scale=sqrtf(norm)*(row==2?-1:1);
+            if(!isfinite(scale)||fabsf(scale)<.0001f){camera_ok=false;break;}
+            for(unsigned col=0;col<4;col++)view[row*4+col]=camera.view_proj[row*4+col]/scale;
+        }
+        if(camera_ok)camera_ok=sst_dev_flight_delta(view,live_input?held.x:0,live_input?held.y:0,
