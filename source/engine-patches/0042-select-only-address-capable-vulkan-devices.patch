From d3c7771a32887f27db243ab7632110dfda3c3dc4 Mon Sep 17 00:00:00 2001
From: SST continuation <sst-continuation@localhost>
Date: Fri, 13 Nov 2026 14:36:14 -0500
Subject: [PATCH] Select only address-capable Vulkan devices

---
 runtime/nvn/vulkan/device.c        | 56 ++++++++++++++++++++----------
 runtime/nvn/vulkan/device_select.h | 11 ++++++
 tools/test_vk_device_select.c      | 18 ++++++++++
 3 files changed, 67 insertions(+), 18 deletions(-)
 create mode 100644 runtime/nvn/vulkan/device_select.h
 create mode 100644 tools/test_vk_device_select.c

diff --git a/runtime/nvn/vulkan/device.c b/runtime/nvn/vulkan/device.c
index 1df2c25..b4c9bc9 100644
--- a/runtime/nvn/vulkan/device.c
+++ b/runtime/nvn/vulkan/device.c
@@ -15,6 +15,7 @@
 #include "../../paths.h"
 #include "../../settings.h"
 #include "../../ui/menu.h"
+#include "device_select.h"
 #include "vk.h"
 #include "../output_scale.h"
 #include "../renderer.h"
@@ -91,7 +92,9 @@ static bool has_ext(VkExtensionProperties *e, uint32_t n, const char *name) {
     return false;
 }
 
-// Discrete GPU first (LARECOMP_GPU=<index> picks one), needs Vulkan 1.3 and a queue that can present.
+// Discrete GPU first (LARECOMP_GPU=<index> picks one), needs Vulkan 1.3, buffer device addresses and a queue
+// that can run graphics/compute work and present. Check every requirement before scoring so a nominally preferred
+// adapter cannot hide a usable fallback and then fail during device creation.
 static void pick_device(void) {
     uint32_t n = 0;
     vkEnumeratePhysicalDevices(g_vk.inst, &n, NULL);
@@ -99,32 +102,49 @@ static void pick_device(void) {
     VkPhysicalDevice *pd = calloc(n, sizeof *pd);
     vkEnumeratePhysicalDevices(g_vk.inst, &n, pd);
     int want = getenv("LARECOMP_GPU") ? atoi(getenv("LARECOMP_GPU")) : -1, best = -1, best_score = -1;
+    uint32_t best_qfam = UINT32_MAX;
     for (uint32_t i = 0; i < n; i++) {
         VkPhysicalDeviceProperties p;
         vkGetPhysicalDeviceProperties(pd[i], &p);
         LOG("[vk] gpu %u: %s (api %u.%u.%u)\n", i, p.deviceName, VK_API_VERSION_MAJOR(p.apiVersion),
             VK_API_VERSION_MINOR(p.apiVersion), VK_API_VERSION_PATCH(p.apiVersion));
-        if (p.apiVersion < VK_API_VERSION_1_3) continue;
-        int score = p.deviceType == VK_PHYSICAL_DEVICE_TYPE_DISCRETE_GPU ? 3 : p.deviceType == VK_PHYSICAL_DEVICE_TYPE_INTEGRATED_GPU ? 2 : 1;
-        if ((int)i == want) score = 100;
-        if (score > best_score) { best_score = score; best = (int)i; }
+        if (p.apiVersion < VK_API_VERSION_1_3) {
+            LOG("[vk] gpu %u skipped: Vulkan 1.3 unavailable\n", i);
+            continue;
+        }
+        VkPhysicalDeviceVulkan12Features f12 = {.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_2_FEATURES};
+        VkPhysicalDeviceFeatures2 features = {.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2, .pNext = &f12};
+        vkGetPhysicalDeviceFeatures2(pd[i], &features);
+        uint32_t nq = 0, qfam = UINT32_MAX;
+        vkGetPhysicalDeviceQueueFamilyProperties(pd[i], &nq, NULL);
+        VkQueueFamilyProperties *qp = calloc(nq, sizeof *qp);
+        vkGetPhysicalDeviceQueueFamilyProperties(pd[i], &nq, qp);
+        for (uint32_t q = 0; q < nq; q++) {
+            VkBool32 present = VK_FALSE;
+            vkGetPhysicalDeviceSurfaceSupportKHR(pd[i], q, g_vk.surface, &present);
+            if ((qp[q].queueFlags & VK_QUEUE_GRAPHICS_BIT) && (qp[q].queueFlags & VK_QUEUE_COMPUTE_BIT) && present) {
+                qfam = q;
+                break;
+            }
+        }
+        free(qp);
+        int score = vk_device_candidate_score(p.apiVersion >= VK_API_VERSION_1_3,
+                                              p.deviceType == VK_PHYSICAL_DEVICE_TYPE_DISCRETE_GPU,
+                                              p.deviceType == VK_PHYSICAL_DEVICE_TYPE_INTEGRATED_GPU, f12.bufferDeviceAddress,
+                                              qfam != UINT32_MAX, (int)i, want);
+        if (score < 0) {
+            LOG("[vk] gpu %u skipped: %s%s\n", i,
+                !f12.bufferDeviceAddress ? "buffer device addresses unavailable; " : "",
+                qfam == UINT32_MAX ? "no graphics+compute+present queue" : "");
+            continue;
+        }
+        if (score > best_score) { best_score = score; best = (int)i; best_qfam = qfam; }
     }
-    if (best < 0) FATAL("no Vulkan 1.3 device\n");
+    if (best < 0) FATAL("no Vulkan 1.3 device with buffer device addresses and a graphics+compute+present queue\n");
     g_vk.phys = pd[best];
+    g_vk.qfam = best_qfam;
     free(pd);
     vkGetPhysicalDeviceProperties(g_vk.phys, &g_vk.props);
-    uint32_t nq = 0;
-    vkGetPhysicalDeviceQueueFamilyProperties(g_vk.phys, &nq, NULL);
-    VkQueueFamilyProperties *qp = calloc(nq, sizeof *qp);
-    vkGetPhysicalDeviceQueueFamilyProperties(g_vk.phys, &nq, qp);
-    g_vk.qfam = UINT32_MAX;
-    for (uint32_t i = 0; i < nq; i++) {
-        VkBool32 present = VK_FALSE;
-        vkGetPhysicalDeviceSurfaceSupportKHR(g_vk.phys, i, g_vk.surface, &present);
-        if ((qp[i].queueFlags & VK_QUEUE_GRAPHICS_BIT) && (qp[i].queueFlags & VK_QUEUE_COMPUTE_BIT) && present) { g_vk.qfam = i; break; }
-    }
-    free(qp);
-    if (g_vk.qfam == UINT32_MAX) FATAL("no graphics+present queue\n");
     LOG("[vk] using %s\n", g_vk.props.deviceName);
 }
 
diff --git a/runtime/nvn/vulkan/device_select.h b/runtime/nvn/vulkan/device_select.h
new file mode 100644
index 0000000..d614fd4
--- /dev/null
+++ b/runtime/nvn/vulkan/device_select.h
@@ -0,0 +1,11 @@
+// Pure candidate scoring shared by the Vulkan device picker and its asset-free test.
+#pragma once
+#include <stdbool.h>
+
+static inline int vk_device_candidate_score(bool vulkan_1_3, bool discrete, bool integrated,
+                                            bool buffer_device_address, bool graphics_compute_present,
+                                            int index, int requested_index) {
+    if (!vulkan_1_3 || !buffer_device_address || !graphics_compute_present) return -1;
+    if (index == requested_index) return 100;
+    return discrete ? 3 : integrated ? 2 : 1;
+}
diff --git a/tools/test_vk_device_select.c b/tools/test_vk_device_select.c
new file mode 100644
index 0000000..d85effe
--- /dev/null
+++ b/tools/test_vk_device_select.c
@@ -0,0 +1,18 @@
+// Asset-free tests for Vulkan adapter gating. No instance, device, window or game is created.
+#include <assert.h>
+#include <stdio.h>
+
+#include "../runtime/nvn/vulkan/device_select.h"
+
+int main(void) {
+    assert(vk_device_candidate_score(true, true, false, true, true, 0, -1) == 3);
+    assert(vk_device_candidate_score(true, false, true, true, true, 1, -1) == 2);
+    assert(vk_device_candidate_score(true, false, false, true, true, 2, -1) == 1);
+    assert(vk_device_candidate_score(true, false, true, true, true, 1, 1) == 100);
+    assert(vk_device_candidate_score(false, true, false, true, true, 0, -1) == -1);
+    assert(vk_device_candidate_score(true, true, false, false, true, 0, -1) == -1);
+    assert(vk_device_candidate_score(true, true, false, true, false, 0, -1) == -1);
+    assert(vk_device_candidate_score(true, true, false, false, true, 0, 0) == -1);
+    puts("Vulkan device selection PASS");
+    return 0;
+}
