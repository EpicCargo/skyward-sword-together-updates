 static void source79_bind_pre(Source79Receipt *r,unsigned kind) {
     // Receipt was already reserved at callback entry, before known mutation and
     // original heap reset. No old model/object/resource field is read here.
-    bool inspect=kind==0 && (getenv("SST_TEST_MODEL_BIRTH_LOG") || sst_origin_recovery_enabled()) && getenv("LARECOMP_DEBUG_DATA");
+    bool inspect=kind==0 && (getenv("SST_TEST_MODEL_BIRTH_LOG") || sst_origin_recovery_enabled()) && (sst_origin_feature_enabled() || getenv("LARECOMP_DEBUG_DATA"));
     if(inspect && sst_origin_observation_enter()) {
         Birth79Header h=birth79_header(r->actor);r->pre_valid=!h.reason;r->instance=h.instance;
         if(r->pre_valid && sst_origin_recovery_enabled() && !sst_origin_model_bind(&r->model,h.instance))r->pre_valid=false;
@@ -142,7 +142,7 @@ bool sst_source_lifecycle_activate(uint64_t actor,uint32_t instance,const SstSce
 }
 static void birth78_observe(uint64_t actor,uint64_t result,const Source79Receipt *receipt) {
     const char *path=getenv("SST_TEST_MODEL_BIRTH_LOG");
-    if((!path && !sst_origin_recovery_enabled()) || !getenv("LARECOMP_DEBUG_DATA"))return;
+    if((!path && !sst_origin_recovery_enabled()) || (!sst_origin_feature_enabled() && !getenv("LARECOMP_DEBUG_DATA")))return;
     pthread_mutex_lock(&birth78_mu);sst_source78_birth_stats.returns++;
     if(!(result&1)){sst_source78_birth_stats.false_returns++;pthread_mutex_unlock(&birth78_mu);return;}
     if(!sst_origin_observation_enter()){sst_source78_birth_stats.busy++;pthread_mutex_unlock(&birth78_mu);return;}
@@ -218,7 +218,7 @@ static void source76_dtor(Cpu *c){source76_lifecycle(c,1);}
 static void source76_heap_dtor(Cpu *c){source76_lifecycle(c,2);}
