+static void prop_small_execute(Cpu *c) { prop_execute(c, prop_original[0]); }
+static void prop_big_execute(Cpu *c) { prop_execute(c, prop_original[1]); }
+static void prop_barrel_execute(Cpu *c) { prop_execute(c, prop_original[2]); }
 void sst_prop_dispatch_init(void) {
-    // The registry survives in-place reboot. Refresh the original game-library
-    // function each boot, but register exactly once before first guest dispatch.
-    static bool registered;
-    prop_original = dispatch_lookup(SST_PROP_TUBO_EXECUTE);
-    if (!registered && prop_original) {
-        hle_override(SST_PROP_TUBO_EXECUTE, prop_execute, "SST ordinary vase execute"); registered = true;
+    static bool registered[SST_PROP_NATIVE_ADAPTERS];
+    HostFn callbacks[SST_PROP_NATIVE_ADAPTERS] = {prop_small_execute, prop_big_execute, prop_barrel_execute};
+    for (unsigned i = 0; i < SST_PROP_NATIVE_ADAPTERS; i++) {
