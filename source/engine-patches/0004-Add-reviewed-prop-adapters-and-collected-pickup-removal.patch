+static inline const SstPropNativeDescriptor *sst_prop_native_descriptor(uint16_t profile) {
+    for (unsigned i = 0; i < SST_PROP_NATIVE_ADAPTERS; i++)
+        if (sst_prop_native_descriptors[i].profile == profile) return &sst_prop_native_descriptors[i];
+    return NULL;
+}
+
 typedef struct {
     float pos[3];
     int16_t rot[3];
     float matrix[12];
 } SstPropNativePose;
 
-// Profile/vtable and allocation size are pinned to the native Tubo constructor.
+// Profiles/vtables and allocation sizes are pinned to their native constructors.
 // The caller also proves unique membership in the current bounded actor tree.
-// Params are identity data; they do not determine eligibility here.
+// Native barrel heap0x71789C..8B8 maps low nibbleF to Normal0, stored at+1367.
+// Exclude all nonnormal and NPC quest modes through both params and actual type.
+static inline const SstPropNativeDescriptor *sst_prop_native_actor_descriptor(uint64_t a) {
+    if (!ptr(a, 0x180)) return NULL;
+    const SstPropNativeDescriptor *d = sst_prop_native_descriptor(r16(a + 0x10));
+    if (!d || !ptr(a, d->allocation) || r64(a) != d->vtable || r8(a + 0x12) != 1 ||
