diff --git a/runtime/hle/sst_pickup_bridge.h b/runtime/hle/sst_pickup_bridge.h
new file mode 100644
index 0000000..ff334cd
--- /dev/null
+++ b/runtime/hle/sst_pickup_bridge.h
@@ -0,0 +1,215 @@
+// Include after native inventory/recovery helpers. Session-only pickup sharing.
+#include "../sst/sst_pickup.h"
+#include "../sst/sst_socket.h"
+#define PICKUP_ITEM_VTABLE UINT64_C(0x700158c160)
+#define PICKUP_ITEM_EXECUTE UINT64_C(0x70004e477c)
+#define PICKUP_ITEM_GETTER UINT64_C(0x70004e57ac)
+#define PICKUP_NATIVE_QUEUE 256
+typedef struct {
+    SstPickup request;
+    uint64_t actor;
+    uint64_t sent_ms;
+    uint32_t instance, generation;
+    bool queued;
+} PickupObservation;
+static struct {
+    pthread_mutex_t mu;
+    SstPickupState state;
+    PickupObservation observed[PICKUP_NATIVE_QUEUE];
+    uint32_t generation, sequence;
+    uint64_t nonce;
+    uint64_t safe_since;
+    bool conflict;
+} pickup_bridge = {.mu=PTHREAD_MUTEX_INITIALIZER};
+static GuestFn pickup_original_getter, pickup_original_execute;
+static _Thread_local bool pickup_remote_grant;
+
+static bool pickup_actor(uint64_t a) {
+    return ptr(a,0x1288) && r64(a)==PICKUP_ITEM_VTABLE && r16(a+0x10)==0x281 &&
+        r8(a+0x12)==1 && !r8(a+0x13) && !r8(a+0x14);
+}
+// Fresh bounded membership, never a packet address or a stale actor binding.
+static bool pickup_in_tree(uint64_t a,uint64_t player) {
+    uint64_t node=player+0x18;
+    for(unsigned i=0;;i++) {
+        if(i==64 || !ptr(node,0x28))return false;
+        uint64_t parent=r64(node);if(!parent)break;node=parent;
+    }
+    uint64_t stack[4096],seen[4096];unsigned n=1,count=0;stack[0]=node;
+    while(n) {
+        node=stack[--n];if(!ptr(node,0x28) || count==4096)return false;
+        for(unsigned i=0;i<count;i++)if(seen[i]==node)return false;
+        seen[count++]=node;uint64_t owner=r64(node+0x20);
+        if(!ptr(owner,0x18) || owner+0x18!=node)return false;
+        if(owner==a)return true;
+        uint64_t child=r64(node+8),next=r64(node+0x18);
+        if(child){if(n==4096)return false;stack[n++]=child;}
+        if(next){if(n==4096)return false;stack[n++]=next;}
+    }
+    return false;
+}
+static void pickup_generation(void) {
+    uint32_t generation=sst_net_generation();
+    if(pickup_bridge.generation==generation)return;
+    sst_pickup_reset(&pickup_bridge.state);
+    memset(pickup_bridge.observed,0,sizeof pickup_bridge.observed);
+    pickup_bridge.generation=generation;pickup_bridge.conflict=false;
+}
+static void pickup_capture(uint64_t actor,uint64_t caller,uint16_t item) {
+    if(pickup_remote_grant || !g_sst.sync_pickups ||
+        caller!=UINT64_C(0x70004de570) ||
+        !sst_pickup_item(item,NULL,NULL) || !pickup_actor(actor) ||
+        sst_net_status(NULL,0)!=SST_ONLINE || sst_world_in_boss())return;
+    uint32_t params=r32(actor+0xc);
+    SstLocal local=sst_game_read_local(&SST_LAYOUT_SSHD_100,sst_game_pose_tick());
+    if(!local.valid || !local.pose.health || sst_world_boss_stage(local.scene.stage) ||
+        sst_world_trial_stage(local.scene.stage) || !pickup_in_tree(actor,local.player_address))return;
+    uint64_t fm=r64(FILE_MGR);
+    if(!ptr(fm,0xcd08) || !normal_inventory(fm) ||
+        (r64(SST_LAYOUT_SSHD_100.minigame_ptr) && r32(SST_LAYOUT_SSHD_100.minigame_mode)==3))return;
+    SstPickup candidate={.scene=local.scene,.placed_id=r16(actor+0x136),.params=params,.item=item,.sequence=1,
+        .token=r16(actor+0x136)==0xffff?1:0};
+    if(!sst_pickup_valid(&candidate))return;
+    pthread_mutex_lock(&pickup_bridge.mu);pickup_generation();
+    if(pickup_bridge.conflict)goto done;
+    uint32_t instance=r32(actor+8);PickupObservation *slot=NULL;
+    for(unsigned i=0;i<PICKUP_NATIVE_QUEUE;i++) {
+        PickupObservation *p=&pickup_bridge.observed[i];
+        if(p->actor==actor && p->instance==instance)goto done;
+        if((!p->actor || (!p->queued && (!pickup_actor(p->actor) || r32(p->actor+8)!=p->instance))) && !slot)slot=p;
+    }
+    if(!slot)goto done;
+    if(!pickup_bridge.nonce && !sst_socket_random((uint8_t*)&pickup_bridge.nonce,sizeof pickup_bridge.nonce))goto done;
+    SstPickup request={.scene=local.scene,.placed_id=r16(actor+0x136),.params=params,.item=item,
+        .sequence=++pickup_bridge.sequence};
+    if(!request.sequence)request.sequence=++pickup_bridge.sequence;
+    if(request.placed_id==0xffff) { request.token=++pickup_bridge.nonce;if(!request.token)request.token=++pickup_bridge.nonce; }
+    uint32_t epoch=sst_world_same_area(&pickup_bridge.state.scene,&local.scene)?pickup_bridge.state.epoch:0;
+    sst_pickup_begin(&pickup_bridge.state,&local.scene,epoch);
+    if(!sst_pickup_local(&pickup_bridge.state,sst_net_my_id(),&request,sst_now_ms()))goto done;
+    *slot=(PickupObservation){.request=request,.actor=actor,.instance=instance,.generation=pickup_bridge.generation,.queued=true};
+    if(ENV("SST_TRACE"))LOG("[sst-pickup] native collection item=%u placed=%u sequence=%u\n",item,request.placed_id,request.sequence);
+done:
+    pthread_mutex_unlock(&pickup_bridge.mu);
+}
+static void pickup_getter(Cpu *c) {
+    uint64_t actor=c->x[0],caller=c->x[30];
+    if(pickup_original_getter)pickup_original_getter(c);
+    if(c->x[0]<=UINT16_MAX)pickup_capture(actor,caller,(uint16_t)c->x[0]);
+}
+
+static void pickup_incoming(const SstPickupCommit *commit,void *unused) {
+    (void)unused;
+    pthread_mutex_lock(&pickup_bridge.mu);pickup_generation();
+    if(sst_world_same_area(&pickup_bridge.state.scene,&commit->pickup.scene))
+        sst_pickup_begin(&pickup_bridge.state,&commit->pickup.scene,commit->epoch);
+    SstPickupDecision decision=sst_pickup_accept(&pickup_bridge.state,commit,sst_now_ms());
+    // Collector-only policy: receipt processing never grants currency, healing,
+    // ammo, stamina or materials to another player. It authorizes removal only.
+    if(decision==SST_PICKUP_NEW)sst_pickup_applied(&pickup_bridge.state,commit);
+    if(decision!=SST_PICKUP_INVALID && decision!=SST_PICKUP_FULL)
+        for(unsigned i=0;i<PICKUP_NATIVE_QUEUE;i++) {
+            PickupObservation *p=&pickup_bridge.observed[i];
+            if(p->queued && sst_pickup_key_equal(&p->request,sst_net_my_id(),&commit->pickup,commit->from))p->queued=false;
+        }
+    if(ENV("SST_TRACE"))LOG("[sst-pickup] receipt epoch=%u item=%u from=%u snapshot=%u decision=%u\n",
+        commit->epoch,commit->pickup.item,commit->from,commit->snapshot,decision);
+    pthread_mutex_unlock(&pickup_bridge.mu);
+}
+
+static void pickup_tick(Cpu *c,SstLocal local,uint64_t fm,bool allowed) {
+    (void)c;(void)fm;
+    pthread_mutex_lock(&pickup_bridge.mu);pickup_generation();
+    if(sst_net_status(NULL,0)!=SST_ONLINE) {
+        sst_pickup_reset(&pickup_bridge.state);memset(pickup_bridge.observed,0,sizeof pickup_bridge.observed);
+        pickup_bridge.safe_since=0;
+    }
+    if(local.valid) {
+        uint32_t epoch=sst_world_same_area(&pickup_bridge.state.scene,&local.scene)?pickup_bridge.state.epoch:0;
+        sst_pickup_begin(&pickup_bridge.state,&local.scene,epoch);
+    }
+    bool enabled=g_sst.sync_pickups && !pickup_bridge.conflict && sst_net_status(NULL,0)==SST_ONLINE;
+    pthread_mutex_unlock(&pickup_bridge.mu);
+    sst_net_poll_pickups(enabled?pickup_incoming:NULL,NULL);
+    if(!enabled || !allowed) {pickup_bridge.safe_since=0;return;}
+    uint64_t now=sst_now_ms();if(!pickup_bridge.safe_since)pickup_bridge.safe_since=now;
+    // No mutex across guest calls: model/inventory calls can enter reboot safe points.
+    pthread_mutex_lock(&pickup_bridge.mu);
+    // One ordered claim in flight. Retry until its host receipt arrives, allowing
+    // normal-pose publication to catch up after a native item-get event.
+    PickupObservation *first=NULL;
+    for(unsigned i=0;i<PICKUP_NATIVE_QUEUE;i++) {
+        PickupObservation *p=&pickup_bridge.observed[i];
+        if(p->queued && p->generation==pickup_bridge.generation && sst_world_same_area(&p->request.scene,&local.scene) &&
+            (!first || (int32_t)(p->request.sequence-first->request.sequence)<0))first=p;
+    }
+    if(first && now-pickup_bridge.safe_since>=150 && now-first->sent_ms>=250 &&
+        sst_net_send_pickup(&first->request))first->sent_ms=now;
+    pthread_mutex_unlock(&pickup_bridge.mu);
+
+}
+static bool pickup_consumed(uint64_t actor) {
+    if(!g_sst.sync_pickups || sst_net_status(NULL,0)!=SST_ONLINE ||
+        !pickup_actor(actor) || r16(actor+0x136)==0xffff)return false;
+    SstLocal local=sst_game_read_local(&SST_LAYOUT_SSHD_100,0);if(!local.valid || sst_world_in_boss())return false;
+    bool found=false;pthread_mutex_lock(&pickup_bridge.mu);
+    if(!pickup_bridge.conflict && pickup_bridge.generation==sst_net_generation() &&
+        sst_world_same_area(&local.scene,&pickup_bridge.state.scene) && pickup_bridge.state.epoch)
+        for(unsigned i=0;i<SST_PICKUP_RECORDS;i++) {
+            const SstPickupClientRecord *p=&pickup_bridge.state.records[i];
+            if(p->used && p->has_commit && p->applied && p->commit.epoch==pickup_bridge.state.epoch &&
+                p->commit.pickup.placed_id==r16(actor+0x136) && p->commit.pickup.params==r32(actor+0xc) &&
+                sst_world_same_area(&p->commit.pickup.scene,&local.scene)) {found=true;break;}
+        }
+    pthread_mutex_unlock(&pickup_bridge.mu);return found;
+}
+static void pickup_execute(Cpu *c) {
+    uint64_t actor=c->x[0];
+    if(pickup_consumed(actor)) {
+        // This callback itself proves the actor is currently executing. Native
+        // deletion unregisters its interaction instead of hiding a rendered mesh.
+        unsigned flag=(r32(actor+0xc)>>10)&255;
+        if(flag<128) {
+            uint64_t fm=r64(FILE_MGR),sm=r64(SCENE_MGR);ChestReceipt receipt;
+            if(!ptr(fm,0xcd08) || !normal_inventory(fm) || !ptr(sm,0x50) || r16(sm+0x4a)>=26 ||
+                !chest_receipt(fm,sst_chest_index(true,r16(sm+0x4a),flag),&receipt) || !backup(fm) ||
+                !prepare_receipt(c,&receipt)) {if(pickup_original_execute)pickup_original_execute(c);return;}
+            mark_receipt(&receipt);
+        }
+        call(c,DELETE_REQUEST,actor,0,0);c->x[0]=1;return;
+    }
+    if(pickup_original_execute)pickup_original_execute(c);
+}
+void sst_pickup_dispatch_init(void) {
+    static bool registered;
+    pickup_original_getter=dispatch_lookup(PICKUP_ITEM_GETTER);
+    pickup_original_execute=dispatch_lookup(PICKUP_ITEM_EXECUTE);
+    if(!registered && pickup_original_getter && pickup_original_execute) {
+        hle_override(PICKUP_ITEM_GETTER,pickup_getter,"SST native pickup collection getter");
+        hle_override(PICKUP_ITEM_EXECUTE,pickup_execute,"SST consumed placed pickup execute");registered=true;
+    }
+}
+// Isolated verification uses the real native Item factory and normal pickup
+// behavior. No host pointers or arbitrary function arguments enter the guest.
+static uint64_t pickup_debug_scratch;
+static void pickup_debug_test_input(Cpu *c) {
+    const char *path=ENV("SST_PICKUP_TEST_FILE");
+    if(!path || !ENV("LARECOMP_DEBUG_DATA"))return;
+    FILE *file=fopen(path,"r");if(!file)return;unsigned item=0;float distance=0;int n=fscanf(file,"%u %f",&item,&distance);fclose(file);remove(path);
+    if(n<1 || !isfinite(distance) || fabsf(distance)>500 || item>UINT16_MAX || !sst_pickup_item((uint16_t)item,NULL,NULL))return;
+    SstLocal l=sst_game_read_local(&SST_LAYOUT_SSHD_100,0);
+    if(!l.valid || l.scene.room>62 || !safe_action(l.pose.action) || event_active() || native_paused() ||
+        r64(PICKUP_ITEM_VTABLE+0xf8)!=PICKUP_ITEM_GETTER)return;
+    if(!pickup_debug_scratch)pickup_debug_scratch=(uint64_t)(uintptr_t)hle_alloc(32);
+    float position[3]={l.pose.pos[0],l.pose.pos[1]+35,l.pose.pos[2]+distance};
+    memcpy((void*)(uintptr_t)pickup_debug_scratch,position,sizeof position);
+    memset((void*)(uintptr_t)(pickup_debug_scratch+16),0,8);
+    Cpu saved=*c;c->x[0]=l.scene.room;c->x[1]=(255u<<10)|0x200u|item;
+    c->x[2]=pickup_debug_scratch;c->x[3]=pickup_debug_scratch+16;c->x[4]=UINT32_MAX;c->x[5]=0;
+    guest_call(c,UINT64_C(0x70004e7a70));uint64_t actor=c->x[0];*c=saved;
+    LOG("[sst-pickup] isolated native spawn item=%u actor=%llx\n",item,(unsigned long long)actor);
+}
+RT_ON_RESET(sst_pickup_bridge_reset) {
+    sst_pickup_reset(&pickup_bridge.state);memset(pickup_bridge.observed,0,sizeof pickup_bridge.observed);
+    pickup_bridge.generation=0;pickup_bridge.conflict=false;pickup_remote_grant=false;pickup_debug_scratch=0;
+}
