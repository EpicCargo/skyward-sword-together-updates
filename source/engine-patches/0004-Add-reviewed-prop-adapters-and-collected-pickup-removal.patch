-// SSHD 1.0.0 ordinary-vase bridge. Include after sst_world.c's memory helpers.
+// SSHD 1.0.0 reviewed vase/normal-barrel adapters. Include after world memory helpers.
 // Call only on the native guest thread, after exact live-tree/key/instance binding.
 // This header owns no network authority and never changes native carry references.
 #ifndef SST_PROP_NATIVE_H
 #define SST_PROP_NATIVE_H
 
 #include <math.h>
+#include "../sst/sst_props.h"
 
 #define SST_PROP_TUBO_PROFILE 0x1f0u
 #define SST_PROP_TUBO_VTABLE UINT64_C(0x700162f008)
 #define SST_PROP_TUBO_EXECUTE UINT64_C(0x70009b7988)
+#define SST_PROP_BIG_VTABLE UINT64_C(0x700162f3b0)
+#define SST_PROP_BIG_EXECUTE UINT64_C(0x70009bb8c0)
+#define SST_PROP_BARREL_VTABLE UINT64_C(0x70015f6290)
+#define SST_PROP_BARREL_EXECUTE UINT64_C(0x700071858c)
 #define SST_PROP_MODEL_VTABLE UINT64_C(0x7001698d50)
 #define SST_PROP_MODEL_PROCESS UINT64_C(0x7000fe8b6c)
 #define SST_PROP_MODEL_OPTIONS UINT64_C(0x7000fea658)
 #define SST_PROP_CARRIED_GETTER UINT64_C(0x7000adc6d4)
 
+enum { SST_PROP_NATIVE_CALC_TASKS = 1, SST_PROP_NATIVE_COPY_SCALE = 2 };
