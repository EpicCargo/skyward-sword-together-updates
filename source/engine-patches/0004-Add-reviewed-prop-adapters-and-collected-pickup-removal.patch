+} SstPropNativeDescriptor;
+#define SST_PROP_NATIVE_ADAPTERS 3
+// Exact1.0.0 constructor/vtable/execute-tail facts, not layout guesses. Keep every
+// model under the same pinned inner-model/task targets below; a different model
+// class fails closed until separately reviewed. Scale is native, never packet data.
+static const SstPropNativeDescriptor sst_prop_native_descriptors[SST_PROP_NATIVE_ADAPTERS] = {
+    {.profile=SST_PROP_PROFILE, .vtable=SST_PROP_TUBO_VTABLE, .execute=SST_PROP_TUBO_EXECUTE,
+     .allocation=0xd38, .model_offset=0x438, .fall_offset=0xd10, .tail_clear_offset=0xd1f,
+     .center_height={28,76}, .tail_flags=SST_PROP_NATIVE_CALC_TASKS},
