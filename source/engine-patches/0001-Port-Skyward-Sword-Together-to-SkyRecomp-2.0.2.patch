+static bool backup(uint64_t fm) {
+    if (backed_up) return true;
+    extern const char *g_save_dir;
+    char source[1024], dest[1024], why[200];
+    snprintf(source, sizeof source, "%s/save_0", g_save_dir);
+    if (!sst_backup_saves(source, "sst-backups/save_0", 20, dest, sizeof dest, why, sizeof why)) {
+        char msg[240]; snprintf(msg, sizeof msg, "Sync waiting: save backup failed: %.170s", why);
+        notify(msg, false); return false;
+    }
+    char path[1200]; snprintf(path, sizeof path, "%s/unsaved-world.bin", dest);
+    FILE *f = fopen(path, "wb");
+    bool ok = f && fwrite((void *)(uintptr_t)(fm + 16), 1, 2 * 21440, f) == 2 * 21440;
+    if (f && fclose(f)) ok = false;
+    if (!ok) { notify("Sync waiting: could not back up unsaved world state", false); return false; }
+    backed_up = true; LOG("[sst-world] pre-sync save backup: %s\n", dest); return true;
+}
+typedef struct { uint64_t mgr, raw, defs; unsigned count, words; } Flags;
+static Flags flags(uint64_t global, unsigned count, unsigned words) {
+    Flags f = {0}; uint64_t m = r64(global);
+    if (!ptr(m, 0x40)) return f;
+    uint64_t sp = r64(m + 0x10), ix = r64(m + 0x18);
+    if (!ptr(sp, 0x18) || !ptr(ix, 16) || r16(sp + 0x10) != words || r16(ix) != count) return f;
+    uint64_t raw = r64(sp + 8), defs = r64(ix + 8);
+    if (!ptr(raw, words * 2) || !ptr(defs, count * 2)) return f;
+    return (Flags){m, raw, defs, count, words};
+}
+static bool location(const Flags *f, unsigned id, uint64_t *address, uint16_t *mask) {
+    unsigned w = r8(f->defs + id * 2), sw = r8(f->defs + id * 2 + 1);
+    if (!sst_world_boolean_definition(w, sw, f->words)) return false;
+    *address = f->raw + w * 2; *mask = 1u << (sw >> 4); return true;
+}
+static bool key_pieces_complete(void) {
+    Flags f = flags(ITEM_MGR, 510, 64);
+    return f.mgr && r8(f.defs + 505 * 2) == 60 && r8(f.defs + 505 * 2 + 1) == 3 &&
+        (r16(f.raw + 120) & 15) == 5;
+}
