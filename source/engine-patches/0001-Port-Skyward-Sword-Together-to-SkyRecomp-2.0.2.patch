+// Report-generation regression test: no SDL, ImGui implementation, network, game or assets required.
+// From engine/ on Linux (compile/run only when the parent has stopped native games):
+// clang++ -std=c++17 -O1 -ffunction-sections -fdata-sections -Ithird_party/imgui \
+//   tools/test_sst_diagnostics.cpp -Wl,--gc-sections -o build/test_sst_diagnostics
+// The included UI translation unit exposes its private report helpers here. Section GC drops
+// tab_developer/capture and their unneeded UI/network dependencies; production code is unchanged.
+#include <float.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "../runtime/ui/developer_tab.mm"
+
+// Deliberately populated with private sentinels below, so future accidental global-setting
+// accesses in build_report cannot silently introduce endpoint, session or file-path disclosure.
+extern "C" {
+SstSettings g_sst = {};
+Settings g_settings = {};
+}
+
+namespace {
+unsigned checks;
+void require(bool condition, const char *expression, int line) {
+    ++checks;
+    if (!condition) {
+        fprintf(stderr, "diagnostics check failed at line %d: %s\n", line, expression);
+        abort();
+    }
+}
+#define CHECK(condition) require((condition), #condition, __LINE__)
+
+Report report_for(const Diagnostics &d) {
+    Report r;
+    build_report(d, r);
+    CHECK(r.complete);
+    CHECK(r.used < sizeof r.text);
+    CHECK(strlen(r.text) == r.used);
+    return r;
+}
+
+bool contains(const Report &r, const char *text) { return strstr(r.text, text) != NULL; }
+
+void offline_and_roles(void) {
+    Diagnostics d = {};
+    d.status = SST_OFFLINE;
+    d.frame_rate = 60;
+    // A stale gameplay structure must not leak into an unavailable local sample.
+    snprintf(d.scene.stage, sizeof d.scene.stage, "STALE_LOCAL_SCENE_SENTINEL");
+    d.pose.action = 1234;
+    d.pose.anim_id = 4321;
+    Report r = report_for(d);
+    CHECK(contains(r, "Status: Offline\nSession role: Disconnected\n"));
+    CHECK(contains(r, "Movement transport: Offline\n"));
+    CHECK(contains(r, "Host/relay RTT: unavailable\n"));
+    CHECK(contains(r, "Local gameplay sample: unavailable\n"));
+    CHECK(!contains(r, "STALE_LOCAL_SCENE_SENTINEL"));
+    CHECK(!contains(r, "Local action/clip/frame:"));
+    CHECK(!contains(r, "Last packet age:"));
+
+    d.status = SST_CONNECTING;
+    r = report_for(d);
+    CHECK(contains(r, "Session role: Joining another host\n"));
+    d.host_port = 7623;
+    r = report_for(d);
+    CHECK(contains(r, "Session role: Hosting\nListener port: 7623\n"));
+    d.status = SST_ONLINE;
+    d.connection.online = true;
+    d.connection.has_rtt = true;
+    d.connection.rtt_ms = 152;
+    d.connection.last_packet_age_ms = 27;
+    r = report_for(d);
+    CHECK(contains(r, "Status: Online\nSession role: Hosting\n"));
+    CHECK(contains(r, "Host/relay RTT: 152 ms\nLast packet age: 27 ms\n"));
+    CHECK(contains(r, "Movement transport: TCP movement / TCP progress\n"));
+    d.host_port = 0;
+    d.connection.udp_active = true;
+    r = report_for(d);
+    CHECK(contains(r, "Session role: Joined another host\nListener port: 0\n"));
+    CHECK(contains(r, "Movement transport: UDP movement / TCP progress\n"));
+    d.status = SST_FAILED;
+    r = report_for(d);
+    CHECK(contains(r, "Status: Failed\nSession role: Disconnected\n"));
+}
