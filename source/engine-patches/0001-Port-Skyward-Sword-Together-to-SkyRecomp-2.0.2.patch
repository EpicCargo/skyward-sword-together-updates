+static void call(Cpu *c, uint64_t fn, uint64_t a, uint64_t b, uint64_t d) {
+    Cpu saved = *c;
+    c->x[0] = a; c->x[1] = b; c->x[2] = d;
+    guest_call(c, fn); *c = saved;
