+    uint64_t player = r64(PLAYER);
+    return ptr(player, 0x470) && player == r64(0x7001826ad0ull) &&
+        health > 0 && health <= 80 && capacity >= 24 && capacity <= 80 && !(capacity % 4) &&
+        r32(HEART_CAPACITY) == 0xb000f0e8u && r32(PLAYER_HEAL) == 0xd102c3ffu;
+}
+typedef struct { uint64_t mgr, raw, defs; } LoadedDungeon;
+static bool loaded_dungeon(const ChestReceipt *receipt, LoadedDungeon *out) {
+    uint64_t dm = r64(DUNGEON_MGR), tm = r64(TBOX_MGR);
+    if (!receipt->loaded || !ptr(dm, 0x28) || !ptr(tm, 0x30) ||
+        r16(dm + 2) != receipt->table || r16(tm + 0x28) != receipt->table ||
+        r16(dm + 0x20) != 8) return false;
+    uint64_t ix = r64(dm + 8), raw = r64(dm + 0x18), vt = r64(dm + 0x10);
+    if (!ptr(ix, 16) || r16(ix) != 17 || !ptr(raw, 16) || !ptr(vt, 8) || !code(r64(vt))) return false;
+    uint64_t defs = r64(ix + 8); if (!ptr(defs, 34)) return false;
+    *out = (LoadedDungeon){dm, raw, defs}; return true;
