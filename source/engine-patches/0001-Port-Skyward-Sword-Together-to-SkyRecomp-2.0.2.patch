+// Skyward Sword Together diagnostics. Render-thread snapshots only: no guest writes or network actions.
+#include <stdarg.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "imgui.h"
+#include "../sst/sst_animation.h"
+#include "../sst/sst_avatar.h"
+#include "../sst/sst_game.h"
+#include "../sst/sst_host.h"
+extern "C" {
+#include "../settings.h"
+}
+
+// menu.mm marshals this bounded text to SDL on the main thread.
+extern bool menu_copy_diagnostics(const char *text);
+extern int menu_diagnostics_copy_status(void);
+
+namespace {
+struct Diagnostics {
+    uint64_t captured_ms;
+    SstStatus status;
+    SstConnectionStats connection;
+    uint16_t host_port, player_id;
+    uint32_t generation;
+    bool local_valid, avatars;
+    int frame_rate;
+    SstScene scene;
+    SstPose pose;
+    float animation_length;
+    SstPlayer peers[SST_MAX_PLAYERS];
+    int peer_count;
+    SstAnimationStats animation;
+    SstAnimationReplayStats replay;
+    uint16_t left_wrist_mesh, right_wrist_mesh;
+    SstAnimationPartStats left_wrist, right_wrist;
+};
+
+const char *status_text(SstStatus status) {
+    switch (status) {
+    case SST_OFFLINE: return "Offline";
+    case SST_CONNECTING: return "Connecting";
+    case SST_ONLINE: return "Online";
+    case SST_FAILED: return "Failed";
+    }
+    return "Unknown";
+}
+
+const char *role_text(const Diagnostics &d) {
+    if (d.host_port) return "Hosting";
+    if (d.status == SST_ONLINE) return "Joined another host";
+    if (d.status == SST_CONNECTING) return "Joining another host";
+    return "Disconnected";
+}
+
+const char *transport_text(const Diagnostics &d) {
+    if (!d.connection.online) return "Offline";
+    if (d.connection.udp_active) return "UDP movement / TCP progress";
+    return "TCP movement / TCP progress";
+}
+
+bool same_scene(const Diagnostics &d, const SstPlayer &p) {
+    return d.local_valid && !strcmp(d.scene.stage, p.scene.stage) &&
+        d.scene.room == p.scene.room && d.scene.layer == p.scene.layer;
+}
+
+bool pose_age(const Diagnostics &d, const SstPlayer &p, uint64_t *age) {
+    if (!p.has_pose || d.captured_ms < p.pose_time_ms) return false;
+    *age = d.captured_ms - p.pose_time_ms;
+    return true;
+}
+
+void capture(Diagnostics &d) {
+    d = {};
+    d.status = sst_net_status(NULL, 0);
+    d.connection = sst_net_stats();
+    d.host_port = sst_host_port();
+    d.player_id = sst_net_my_id();
+    d.generation = sst_net_generation();
+    d.avatars = g_sst.show_avatars;
+    d.frame_rate = g_settings.frame_rate;
+    SstLocal local = sst_game_local();
+    d.local_valid = local.valid;
+    if (local.valid) {
+        d.scene = local.scene;
+        d.pose = local.pose;
+        d.animation_length = local.animation_length;
+    }
+    d.peer_count = sst_net_players(d.peers, SST_MAX_PLAYERS);
+    if (d.peer_count < 0) d.peer_count = 0;
+    if (d.peer_count > SST_MAX_PLAYERS) d.peer_count = SST_MAX_PLAYERS;
+    d.animation = sst_animation_stats();
+    d.replay = sst_animation_replay_stats();
+    // Verified model-only hand variants map to the canonical wrist families in sst_avatar.c.
+    d.left_wrist_mesh = sst_avatar_pose_mesh(46, 0, 0);
+    d.right_wrist_mesh = sst_avatar_pose_mesh(47, 0, 0);
+    d.left_wrist = sst_animation_part_stats(d.left_wrist_mesh);
+    d.right_wrist = sst_animation_part_stats(d.right_wrist_mesh);
+    d.captured_ms = sst_now_ms();
+}
+
+// Fixed capacity even if the server presents the maximum player list. A truncated report is never copied.
+struct Report {
+    char text[16384] = {};
+    size_t used = 0;
+    bool complete = true;
+    void add(const char *format, ...) {
+        if (!complete) return;
+        va_list args;
+        va_start(args, format);
+        int written = vsnprintf(text + used, sizeof text - used, format, args);
+        va_end(args);
+        if (written < 0 || (size_t)written >= sizeof text - used) complete = false;
+        else used += (size_t)written;
+    }
+};
+
+void build_report(const Diagnostics &d, Report &r) {
+    r.add("Skyward Sword Together diagnostics\nProtocol: %d\nSnapshot monotonic time: %llu ms\n",
+        SST_PROTO, (unsigned long long)d.captured_ms);
+    r.add("Status: %s\nSession role: %s\nListener port: %u\nLocal player ID: %u\nConnection generation: %u\nOther players: %d\n",
+        status_text(d.status), role_text(d), d.host_port, d.player_id, d.generation, d.peer_count);
+    r.add("Movement transport: %s\nUDP available: %s\n", transport_text(d), d.connection.udp_available ? "yes" : "no");
+    if (d.connection.has_rtt) r.add("Host/relay RTT: %u ms\n", d.connection.rtt_ms);
+    else r.add("Host/relay RTT: unavailable\n");
+    if (d.connection.online) r.add("Last packet age: %llu ms\n", (unsigned long long)d.connection.last_packet_age_ms);
+    r.add("TCP queued bytes: %llu\nQueue recoveries: %u\nUDP sent/received/fallbacks: %u/%u/%u\n",
+        (unsigned long long)d.connection.queued_bytes, d.connection.queue_recoveries,
+        d.connection.udp_sent, d.connection.udp_received, d.connection.udp_fallbacks);
+    r.add("Target FPS: %d\nRemote characters: %s\nLocal gameplay sample: %s\n",
+        d.frame_rate, d.avatars ? "shown" : "hidden", d.local_valid ? "valid" : "unavailable");
+    if (d.local_valid) {
+        r.add("Local scene: %.63s / room %u / layer %u / entrance %u\nLocal action/clip/frame: %u/%u/%.2f\nLocal clip length: %.2f\n",
+            d.scene.stage, d.scene.room, d.scene.layer, d.scene.entrance,
+            d.pose.action, d.pose.anim_id, d.pose.anim_frame, d.animation_length);
+    }
+    for (int i = 0; i < d.peer_count; ++i) {
+        const SstPlayer &p = d.peers[i];
+        r.add("Peer %u: presence generation %u; same scene %s; scene %.63s / room %u / layer %u / entrance %u; ",
+            p.id, p.presence_generation, same_scene(d, p) ? "yes" : "no", p.scene.stage,
+            p.scene.room, p.scene.layer, p.scene.entrance);
+        uint64_t age;
+        if (p.has_pose) r.add("action/clip/frame %u/%u/%.2f; ", p.pose.action, p.pose.anim_id, p.pose.anim_frame);
+        else r.add("no pose; ");
+        if (pose_age(d, p, &age)) r.add("pose age %llu ms\n", (unsigned long long)age);
+        else r.add("pose age unavailable\n");
+    }
+    r.add("Replay decisions (cumulative peer frames):\nExact animation: %llu\nStatic idle fallback: %llu\nUnavailable: %llu\nSuppressed replay parts (total): %llu\nCached static-idle parts: %zu\n",
+        (unsigned long long)d.replay.exact_frames, (unsigned long long)d.replay.neutral_frames,
+        (unsigned long long)d.replay.unavailable_frames, (unsigned long long)d.replay.suppressed_parts,
+        d.replay.neutral_parts);
+    const SstAnimationStats &a = d.animation;
+    r.add("Pose cache bytes/budget: %zu/%u\nPose cache samples: %zu\nCaptures: %llu\nReplay hits/misses: %llu/%llu\n",
+        a.bytes, SST_ANIMATION_BUDGET, a.samples, (unsigned long long)a.captures,
+        (unsigned long long)a.hits, (unsigned long long)a.misses);
+    r.add("Skinned hits/misses: %llu/%llu\nCached attachments: %llu\nAttachment hits: %llu\nHidden rigid draws (total): %llu\n",
+        (unsigned long long)a.skinned_hits, (unsigned long long)a.skinned_misses,
+        (unsigned long long)a.attachments, (unsigned long long)a.attachment_hits, (unsigned long long)a.rigid_skips);
+    r.add("Sword captures/hits: %llu/%llu\nTransition resumes: %llu\nLeft wrist family %u hits/misses: %llu/%llu\nRight wrist family %u hits/misses: %llu/%llu\n",
+        (unsigned long long)a.sword_captures, (unsigned long long)a.sword_hits, (unsigned long long)a.resumes,
+        d.left_wrist_mesh, (unsigned long long)d.left_wrist.hits, (unsigned long long)d.left_wrist.misses,
+        d.right_wrist_mesh, (unsigned long long)d.right_wrist.hits, (unsigned long long)d.right_wrist.misses);
+    r.add("Counters are cumulative since cache/connection reset. Peer poses are last received network samples.\n"
+        "Replay decisions are separate rendering totals. Static idle fallback holds an observed idle pose.\n"
+        "Player names, host addresses, session room/team names, saves and assets are omitted.\n");
+}
+}  // namespace
+
+void tab_developer(float scale) {
+    (void)scale;
+    static Diagnostics d;
+    static bool initialized, frozen, copy_error;
+    uint64_t now = sst_now_ms();
+    if (!initialized || (!frozen && (now < d.captured_ms || now - d.captured_ms >= 250))) {
+        capture(d);
+        initialized = true;
+    }
+
+    ImGui::TextUnformatted("Skyward Sword Together diagnostics");
+    ImGui::TextDisabled("Read-only snapshot; refreshes up to four times per second.");
+    if (ImGui::Checkbox("Freeze snapshot", &frozen) && !frozen) capture(d);
+    ImGui::SameLine();
+    if (ImGui::Button("Capture now")) capture(d);
+    int copy_status = menu_diagnostics_copy_status();
+    ImGui::BeginDisabled(copy_status == 1);
+    if (ImGui::Button("Copy diagnostics")) {
+        Report report;
+        build_report(d, report);
+        copy_error = !report.complete || !menu_copy_diagnostics(report.text);
+    }
+    ImGui::EndDisabled();
+    if (copy_error || copy_status == -1) ImGui::TextWrapped("Clipboard copy failed. Try Copy diagnostics again.");
+    else if (copy_status == 1) ImGui::TextDisabled("Copying snapshot...");
+    else if (copy_status == 2) ImGui::TextDisabled("Snapshot copied to clipboard.");
+    ImGui::TextWrapped("Copied text omits player names, host addresses, session room/team names, saves and assets.");
+    if (frozen) ImGui::TextDisabled("Frozen snapshot: %.1f s old", now >= d.captured_ms ? (now - d.captured_ms) / 1000.0 : 0.0);
+
+    if (ImGui::CollapsingHeader("Connection", ImGuiTreeNodeFlags_DefaultOpen)) {
+        ImGui::Text("%s | Session role: %s", status_text(d.status), role_text(d));
+        if (d.host_port) ImGui::Text("Listening on port: %u", d.host_port);
+        ImGui::TextWrapped("Local ID: %u | Connection generation: %u | Other players: %d", d.player_id, d.generation, d.peer_count);
+        if (d.status == SST_ONLINE && !d.peer_count)
+            ImGui::TextWrapped("No other players are connected to this room. Both games being Online does not confirm a shared session.");
+        ImGui::Text("Movement: %s", transport_text(d));
+        if (d.connection.has_rtt) ImGui::Text("Host/relay RTT: %u ms", d.connection.rtt_ms);
+        else ImGui::TextDisabled("Host/relay RTT: unavailable");
+        if (d.connection.online) ImGui::TextWrapped("Last packet: %llu ms ago | TCP queued: %llu bytes",
+            (unsigned long long)d.connection.last_packet_age_ms, (unsigned long long)d.connection.queued_bytes);
+        ImGui::TextWrapped("UDP sent/received/fallbacks: %u / %u / %u | Queue recoveries: %u",
+            d.connection.udp_sent, d.connection.udp_received, d.connection.udp_fallbacks, d.connection.queue_recoveries);
+        ImGui::TextWrapped("Protocol: %d | Target: %d FPS | Remote characters: %s", SST_PROTO, d.frame_rate, d.avatars ? "shown" : "hidden");
+        if (d.frame_rate != 60) ImGui::TextWrapped("60 FPS on both PCs is recommended for current co-op testing.");
+    }
+
+    if (ImGui::CollapsingHeader("Local player", ImGuiTreeNodeFlags_DefaultOpen)) {
+        if (!d.local_valid) ImGui::TextDisabled("No valid gameplay sample.");
+        else {
+            ImGui::TextWrapped("Scene: %.63s | Room: %u | Layer: %u | Entrance: %u", d.scene.stage, d.scene.room, d.scene.layer, d.scene.entrance);
+            ImGui::TextWrapped("Action: %u | Clip: %u | Frame: %.2f | Clip length: %.2f",
+                d.pose.action, d.pose.anim_id, d.pose.anim_frame, d.animation_length);
+        }
+    }
+
+    if (ImGui::CollapsingHeader("Other players", ImGuiTreeNodeFlags_DefaultOpen)) {
+        ImGui::TextDisabled("Last received poses; ages are measured at the snapshot time.");
+        if (!d.peer_count) ImGui::TextDisabled("No peers in this room.");
+        else if (ImGui::BeginTable("##sst_debug_peers", 4, ImGuiTableFlags_RowBg | ImGuiTableFlags_BordersInnerH)) {
+            ImGui::TableSetupColumn("Player");
+            ImGui::TableSetupColumn("Scene");
+            ImGui::TableSetupColumn("Animation");
+            ImGui::TableSetupColumn("Pose age");
+            ImGui::TableHeadersRow();
+            for (int i = 0; i < d.peer_count; ++i) {
+                const SstPlayer &p = d.peers[i];
+                ImGui::TableNextRow();
+                ImGui::TableNextColumn();
+                ImGui::TextWrapped("%.63s (ID %u)", p.name, p.id);
+                ImGui::TextDisabled("Generation: %u", p.presence_generation);
+                ImGui::TableNextColumn();
+                if (p.scene.stage[0]) {
+                    ImGui::TextWrapped("%.63s / room %u / layer %u", p.scene.stage, p.scene.room, p.scene.layer);
+                    ImGui::TextDisabled("%s", same_scene(d, p) ? "Same scene" : "Different / no local scene");
+                } else ImGui::TextDisabled("Not in game");
+                ImGui::TableNextColumn();
+                if (p.has_pose) {
+                    ImGui::Text("Action: %u", p.pose.action);
+                    ImGui::Text("Clip: %u", p.pose.anim_id);
+                    ImGui::Text("Frame: %.2f", p.pose.anim_frame);
+                }
+                else ImGui::TextDisabled("No pose");
+                ImGui::TableNextColumn();
+                uint64_t age;
+                if (pose_age(d, p, &age)) ImGui::Text("%llu ms", (unsigned long long)age);
+                else ImGui::TextDisabled("Unavailable");
+            }
+            ImGui::EndTable();
+        }
+    }
+
+    if (ImGui::CollapsingHeader("Avatar replay decisions", ImGuiTreeNodeFlags_DefaultOpen)) {
+        ImGui::TextWrapped("Peer frames (total): exact animation %llu | static idle fallback %llu | unavailable %llu",
+            (unsigned long long)d.replay.exact_frames, (unsigned long long)d.replay.neutral_frames,
+            (unsigned long long)d.replay.unavailable_frames);
+        ImGui::TextWrapped("Suppressed replay parts (total): %llu | Cached static-idle parts: %zu",
+            (unsigned long long)d.replay.suppressed_parts, d.replay.neutral_parts);
+        ImGui::TextWrapped("These rendering totals are separate from the received peer clips above. Static fallback holds an observed idle pose instead of reproducing the requested action.");
+    }
+
+    if (ImGui::CollapsingHeader("Avatar pose cache", ImGuiTreeNodeFlags_DefaultOpen)) {
+        const SstAnimationStats &a = d.animation;
+        ImGui::TextWrapped("Cache: %.2f / %.0f MiB | Samples: %zu | Captures: %llu",
+            a.bytes / (1024.0 * 1024.0), SST_ANIMATION_BUDGET / (1024.0 * 1024.0), a.samples, (unsigned long long)a.captures);
+        ImGui::TextWrapped("Replay hits/misses: %llu / %llu | Skinned: %llu / %llu",
+            (unsigned long long)a.hits, (unsigned long long)a.misses,
+            (unsigned long long)a.skinned_hits, (unsigned long long)a.skinned_misses);
+        ImGui::TextWrapped("Cached attachments: %llu | Attachment hits: %llu | Hidden rigid draws (total): %llu",
+            (unsigned long long)a.attachments, (unsigned long long)a.attachment_hits, (unsigned long long)a.rigid_skips);
+        ImGui::TextWrapped("Left wrist hits/misses: %llu / %llu | Right wrist: %llu / %llu",
+            (unsigned long long)d.left_wrist.hits, (unsigned long long)d.left_wrist.misses,
+            (unsigned long long)d.right_wrist.hits, (unsigned long long)d.right_wrist.misses);
+        ImGui::TextWrapped("Sword captures/hits: %llu / %llu | Transition resumes: %llu",
+            (unsigned long long)a.sword_captures, (unsigned long long)a.sword_hits, (unsigned long long)a.resumes);
+        ImGui::TextWrapped("Replay and hidden-draw counters accumulate until the cache resets; they are not counts of players or currently missing parts. Wrist counters cover verified model-only hand families.");
+    }
+}
