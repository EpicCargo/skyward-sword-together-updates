+static bool prepare_receipt(Cpu *c, ChestReceipt *r) {
+    if (!r->loaded) return true;
+    uint64_t vt = r64(r->space), fn = ptr(vt, 8) ? r64(vt) : 0;
+    if (!code(fn)) return false;
+    call(c, fn, r->space, 0, 0); // native FlagSpace copy-on-write
+    r->raw = r64(r->space + 8);
+    return ptr(r->raw, r->story ? 256 : r->scene ? 16 : 4);
