+// Heart pieces have two counters, a modulo-four remainder and a capped total. Validate the
+// complete native path before touching inventory; a plain ownership flag cannot grant health.
+static bool heart_counters(Cpu *c, uint64_t fm, uint64_t ob[2], uint64_t vt[2], unsigned before[2]) {
+    for (unsigned i = 0; i < 2; i++) {
+        ob[i] = r64(COUNTERS + (8 + i) * 8); vt[i] = ptr(ob[i], 16) ? r64(ob[i]) : 0;
