+++ b/runtime/gamebuild.c
@@ -1,6 +1,7 @@
 // Builds the game code library on the player's machine (runtime/gamebuild.h).
 #include "gamebuild.h"
 
+#include <errno.h>
 #include <pthread.h>
 #include <stdint.h>
 #include <stdio.h>
@@ -13,6 +14,16 @@
 #include "platform.h"
 #include "rt.h"
 
+int gamebuild_default_jobs(void) {
+    const char *value = getenv("SST_BUILD_JOBS");
+    if (!value || !*value) return 1;
+    char *end;
+    errno = 0;
+    long jobs = strtol(value, &end, 10);
+    if (errno || *end || jobs < 1) return 1;
+    return jobs > 64 ? 64 : (int)jobs;
+}
+
 // From the Makefile: the flags the game code is compiled and linked with (as `make` builds it in a source checkout)
 #ifndef GAMELIB_CFLAGS
 #define GAMELIB_CFLAGS "-O0 -fno-strict-aliasing -fvisibility=hidden -fno-sanitize=all"
@@ -54,10 +65,12 @@ static PlatProc spawn(char **argv, const char *log) {
 // plat_proc_wait without blocking, then forgotten once it has ended
 static int finished(PlatProc p) {
     pthread_mutex_lock(&g_plock);
-    int r = plat_proc_wait(p, false);
-    if (r >= 0)
-        for (int i = 0; i < g_nprocs; i++)
-            if (g_procs[i] == p) { g_procs[i] = g_procs[--g_nprocs]; break; }
+    int i = 0;
+    while (i < g_nprocs && g_procs[i] != p) i++;
+    // Shutdown may already have reaped this child while a build worker was
+    // waiting for the lock. Never dereference its former Windows child handle.
+    int r = i == g_nprocs ? 255 : plat_proc_wait(p, false);
+    if (r >= 0 && i < g_nprocs) g_procs[i] = g_procs[--g_nprocs];
     pthread_mutex_unlock(&g_plock);
     return r;
 }
@@ -132,6 +145,8 @@ static bool find_tools(Tools *t) {
     e = getenv("LARECOMP_CC");
     if (e && *e) snprintf(t->cc, sizeof t->cc, "%s", e);
 #ifdef _WIN32
+    // The portable Windows compiler needs no installer or compiler cache setup.
+    else if (rt_resource("compiler" SEP "bin" SEP "clang.exe", NULL, t->cc, sizeof t->cc)) {}
     else if (file_exists("F:\\msys64\\ucrt64\\bin\\clang.exe")) snprintf(t->cc, sizeof t->cc, "F:\\msys64\\ucrt64\\bin\\clang.exe");
     else if (file_exists("C:\\msys64\\ucrt64\\bin\\clang.exe")) snprintf(t->cc, sizeof t->cc, "C:\\msys64\\ucrt64\\bin\\clang.exe");
 #endif
@@ -240,6 +255,7 @@ static void log_error(const char *path, char *out, size_t n) {  // first error l
