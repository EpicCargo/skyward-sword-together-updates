+    d.right_wrist_mesh = 23;
+    d.left_wrist = {31, 11};
+    d.right_wrist = {37, 17};
+    d.replay.exact_frames = 211;
+    d.replay.neutral_frames = 43;
+    d.replay.unavailable_frames = 9;
+    d.replay.suppressed_parts = 67;
+    d.replay.neutral_parts = 19;
+    Report r = report_for(d);
+    for (const char *private_value : private_values) CHECK(!contains(r, private_value));
+    CHECK(contains(r, "Local player ID: 7\nConnection generation: 3\nOther players: 1\n"));
+    CHECK(contains(r, "Local scene: F001r / room 2 / layer 1 / entrance 4\n"));
+    CHECK(contains(r, "Local action/clip/frame: 19/42/12.50\nLocal clip length: 48.00\n"));
+    CHECK(contains(r, "Peer 8: presence generation 4; same scene yes;"));
+    CHECK(contains(r, "action/clip/frame 27/93/6.25; pose age 250 ms\n"));
+    CHECK(contains(r, "Pose cache bytes/budget: 4096/8388608\nPose cache samples: 17\nCaptures: 23\n"));
+    CHECK(contains(r, "Replay hits/misses: 101/7\nSkinned hits/misses: 89/3\n"));
+    CHECK(contains(r, "Cached attachments: 2\nAttachment hits: 53\nHidden rigid draws (total): 29\n"));
+    CHECK(contains(r, "Sword captures/hits: 13/47\nTransition resumes: 5\n"));
+    CHECK(contains(r, "Left wrist family 34 hits/misses: 31/11\nRight wrist family 23 hits/misses: 37/17\n"));
+    CHECK(contains(r, "Replay decisions (cumulative peer frames):\nExact animation: 211\nStatic idle fallback: 43\nUnavailable: 9\n"));
+    CHECK(contains(r, "Suppressed replay parts (total): 67\nCached static-idle parts: 19\n"));
+    CHECK(contains(r, "Replay decisions are separate rendering totals. Static idle fallback holds an observed idle pose.\n"));
+}
+
+void pose_age_and_scene_boundaries(void) {
+    Diagnostics d = gameplay_sample();
+    SstPlayer &p = d.peers[0];
+    uint64_t age = 123;
+    CHECK(pose_age(d, p, &age) && age == 250);
+    p.pose_time_ms = d.captured_ms;
+    CHECK(pose_age(d, p, &age) && age == 0);
+    p.pose_time_ms = d.captured_ms + 1;
+    age = 123;
+    CHECK(!pose_age(d, p, &age) && age == 123);
+    Report r = report_for(d);
+    CHECK(contains(r, "pose age unavailable\n"));
+    CHECK(!contains(r, "18446744073709551615 ms"));
+    p.pose_time_ms = UINT64_MAX;
+    CHECK(!pose_age(d, p, &age));
+    p.pose_time_ms = 1;
+    d.captured_ms = 600000;
+    r = report_for(d);
+    CHECK(contains(r, "pose age 599999 ms\n"));
+    p.has_pose = false;
+    r = report_for(d);
+    CHECK(contains(r, "no pose; pose age unavailable\n"));
+    CHECK(!contains(r, "action/clip/frame 27/93/6.25"));
+
+    CHECK(same_scene(d, p));
+    ++p.scene.entrance;  // Different entrances into one loaded scene do not hide a teammate.
+    CHECK(same_scene(d, p));
+    ++p.scene.room;
+    CHECK(!same_scene(d, p));
+    --p.scene.room;
+    ++p.scene.layer;
+    CHECK(!same_scene(d, p));
+    --p.scene.layer;
+    p.scene.stage[0] = 'B';
+    CHECK(!same_scene(d, p));
+    p.scene = d.scene;
+    d.local_valid = false;
+    CHECK(!same_scene(d, p));
+}
+
+void maximum_report_and_overflow(void) {
+    Diagnostics d = gameplay_sample();
+    d.captured_ms = UINT64_MAX;
+    d.peer_count = SST_MAX_PLAYERS;
+    memset(d.scene.stage, 'S', sizeof d.scene.stage - 1);
+    d.scene.stage[sizeof d.scene.stage - 1] = 0;
+    d.pose.anim_frame = FLT_MAX;
+    d.animation_length = FLT_MAX;
+    d.connection.queued_bytes = UINT64_MAX;
+    d.animation.bytes = SST_ANIMATION_BUDGET;
+    d.animation.captures = UINT64_MAX;
+    d.replay.exact_frames = d.replay.neutral_frames = d.replay.unavailable_frames = UINT64_MAX;
+    d.replay.suppressed_parts = UINT64_MAX;
+    d.replay.neutral_parts = SIZE_MAX;
+    for (int i = 0; i < SST_MAX_PLAYERS; ++i) {
+        SstPlayer &p = d.peers[i];
+        p = d.peers[0];
+        p.id = (uint16_t)(i + 1);
+        p.presence_generation = UINT32_MAX;
+        p.scene = d.scene;
+        p.scene.room = p.scene.layer = p.scene.entrance = UINT8_MAX;
+        p.has_pose = true;
+        p.pose.action = p.pose.anim_id = UINT16_MAX;
+        p.pose.anim_frame = -FLT_MAX;
+        p.pose_time_ms = 0;
+    }
+    Report r = report_for(d);
+    const char *cursor = r.text;
+    int peers_found = 0;
+    while ((cursor = strstr(cursor, "\nPeer ")) != NULL) { ++peers_found; ++cursor; }
+    CHECK(peers_found == SST_MAX_PLAYERS);
+    for (int i = 0; i < SST_MAX_PLAYERS; ++i) {
+        char label[64];
+        snprintf(label, sizeof label, "\nPeer %d: presence generation 4294967295;", i + 1);
+        CHECK(contains(r, label));
+    }
+    CHECK(contains(r, "pose age 18446744073709551615 ms\n"));
+    CHECK(contains(r, "Hidden rigid draws (total):"));
+    CHECK(contains(r, "saves and assets are omitted.\n"));  // Tail survives maximum legal peer input.
+
+    struct GuardedReport { Report report; uint64_t guard = UINT64_C(0x123456789abcdef0); } guarded;
+    char oversized[17000];
+    memset(oversized, 'X', sizeof oversized - 1);
+    oversized[sizeof oversized - 1] = 0;
+    guarded.report.add("%s", oversized);
+    CHECK(!guarded.report.complete);
+    CHECK(guarded.report.text[sizeof guarded.report.text - 1] == 0);
+    CHECK(guarded.guard == UINT64_C(0x123456789abcdef0));
+    CHECK(guarded.report.used < sizeof guarded.report.text);
+    guarded.report.add("SHOULD_NOT_BE_APPENDED");
+    CHECK(!contains(guarded.report, "SHOULD_NOT_BE_APPENDED"));
+
+    // Exact capacity succeeds including the trailing NUL; the next byte must fail closed.
+    guarded = {};
+    guarded.report.add("%.*s", (int)sizeof guarded.report.text - 1, oversized);
+    CHECK(guarded.report.complete);
+    CHECK(guarded.report.used == sizeof guarded.report.text - 1);
+    guarded.report.add("X");
+    CHECK(!guarded.report.complete);
+    CHECK(guarded.report.text[sizeof guarded.report.text - 1] == 0);
+    CHECK(guarded.guard == UINT64_C(0x123456789abcdef0));
+}
+}  // namespace
+
+int main(void) {
+    offline_and_roles();
+    useful_fields_and_privacy();
+    pose_age_and_scene_boundaries();
+    maximum_report_and_overflow();
+    printf("SST diagnostics: %u checks passed\n", checks);
+    return 0;
+}
diff --git a/tools/test_windows_process.c b/tools/test_windows_process.c
new file mode 100644
index 0000000..a50388a
--- /dev/null
+++ b/tools/test_windows_process.c
@@ -0,0 +1,69 @@
+// Isolated Windows regression: cancelling/waiting reaps this child's descendants only.
+#include <assert.h>
+#include "../runtime/platform/windows.c"
+
+bool rt_fault_watch(uint64_t a, uint64_t pc) { (void)a; (void)pc; return false; }
+const char *rt_host_fn_name(uint64_t pc, uint64_t *offset) { (void)pc; (void)offset; return NULL; }
+void rt_fault_report(const char *what, uint64_t a, uint64_t pc, uint64_t lr) {
+    (void)what; (void)a; (void)pc; (void)lr; abort();
+}
+
+static PROCESS_INFORMATION direct(const char *exe, const char *mode, const char *file) {
+    char command[4096] = {0};
+    append_arg(command, sizeof command, exe);
+    append_arg(command, sizeof command, mode);
+    if (file) append_arg(command, sizeof command, file);
+    STARTUPINFOA info = {.cb = sizeof info};
+    PROCESS_INFORMATION child = {0};
+    assert(CreateProcessA(NULL, command, NULL, NULL, FALSE, CREATE_NO_WINDOW, NULL, NULL, &info, &child));
+    CloseHandle(child.hThread);
+    return child;
+}
+
+static HANDLE leaf(const char *path) {
+    unsigned long id = 0;
+    for (int i = 0; i < 100 && !id; i++) {
+        FILE *f = fopen(path, "r");
+        if (f) { fscanf(f, "%lu", &id); fclose(f); }
+        if (!id) Sleep(20);
+    }
+    assert(id);
+    HANDLE process = OpenProcess(SYNCHRONIZE | PROCESS_QUERY_LIMITED_INFORMATION, FALSE, id);
+    assert(process && WaitForSingleObject(process, 0) == WAIT_TIMEOUT);
+    return process;
+}
+
+int main(int argc, char **argv) {
+    if (argc > 1 && !strcmp(argv[1], "leaf")) {
+        FILE *f = fopen(argv[2], "w"); assert(f);
+        fprintf(f, "%lu", GetCurrentProcessId()); fclose(f);
+        Sleep(30000); return 0;
+    }
+    if (argc > 1 && !strcmp(argv[1], "unrelated")) { Sleep(30000); return 0; }
+    char exe[2048]; assert(GetModuleFileNameA(NULL, exe, sizeof exe));
+    if (argc > 1 && (!strcmp(argv[1], "branch") || !strcmp(argv[1], "branch-exit"))) {
+        PROCESS_INFORMATION child = direct(exe, "leaf", argv[2]); CloseHandle(child.hProcess);
+        if (!strcmp(argv[1], "branch")) Sleep(30000);
+        return 0;
+    }
+    remove("leaf.pid"); remove("exit-leaf.pid");
+    PROCESS_INFORMATION unrelated = direct(exe, "unrelated", NULL);
+    const char *command[] = {exe, "branch", "leaf.pid", NULL};
+    PlatProc child = plat_spawn(command, "child.log", false); assert(child);
+    HANDLE descendant = leaf("leaf.pid");
+    assert(plat_proc_wait(child, false) == -1);
+    plat_proc_kill(child);
+    assert(WaitForSingleObject(descendant, 2000) == WAIT_OBJECT_0); CloseHandle(descendant);
+    assert(WaitForSingleObject(unrelated.hProcess, 0) == WAIT_TIMEOUT);
+    const char *exit_command[] = {exe, "branch-exit", "exit-leaf.pid", NULL};
+    child = plat_spawn(exit_command, "exit-child.log", false); assert(child);
+    descendant = leaf("exit-leaf.pid");
+    assert(plat_proc_wait(child, true) == 0);
+    assert(WaitForSingleObject(descendant, 2000) == WAIT_OBJECT_0); CloseHandle(descendant);
+    assert(WaitForSingleObject(unrelated.hProcess, 0) == WAIT_TIMEOUT);
+    TerminateProcess(unrelated.hProcess, 0); WaitForSingleObject(unrelated.hProcess, 2000);
+    CloseHandle(unrelated.hProcess);
+    remove("leaf.pid"); remove("exit-leaf.pid"); remove("child.log"); remove("exit-child.log");
+    puts("Windows process jobs: cancellation, descendant cleanup, normal exit and unrelated process survival PASS");
+    return 0;
+}
