+#include <string.h>
+
+#define PLAYER 0x7002bf9940ull
+#define FILE_MGR 0x7002bf9cc0ull
+#define STORY_MGR 0x700182e1f0ull
+#define ITEM_MGR 0x700182e168ull
+#define SCENE_MGR 0x700182def8ull
+#define DUNGEON_MGR 0x700182e120ull
+#define ENEMY_MGR 0x700182e160ull
+#define TBOX_MGR 0x700182e110ull
+#define COUNTERS 0x700164b7e0ull
+#define RELOADER 0x7002bf9930ull
+#define DELETE_REQUEST 0x7000f0f9ccull
+#define TRIGGER_ENTRANCE 0x7000df4fdcull
