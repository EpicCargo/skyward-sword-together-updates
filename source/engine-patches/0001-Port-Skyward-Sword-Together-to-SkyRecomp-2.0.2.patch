+static bool chest_receipt(uint64_t fm, unsigned index, ChestReceipt *out) {
+    ChestReceipt r = {0};
+    if (sst_chest_shop_item(index) == 94) {
+        Flags f = flags(STORY_MGR, 1202, 128); uint64_t word; uint16_t mask;
+        unsigned flag = index - SST_CONTAINER_CHESTS;
+        if (!f.mgr || !location(&f, flag, &word, &mask)) return false;
+        r.mgr = f.mgr; r.space = r64(f.mgr + 0x10); r.raw = f.raw;
+        r.bit = r8(f.defs + flag * 2) * 16 + (r8(f.defs + flag * 2 + 1) >> 4);
