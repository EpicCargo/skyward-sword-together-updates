diff --git a/tools/test_condvar_publish.c b/tools/test_condvar_publish.c
new file mode 100644
index 0000000..c5e8fcc
--- /dev/null
+++ b/tools/test_condvar_publish.c
@@ -0,0 +1,69 @@
+// Force a signaler to inspect the waiter flag immediately after the guest mutex is released.
+// This is the user-space fast path used by the SDK's condition variables.
+#define _GNU_SOURCE
+#include <assert.h>
+#include <pthread.h>
+#include <sched.h>
+#include <stdatomic.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <time.h>
+#include "../runtime/hle.h"
+#include "../runtime/kernel.h"
+
+static uint32_t guest_mutex, guest_key;
+static atomic_bool signal_checked, unlock_observed;
+static uint32_t flag_at_signal;
+
+static void schedule_after_unlock(uint32_t *p, uint32_t value, int order) {
+    __atomic_store_n(p, value, order);
+    if (p == &guest_mutex && value == 0 && !atomic_exchange(&unlock_observed, true))
+        while (!atomic_load(&signal_checked)) sched_yield();
+}
+
+#define __atomic_store_n(p, v, order) schedule_after_unlock((p), (v), (order))
+#include "../runtime/kernel.c"
+#undef __atomic_store_n
+
+volatile int g_rt_unwind;
+uint64_t plat_now_ns(void) {
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (uint64_t)ts.tv_sec * 1000000000ull + ts.tv_nsec;
+}
+
+static void *signal_thread(void *arg) {
+    KThread *t = arg;
+    t_cur = t;
+    for (;;) {
+        uint32_t empty = 0;
+        if (__atomic_compare_exchange_n(&guest_mutex, &empty, t->handle, false,
+                                        __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST)) break;
+        sched_yield();
+    }
+    flag_at_signal = __atomic_load_n(&guest_key, __ATOMIC_SEQ_CST);
+    atomic_store(&signal_checked, true);
+    if (flag_at_signal) svc_signal_process_wide_key((uint64_t)(uintptr_t)&guest_key, 1);
+    svc_arbitrate_unlock((uint64_t)(uintptr_t)&guest_mutex);
+    return NULL;
+}
+
+int main(void) {
+    KThread waiter = {.handle = 0x301, .prio = 30}, signaler = {.handle = 0x302, .prio = 30};
+    assert(!pthread_cond_init(&waiter.cond, NULL));
+    assert(!pthread_cond_init(&signaler.cond, NULL));
+    t_cur = &waiter;
+    guest_mutex = waiter.handle;
+    pthread_t thread;
+    assert(!pthread_create(&thread, NULL, signal_thread, &signaler));
+    uint32_t result = svc_wait_process_wide_key((uint64_t)(uintptr_t)&guest_mutex,
+        (uint64_t)(uintptr_t)&guest_key, waiter.handle, 50000000);
+    assert(!pthread_join(thread, NULL));
+    assert(flag_at_signal == 1 && "a signaler must see the published waiter after acquiring the mutex");
+    assert(result == R_OK && "the signal must wake the waiter without a timeout");
+    assert(guest_mutex == waiter.handle && guest_key == 0);
+    pthread_cond_destroy(&waiter.cond);
+    pthread_cond_destroy(&signaler.cond);
+    puts("condvar: notification at mutex handoff is delivered and the waiter reacquires ownership");
+}
