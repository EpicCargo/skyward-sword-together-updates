+    r.mgr = r64(r.scene ? SCENE_MGR : TBOX_MGR);
+    if (!ptr(r.mgr, r.scene ? 0x50 : 0x30)) return false;
+    r.space = r.mgr + (r.scene ? 0 : 0x10);
+    r.raw = r64(r.space + 8);
+    if (r16(r.space + 0x10) != (r.scene ? 8 : 2) || !ptr(r.raw, r.scene ? 16 : 4)) return false;
+    unsigned current = r16(r.mgr + (r.scene ? 0x4a : 0x28));
+    if (current >= 26) return false;
+    r.loaded = current == r.table;
+    r.saved = fm + (r.scene ? 0x1a74 : 0x2a74) + r.table * (r.scene ? 16 : 4) + (r.bit / 16) * 2;
