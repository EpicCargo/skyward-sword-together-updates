+static uint64_t result_call(Cpu *c, uint64_t fn, uint64_t a, uint64_t b) {
+    Cpu saved = *c; c->x[0] = a; c->x[1] = b; guest_call(c, fn);
+    uint64_t result = c->x[0]; *c = saved; return result;
