+static unsigned actor_chest_index(uint64_t a, unsigned tbox, unsigned scene) {
+    if (r16(a + 0x10) == 0x281) return sst_chest_index(true, scene, (r32(a + 0xc) >> 10) & 255);
+    if (r16(a + 0x10) == 0x8b) return sst_chest_index(true, scene, r32(a + 0xc) & 255);
+    if (r16(a + 0x10) == 0x1eb) return sst_chest_index(true, scene, (r32(a + 0xc) >> 4) & 255);
+    unsigned bit = r8(a + 0x1997);
+    return bit < 32 ? sst_chest_index(false, tbox, bit) :
+        sst_chest_index(true, scene, r8(a + 0x1996));
