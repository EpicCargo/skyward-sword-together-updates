+typedef struct { Flags flags; uint64_t word, saved, setter; unsigned live, stored, count, shift; uint16_t mask; } ShopCounter;
+static bool shop_counter(uint64_t fm, unsigned flag, ShopCounter *out) {
+    if (flag != 707 && flag != 708) return false;
+    Flags f = flags(STORY_MGR, 1202, 128);
+    unsigned shift = flag == 707 ? 9 : 11;
+    if (!f.mgr || r8(f.defs + flag * 2) != 119 || r8(f.defs + flag * 2 + 1) != (shift << 4 | 1)) return false;
+    uint64_t vt = r64(f.mgr), setter = ptr(vt, 0x50) ? r64(vt + 0x48) : 0;
+    if (!code(setter)) return false;
+    uint64_t word = f.raw + 238, saved = fm + 0x8f4 + 238;
+    unsigned live = (r16(word) >> shift) & 3, stored = (r16(saved) >> shift) & 3, slot = flag - 707;
+    if (!strcmp(loaded_scene.stage, "F002r") && stored > live && stored > deferred_shop_counts[slot]) {
+        deferred_shop_counts[slot] = stored;
+        LOG("[sst-shop] retained saved purchase proof flag=%u count=%u until shop exit\n", flag, stored);
+    }
+    unsigned count = live > stored ? live : stored;
+    if (deferred_shop_counts[slot] > count) count = deferred_shop_counts[slot];
+    if (live >= deferred_shop_counts[slot] && stored >= deferred_shop_counts[slot]) deferred_shop_counts[slot] = 0;
+    *out = (ShopCounter){f, word, saved, setter, live, stored, count, shift, 3u << shift};
+    return true;
+}
+static bool repair_shop_counter(Cpu *c, uint64_t fm, unsigned flag, unsigned target) {
+    ShopCounter s;
+    if (!shop_counter(fm, flag, &s) || target > 3 || target < s.count) return false;
+    if (s.live == target && s.stored == target) return true;
+    if (!backup(fm)) return false;
+    if (s.live != target) call(c, s.setter, s.flags.mgr, flag, target);
+    if (r64(FILE_MGR) != fm || !shop_counter(fm, flag, &s) || s.live != target) return false;
+    w16(s.saved, (r16(s.saved) & ~s.mask) | (target << s.shift));
+    return true;
+}
+static bool normal_inventory(uint64_t fm) {
+    Flags story = flags(STORY_MGR, 1202, 128); uint64_t word; uint16_t mask;
+    return story.mgr && location(&story, 166, &word, &mask) && !(r16(word) & mask) &&
+        !r8(fm + 0xcd06) && !(r64(0x700192fb58ull) && r32(0x700166cc10ull) == 9);
