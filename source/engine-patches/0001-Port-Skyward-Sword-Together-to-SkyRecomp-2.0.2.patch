+// Isolated native verification can exercise the same recovery mailbox as the menu.
+static void recovery_test_input(void) {
+    const char *path = ENV("SST_RECOVERY_FILE");
+    if (!path) return;
+    FILE *f = fopen(path, "r"); if (!f) return;
+    char cmd[32] = {0}; unsigned id = 0;
+    int n = fscanf(f, "%31s %u", cmd, &id); fclose(f); remove(path);
+    if (n > 0 && !strcmp(cmd, "resync")) sst_world_request(SST_RECOVER_SYNC, 0);
+    else if (n > 0 && !strcmp(cmd, "reload")) sst_world_request(SST_RECOVER_RELOAD, 0);
+    else if (n == 2 && !strcmp(cmd, "peer") && id <= 65535) sst_world_request(SST_RECOVER_PEER, id);
+    else if (n > 0 && !strcmp(cmd, "shop-proof") && ENV("LARECOMP_DEBUG_DATA")) debug_shop_fault = true;
+    else if (n > 0 && !strcmp(cmd, "bug-proof") && ENV("LARECOMP_DEBUG_DATA")) debug_bug_fault = true;
+    else if (n > 0 && !strcmp(cmd, "ammo-proof") && ENV("LARECOMP_DEBUG_DATA")) debug_ammo_fault = true;
+    else if (n > 0 && !strcmp(cmd, "shield-proof") && ENV("LARECOMP_DEBUG_DATA")) debug_shield_fault = true;
+    else if (n > 0 && !strcmp(cmd, "sword-proof") && ENV("LARECOMP_DEBUG_DATA")) debug_sword_fault = true;
+    else if (n == 2 && !strcmp(cmd,"enemy-delay") && id < 65535 && ENV("LARECOMP_DEBUG_DATA")) {
+        debug_enemy_delay=true;debug_enemy_id=(uint16_t)id;
+        for (unsigned i=0;i<SST_ENEMIES;i++)
+            if (enemies.actors[i].used && (uint16_t)enemies.actors[i].key==id)
+                memset(&enemies.actors[i],0,sizeof enemies.actors[i]);
+        LOG("[sst-enemy] debug discovery delayed id=%u\n",id);
+    }
+    else if (n > 0 && !strcmp(cmd,"enemy-resume") && ENV("LARECOMP_DEBUG_DATA")) {
+        debug_enemy_delay=false;LOG("[sst-enemy] debug discovery resumed\n");
+    }
+    else if (n == 2 && !strcmp(cmd,"enemy-zero") && id < 65535 && ENV("LARECOMP_DEBUG_DATA")) {
+        debug_enemy_zero=true;debug_enemy_zero_id=(uint16_t)id;
+        for (unsigned i=0;i<SST_ENEMIES;i++)
+            if (enemies.actors[i].used && (uint16_t)enemies.actors[i].key==id)
+                memset(&enemies.actors[i],0,sizeof enemies.actors[i]);
+        LOG("[sst-enemy] debug zero baseline id=%u\n",id);
+    }
+    else if (n > 0 && !strcmp(cmd,"enemy-zero-resume") && ENV("LARECOMP_DEBUG_DATA")) {
+        debug_enemy_zero=false;LOG("[sst-enemy] debug zero baseline resumed\n");
+    }
+    else if (n == 2 && !strcmp(cmd,"enemy-hold-health") && id < 65535 && ENV("LARECOMP_DEBUG_DATA")) {
+        for (unsigned i=0;i<SST_ENEMIES;i++) {
+            SstEnemyTrack *a=&enemies.actors[i];
+            if (a->used && a->seen && !a->provisional && a->health && (uint16_t)a->key==id) {
+                debug_enemy_hold=true;debug_enemy_hold_id=(uint16_t)id;debug_enemy_hold_hp=a->health;
+                LOG("[sst-enemy] debug health held id=%u hp=%u\n",id,a->health);break;
+            }
