+    for (unsigned i = 0; i < chest_count; i++) {
+        uint64_t a = chest_actors[i]; unsigned bit = chest_scene_flag(a);
+        if (bit < 128) sst_world_protect_scene(&world, table * 128 + bit);
+        if (r16(a + 0x10) == 0x281) {
