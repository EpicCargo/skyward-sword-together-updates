diff --git a/runtime/hle/sst.c b/runtime/hle/sst.c
new file mode 100644
index 0000000..a1c7d78
--- /dev/null
+++ b/runtime/hle/sst.c
@@ -0,0 +1,11 @@
+// Stop peer networking before guest memory is wiped for an in-place reboot.
+#include "../hle.h"
+#include "../sst/sst_game.h"
+#include "../sst/sst_remote.h"
+#include "../sst/sst_animation.h"
+
+RT_ON_RESET(sst_reset) {
+    sst_game_reset();
+    sst_remote_reset();
+    sst_animation_reset();
+}
