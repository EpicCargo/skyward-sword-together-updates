+    // Keep optimized small objects reusable, but distinguish the large-unit fallback below.
+    if (u->fallback) h = fnv(h, "-O0:budget", sizeof "-O0:budget");
+    else if (u->bytes > 500 * 1024) h = fnv(h, "-O0", sizeof "-O0");
     snprintf(out, n, "%016llx", (unsigned long long)h);
     return true;
 }
 
-static bool unit_done(const Tools *t, const Unit *u) {
+static bool unit_done(const Tools *t, Unit *u) {
     struct stat st;
     char want[32], have[32] = "";
     if (stat(u->obj, &st) != 0 || st.st_size == 0 || !unit_stamp(t, u, want, sizeof want)) return false;
@@ -330,7 +350,15 @@ static bool unit_done(const Tools *t, const Unit *u) {
     size_t k = fread(have, 1, sizeof have - 1, f);
     fclose(f);
     have[k] = 0;
-    return !strcmp(want, have);
+    if (!strcmp(want, have)) return true;
+    // A timed-out optimization is a durable build choice. Reuse its successful
+    // -O0 object after a restart, but never confuse it with an optimized object.
+    if (!u->fallback && u->bytes <= 500 * 1024) {
+        u->fallback = true;
+        if (unit_stamp(t, u, want, sizeof want) && !strcmp(want, have)) return true;
+        u->fallback = false;
+    }
+    return false;
 }
 
 static void unit_mark(const Tools *t, const Unit *u) {
@@ -345,6 +373,9 @@ static PlatProc start_compile(const Tools *t, const Unit *u) {
     Args a = {0};
     compiler(&a, t);
     add_cflags(&a, t);
+    // Match tools/build_game.py: LLVM can spend many minutes optimizing a single large lifted
+    // function. Smaller chunks retain the normal flags; the final option wins for large ones.
+    if (u->fallback || u->bytes > 500 * 1024) add(&a, "-O0");
     char inc[1200];
     snprintf(inc, sizeof inc, "-I%s", t->inc);
     add(&a, inc);
@@ -358,6 +389,12 @@ static PlatProc start_compile(const Tools *t, const Unit *u) {
     return p;
 }
 
+static bool unit_optimizer_expired(const Unit *u, uint64_t elapsed_ns) {
+    // Some lifted functions below the size cutoff still take minutes in LLVM.
+    // Retry once without optimization; the actual code generation has no timeout.
+    return !u->fallback && u->bytes <= 500 * 1024 && elapsed_ns >= 30000000000ull;
+}
+
 // ------------------------------------------------------------------ the build
 bool gamebuild_run(const char *game_dir, const GameBuildOpts *o, char *why, size_t why_size) {
     uint64_t t0 = plat_now_ns();
@@ -424,7 +461,7 @@ bool gamebuild_run(const char *game_dir, const GameBuildOpts *o, char *why, size
     int queued[NMODULES] = {0};  // chunk files of each module put in units so far
     bool tables[NMODULES] = {false};
     int next = 0, jobs = o->jobs < 1 ? 1 : o->jobs > 64 ? 64 : o->jobs;
-    struct { PlatProc p; int unit; } run[64];
+    struct { PlatProc p; int unit; uint64_t started; } run[64];
     int nrun = 0;
     unsigned long long done_bytes = 0;
     int resumed = 0;  // units an earlier run compiled already
@@ -485,12 +522,23 @@ bool gamebuild_run(const char *game_dir, const GameBuildOpts *o, char *why, size
             PlatProc p = start_compile(&t, &units.u[next]);
             if (!p) { snprintf(why, why_size, "the compiler didn't start"); ok = false; break; }
             run[nrun].p = p, run[nrun].unit = next++;
+            run[nrun].started = plat_now_ns();
             nrun++;
         }
         for (int k = 0; k < nrun; k++) {
             int r = finished(run[k].p);
-            if (r < 0) continue;
             Unit *u = &units.u[run[k].unit];
+            if (r < 0) {
+                if (unit_optimizer_expired(u, plat_now_ns() - run[k].started)) {
+                    LOG("[gamebuild] optimizer budget exceeded for %s; retrying at -O0\n", u->src);
+                    stop(run[k].p);  // ends this compiler and all of its descendants
+                    u->fallback = true;
+                    run[k].p = start_compile(&t, u);
+                    run[k].started = plat_now_ns();
+                    if (!run[k].p) { snprintf(why, why_size, "the compiler retry didn't start"); ok = false; break; }
+                }
+                continue;
+            }
             if (r != 0) {
                 char last[300];
                 log_tail(u->log, last, sizeof last);
