+static bool grant_dungeon_chest(Cpu *c, uint64_t fm, unsigned index, uint16_t item,
+                                unsigned flag, ChestReceipt *receipt) {
+    LoadedDungeon d;
+    if (!loaded_dungeon(receipt, &d) || r32(ITEM_SET_FLAG) != 0xf81d0ff5u ||
+        r8(d.defs + flag * 2) != 0 || r8(d.defs + flag * 2 + 1) != (flag == 2 ? 0x10 : 0x70))
+        return false;
