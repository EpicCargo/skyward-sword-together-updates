+    // Calling its item-ID setter avoids granting an unrelated ItemMgr ownership bit or counter.
+    unsigned entry = r16(0x700139cbf4ull + item * 2);
+    if (entry > 0xa6 || r8(0x70013773e4ull + entry * 13 + 12) != 2 ||
+        r16(0x7001377c6cull + entry * 8 + 4) != flag || !backup(fm) || !prepare_receipt(c, receipt))
