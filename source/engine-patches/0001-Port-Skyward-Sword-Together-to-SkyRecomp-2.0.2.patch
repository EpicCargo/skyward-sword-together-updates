+static uint16_t chest_item(uint64_t a) {
+    if (r16(a + 0x10) == 0x281) return r16(a + 0x410);
+    if (r16(a + 0x10) == 0x1eb) return 28;
+    return r16(a + 0x10) == 0x8b ? (r32(a + 0xc) >> 8) & 255 : r16(a + 0x1990);
