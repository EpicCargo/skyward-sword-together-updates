+            r64(vt[i] + 0x10) != (i ? 0x7000b892f4ull : 0x7000b8b15cull) ||
+            r64(vt[i] + 0x18) != 0x7000b893fcull ||
+            r64(vt[i] + 0x20) != (i ? 0x7000b8b088ull : 0x7000b8b1bcull) ||
+            r64(vt[i] + 0x28) != 0x7000b8941cull || r64(vt[i] + 0x30) != 0x7000b8943cull)
+            return false;
+        before[i] = result_call(c, r64(vt[i] + 0x28), ob[i], 0) & 0xffff;
+        if (before[i] > (i ? 24u : 3u)) return false;
+    }
