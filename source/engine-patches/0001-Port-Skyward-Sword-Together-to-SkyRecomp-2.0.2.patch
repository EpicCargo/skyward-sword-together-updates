+        debug_enemy_hold=false;LOG("[sst-enemy] debug health resumed\n");
+    }
+    else if (n > 0 && !strcmp(cmd,"scene-history-reload") && ENV("LARECOMP_DEBUG_DATA")) {
+        // Exercise the real disk-load path without altering native save memory.
+        memset(&scene_history,0,sizeof scene_history);history_loaded=history_disabled=false;
+        history_announce_pending=true;history_retry_at=0;scene_primed=false;
+        memset(world.known[SST_WORLD_SCENE],0,SST_WORLD_BYTES);
