+    for (unsigned slot=0;slot<8;slot++) {
+        unsigned item=186+slot,entry=153+slot;
+        if (r8(f.defs+2*item)!=11 || r8(f.defs+2*item+1)!=(5+slot)*16 ||
+            r16(0x700139cbf4ull+2*item)!=entry ||
+            r8(0x70013773e4ull+entry*13+12)!=3 ||
+            r16(0x7001377c6cull+entry*8+4)!=item) return false;
+    }
+    *out=(SongState){f,(r16(f.raw+22)>>5)&255,(r16(fm+0x9f4+22)>>5)&255};
+    return true;
+}
+static void observe_songs(uint64_t fm) {
+    SongState s;if(song_state(fm,&s)) held_songs|=s.live|s.saved;
+}
+static void song_progress(Cpu *c,uint64_t fm,bool apply) {
+    SongState before;if(!song_state(fm,&before))return;
+    held_songs|=before.live|before.saved;
+    if(!apply || r32(ITEM_SET_FLAG)!=0xf81d0ff5u)return;
+    for(unsigned slot=0;slot<8;slot++) {
+        unsigned item=186+slot,bit=1u<<slot;
+        SongState s;if(!song_state(fm,&s))return;
+        if(!(held_songs&bit) && !sst_world_pending(&world,SST_WORLD_ITEM,item))continue;
+        bool repair=!(s.live&s.saved&bit);
+        if(repair) {
+            if(!backup(fm))return;
+            uint32_t pouch[SST_POUCH_SLOTS];uint16_t inventory[64];
+            memcpy(pouch,(void*)(uintptr_t)(fm+0x7d0),sizeof pouch);
+            memcpy(inventory,(void*)(uintptr_t)s.flags.raw,sizeof inventory);
+            unsigned health=r16(fm+0x5316),capacity=r16(fm+0x5312);
+            if(!(s.live&bit))call(c,ITEM_SET_FLAG,item,0,0);
+            SongState after;
+            if(r64(FILE_MGR)!=fm || !song_state(fm,&after) || !(after.live&bit) ||
+                memcmp(pouch,(void*)(uintptr_t)(fm+0x7d0),sizeof pouch) ||
+                r16(fm+0x5316)!=health || r16(fm+0x5312)!=capacity) {
+                notify("Song sync held: unexpected native inventory result",false);return;
+            }
+            for(unsigned w=0;w<64;w++)if((r16(after.flags.raw+2*w)^inventory[w])&~(w==11?bit<<5:0u)) {
+                notify("Song sync held: unrelated inventory changed",false);return;
+            }
+            w16(fm+0x9f4+22,r16(fm+0x9f4+22)|(bit<<5));
+            if(!song_state(fm,&after) || !(after.live&after.saved&bit))return;
+            LOG("[sst-song] item=%u live/saved ownership verified; other inventory preserved\n",item);
+        }
+        held_songs|=bit;
+        if(sst_world_learn(&world,SST_WORLD_ITEM,item))sst_net_send_flag(SST_WORLD_ITEM,item,1);
+        if(sst_world_pending(&world,SST_WORLD_ITEM,item)) {sst_world_applied(&world,SST_WORLD_ITEM,item);applied++;}
+    }
+}
+typedef struct {
+    Flags flags; uint64_t word[6], saved[6]; uint16_t mask[6];
+    unsigned live_bits, saved_bits;
+} SwordState;
+static bool sword_state(uint64_t fm, SwordState *out) {
+    if (!normal_inventory(fm)) return false;
+    Flags f = flags(ITEM_MGR,510,64);
+    uint64_t vt=f.mgr?r64(f.mgr):0;
+    if (!f.mgr || !ptr(vt,0x58) || r64(vt+0x38)!=0x7000b807acull ||
+        r64(vt+0x48)!=0x7000b808a0ull || r64(vt+0x50)!=0x7000b808a8ull) return false;
+    static const unsigned words[]={7,0,0,11,0,7}, shifts[]={8,8,9,4,10,7};
+    SwordState s={.flags=f};
+    for(unsigned i=0;i<6;i++) {
+        uint16_t item=sst_chest_sword_item(i+1);
+        if (!location(&f,item,&s.word[i],&s.mask[i]) || r8(f.defs+2*item)!=words[i] ||
+            r8(f.defs+2*item+1)!=shifts[i]*16) return false;
+        s.saved[i]=fm+0x9f4+words[i]*2;
+        if(r16(s.word[i])&s.mask[i]) s.live_bits|=1u<<i;
+        if(r16(s.saved[i])&s.mask[i]) s.saved_bits|=1u<<i;
+    }
+    *out=s; return true;
+}
+static void observe_sword(uint64_t fm) {
+    SwordState s; if(!sword_state(fm,&s)) return;
+    unsigned live=sst_chest_sword_best(s.live_bits), saved=sst_chest_sword_best(s.saved_bits);
+    if(saved>live && saved>held_sword_tier) {
+        held_sword_tier=saved;
+        LOG("[sst-sword] retained saved tier=%u until safe repair\n",saved);
+    }
+    if(live>=held_sword_tier && saved>=held_sword_tier) held_sword_tier=0;
+}
+static bool sword_ready(uint64_t fm, uint16_t item) {
+    SwordState s; if(!sword_state(fm,&s)) return false;
+    unsigned target=sst_chest_sword_target(s.live_bits,s.saved_bits,item);
+    if(target<held_sword_tier)target=held_sword_tier;
+    return target && sst_chest_sword_best(s.live_bits)>=target && sst_chest_sword_best(s.saved_bits)>=target;
+}
+static bool grant_sword(Cpu *c,uint64_t fm,unsigned index,uint16_t item) {
+    SwordState before,after;
+    if(!sst_chest_sword_tier(item) || !sword_state(fm,&before) || r32(ITEM_SET_FLAG)!=0xf81d0ff5u) return false;
+    unsigned target=sst_chest_sword_target(before.live_bits,before.saved_bits,item);
+    if(target<held_sword_tier)target=held_sword_tier;
+    uint16_t selected=sst_chest_sword_item(target);
+    unsigned entry=r16(0x700139cbf4ull+selected*2);
+    if(!selected || entry>0xa6 || r8(0x70013773e4ull+entry*13+12)!=3 ||
+        r16(0x7001377c6cull+entry*8+4)!=selected) return false;
+    ChestReceipt receipt; bool fresh=false;
+    if(index<SST_CHESTS) {
+        if(!chest_receipt(fm,index,&receipt))return false;
+        fresh=!receipt_opened(&receipt);
+    }
+    bool repair=sst_chest_sword_best(before.live_bits)<target || sst_chest_sword_best(before.saved_bits)<target;
+    if(!repair && !fresh)return true;
+    if(!backup(fm) || (fresh&&!prepare_receipt(c,&receipt)))return false;
+    uint32_t pouch[SST_POUCH_SLOTS]; uint16_t inventory[64], allowed[64]={0};
+    memcpy(pouch,(void*)(uintptr_t)(fm+0x7d0),sizeof pouch);
+    memcpy(inventory,(void*)(uintptr_t)before.flags.raw,sizeof inventory);
+    static const unsigned words[]={7,0,0,11,0,7};
+    for(unsigned i=0;i<6;i++)allowed[words[i]]|=before.mask[i];
+    unsigned health=r16(fm+0x5316), capacity=r16(fm+0x5312);
+    if(sst_chest_sword_best(before.live_bits)<target)call(c,ITEM_SET_FLAG,selected,0,0);
+    if(r64(FILE_MGR)!=fm || !sword_state(fm,&after) || sst_chest_sword_best(after.live_bits)<target ||
+        memcmp(pouch,(void*)(uintptr_t)(fm+0x7d0),sizeof pouch) || r16(fm+0x5316)!=health || r16(fm+0x5312)!=capacity)goto conflict;
+    for(unsigned i=0;i<64;i++)if((r16(after.flags.raw+i*2)^inventory[i])&~allowed[i])goto conflict;
+    w16(after.saved[target-1],r16(after.saved[target-1])|after.mask[target-1]);
+    if(!sword_ready(fm,selected))goto conflict;
+    if(fresh){mark_receipt(&receipt);applied++;}
+    observe_sword(fm);
+    if(repair)notify("Shared sword progression applied. Reload the area if equipment has not refreshed.",false);
+    LOG("[sst-sword] index=%u item=%u target=%u live=%u saved=%u; other inventory preserved\n",
+        index,item,target,sst_chest_sword_best(before.live_bits),sst_chest_sword_best(before.saved_bits));
+    return true;
+conflict:
+    if(index<SST_CHESTS)chests.conflict[index]=true;
+    notify("Sword reward held: unexpected native equipment result",false);return false;
+}
+// Native pouch setters choose between normal and temporary inventories. Deliver only
+// into the normal, unlocked Adventure Pouch, never Item Check or a temporary game mode.
+static bool pouch_inventory(uint64_t fm, Flags *out) {
+    Flags f = flags(ITEM_MGR, 510, 64);
+    uint64_t owned; uint16_t owned_mask;
+    if (!f.mgr || !normal_inventory(fm) || !location(&f, 112, &owned, &owned_mask) ||
+        r8(f.defs + 980) != 54 || r8(f.defs + 981) != 0xa2 ||
+        r32(POUCH_SET_ITEM) != 0xf81b0ff9u || !(r16(owned) & owned_mask) ||
+        ((r16(f.raw + 108) >> 10) & 7) > SST_POUCH_EXPANSIONS) return false;
+    *out = f; return true;
+}
+static unsigned pouch_slot(uint64_t fm) {
+    Flags f;
+    if (!pouch_inventory(fm, &f)) return SST_POUCH_SLOTS;
+    uint16_t items[SST_POUCH_SLOTS];
+    for (unsigned i = 0; i < SST_POUCH_SLOTS; i++) items[i] = r16(fm + 0x7d0 + 4 * i);
+    return sst_chest_pouch_slot(true, (r16(f.raw + 108) >> 10) & 7, items);
+}
+// Capacity is additive, unlike ownership. Count only completed personal receipts as repair
+// proof, and record the verified live/saved result before another frame can replay the reward.
+static unsigned pouch_expansion_proof(uint64_t fm) {
+    ShopCounter shop;
+    unsigned completed = shop_counter(fm, 707, &shop) ? shop.count : 0;
+    for (unsigned i = 0; i < SST_CONTAINER_CHESTS && completed < SST_POUCH_EXPANSIONS; i++) {
+        ChestReceipt proof;
+        if (chests.item[i] == 113 && !chests.conflict[i] && chest_receipt(fm, i, &proof) && receipt_opened(&proof)) completed++;
+    }
+    return completed;
+}
+static bool pouch_expansion_inventory_ready(uint64_t fm) {
+    Flags f; uint64_t own; uint16_t mask;
+    if (!pouch_inventory(fm, &f) || !location(&f, 113, &own, &mask) ||
+        !(r16(own) & mask) || !(r16(fm + 0x9f4 + 10) & mask)) return false;
+    unsigned live = (r16(f.raw + 108) >> 10) & 7, saved = (r16(fm + 0x9f4 + 108) >> 10) & 7;
+    unsigned target = sst_chest_pouch_expansion_target(live, saved, pouch_expansion_proof(fm), false);
+    return target <= SST_POUCH_EXPANSIONS && target == live && target == saved;
+}
+static bool grant_pouch_expansion(Cpu *c, uint64_t fm, unsigned index) {
+    Flags f; uint64_t own; uint16_t mask;
+    uint64_t ob = POUCH_CAPACITY_COUNTER, vt = r64(ob);
+    if (!pouch_inventory(fm, &f) || !location(&f, 113, &own, &mask) ||
+        r8(f.defs + 226) != 5 || r8(f.defs + 227) != 0x70 ||
+        r16(0x700139cbf4ull + 113 * 2) != 91 ||
+        r8(0x70013773e4ull + 91 * 13 + 12) != 3 ||
+        r16(0x7001377c6cull + 91 * 8 + 4) != 113 ||
+        r32(ITEM_SET_FLAG) != 0xf81d0ff5u || !ptr(vt, 0x38) || r16(ob + 8) != 490 ||
+        r64(vt + 0x10) != 0x7000b892f4ull || r64(vt + 0x18) != 0x7000b893fcull ||
+        r64(vt + 0x20) != 0x7000b8b290ull || r64(vt + 0x28) != 0x7000b8941cull ||
+        r64(vt + 0x30) != 0x7000b8943cull || result_call(c, r64(vt + 0x20), ob, 0) != 7) return false;
+    ChestReceipt receipt = {0}; unsigned shop_flag, ordinal;
+    bool shop = sst_chest_shop_counter(index, &shop_flag, &ordinal);
+    ShopCounter purchase;
+    if (shop ? shop_flag != 707 || !shop_counter(fm, shop_flag, &purchase) : !chest_receipt(fm, index, &receipt)) return false;
+    bool incoming = shop ? purchase.count < ordinal : !receipt_opened(&receipt);
+    if (shop && incoming && purchase.count + 1 != ordinal) return false;
+    unsigned completed = pouch_expansion_proof(fm);
+    unsigned before = (r16(f.raw + 108) >> 10) & 7;
+    unsigned saved = (r16(fm + 0x9f4 + 108) >> 10) & 7;
+    // Each shop ordinal is a unique canonical upgrade. Intact capacity can already include
+    // that purchase when both receipt copies were lost; restore its proof floor, not another slot.
+    unsigned target = sst_chest_pouch_expansion_target(before, saved,
+        completed + (shop && incoming ? 1 : 0), incoming && !shop);
+    if (target > SST_POUCH_EXPANSIONS || result_call(c, r64(vt + 0x28), ob, 0) != before) return false;
+    bool owned = (r16(own) & mask) != 0, saved_owned = (r16(fm + 0x9f4 + 10) & mask) != 0;
+    if (!incoming && target == before && target == saved && owned && saved_owned) return true;
+    if (!backup(fm) || (!shop && !prepare_receipt(c, &receipt))) return false;
+    uint32_t pouch[SST_POUCH_SLOTS];
+    memcpy(pouch, (void *)(uintptr_t)(fm + 0x7d0), sizeof pouch);
+    call(c, ITEM_SET_FLAG, 113, 0, 0);
+    if (target > before) call(c, r64(vt + 0x10), ob, target - before, 0);
+    f = flags(ITEM_MGR, 510, 64);
+    if (r64(FILE_MGR) != fm || !f.mgr || !location(&f, 113, &own, &mask) || !(r16(own) & mask) ||
+        ((r16(f.raw + 108) >> 10) & 7) != target || result_call(c, r64(vt + 0x28), ob, 0) != target ||
+        memcmp(pouch, (void *)(uintptr_t)(fm + 0x7d0), sizeof pouch)) {
+        chests.conflict[index] = true;
+        notify("Pouch capacity reward held: unexpected native inventory result", false); return false;
+    }
+    // Preserve other flags in both words. Native readers can still see the previous frame's
+    // capacity; pouch insertions safely retry an unchanged native refusal until it commits.
+    w16(fm + 0x9f4 + 108, (r16(fm + 0x9f4 + 108) & ~(7u << 10)) | (target << 10));
+    w16(fm + 0x9f4 + 10, r16(fm + 0x9f4 + 10) | mask);
+    if (!shop) { mark_receipt(&receipt); applied++; }
+    LOG("[sst-pouch] capacity index=%u live=%u saved=%u proof=%u incoming=%u -> %u; contents preserved\n",
+        index, before, saved, completed, incoming, target);
+    return true;
+}
+static bool extra_wallet_ready(uint64_t fm, unsigned proof) {
+    Flags f = flags(ITEM_MGR, 510, 64);
+    if (!f.mgr || r8(f.defs + 1016) != 63 || r8(f.defs + 1017) != 0xe1) return false;
+    unsigned live = (r16(f.raw + 126) >> 14) & 3, saved = (r16(fm + 0x9f4 + 126) >> 14) & 3;
+    return live == saved && live >= proof;
+}
+static bool grant_extra_wallet(Cpu *c, uint64_t fm, unsigned index, unsigned proof, bool incoming) {
+    Flags f = flags(ITEM_MGR, 510, 64); WalletState before, after;
+    uint64_t ob = EXTRA_WALLET_COUNTER, vt = r64(ob);
+    if (!normal_inventory(fm) || !wallet_state(c, &before) || !f.mgr || !ptr(vt, 0x38) ||
+        r16(ob + 8) != 508 || r64(vt + 0x10) != 0x7000b892f4ull ||
+        r64(vt + 0x20) != 0x7000b8b860ull || r64(vt + 0x28) != 0x7000b8941cull ||
+        result_call(c, r64(vt + 0x20), ob, 0) != 3) return false;
+    unsigned saved = (r16(fm + 0x9f4 + 126) >> 14) & 3;
+    unsigned target = before.extras > saved ? before.extras : saved;
+    unsigned proven = proof + (incoming ? 1 : 0);
+    if (target < proven) target = proven;
+    if (!incoming && target == before.extras && target == saved) return true;
+    if (!backup(fm)) return false;
+    uint32_t pouch[SST_POUCH_SLOTS]; memcpy(pouch, (void *)(uintptr_t)(fm + 0x7d0), sizeof pouch);
+    if (target > before.extras) call(c, r64(vt + 0x10), ob, target - before.extras, 0);
+    if (r64(FILE_MGR) != fm || !wallet_state(c, &after) || after.extras != target ||
+        after.rupees != before.rupees || after.owned != before.owned ||
+        memcmp(pouch, (void *)(uintptr_t)(fm + 0x7d0), sizeof pouch)) {
+        chests.conflict[index] = true; notify("Extra wallet held: unexpected native inventory result", false); return false;
+    }
+    w16(fm + 0x9f4 + 126, (r16(fm + 0x9f4 + 126) & 0x3fff) | (target << 14));
+    LOG("[sst-wallet] extra index=%u live=%u saved=%u proof=%u incoming=%u -> %u; rupees=%u preserved\n",
+        index, before.extras, saved, proof, incoming, target, after.rupees);
+    return true;
+}
+static bool shop_purchase_ready(uint64_t fm, unsigned index) {
+    unsigned flag, ordinal; ShopCounter s;
+    if (!sst_chest_shop_counter(index, &flag, &ordinal) || !shop_counter(fm, flag, &s) ||
+        s.count < ordinal || s.live != s.count || s.stored != s.count) return false;
+    return flag == 707 ? pouch_expansion_inventory_ready(fm) : extra_wallet_ready(fm, s.count);
+}
+static bool grant_shop_purchase(Cpu *c, uint64_t fm, unsigned index) {
+    unsigned flag, ordinal; ShopCounter s;
+    if (!sst_chest_shop_counter(index, &flag, &ordinal) || !shop_counter(fm, flag, &s)) return false;
+    bool incoming = s.count < ordinal;
+    if ((incoming && s.count + 1 != ordinal) ||
+        (!strcmp(loaded_scene.stage, "F002r") && (incoming || s.live < s.count))) return false;
+    if (!(flag == 707 ? grant_pouch_expansion(c, fm, index) : grant_extra_wallet(c, fm, index, s.count, incoming))) return false;
+    unsigned target = incoming ? ordinal : s.count;
+    if (!repair_shop_counter(c, fm, flag, target)) {
+        chests.conflict[index] = true; notify("Shop purchase held: unexpected native completion result", false); return false;
+    }
+    if (incoming) applied++;
+    return true;
+}
+typedef struct { Flags items; uint64_t word, saved, setter; uint16_t mask, item; } FirstPouchReceipt;
+static bool first_pouch_receipt(uint64_t fm, uint16_t item, FirstPouchReceipt *out) {
+    if ((!sst_chest_shield_durability(item) && !sst_chest_ammo_quantity(item)) || !normal_inventory(fm)) return false;
+    Flags f = flags(ITEM_MGR, 510, 64); uint64_t word; uint16_t mask;
+    uint64_t vt = f.mgr ? r64(f.mgr) : 0;
+    unsigned bit = item - 106;
+    if (!f.mgr || !location(&f, item, &word, &mask) ||
+        r8(f.defs + item * 2) != 5 + bit / 16 || r8(f.defs + item * 2 + 1) != (bit % 16) * 16 ||
+        !ptr(vt, 0x58) || r64(vt + 0x38) != 0x7000b807acull ||
+        r64(vt + 0x48) != 0x7000b808a0ull || r64(vt + 0x50) != 0x7000b808a8ull) return false;
+    *out = (FirstPouchReceipt){f, word, fm + 0x9f4 + 2 * (5 + bit / 16), r64(vt + 0x38), mask, item};
+    return true;
+}
+static bool pouch_shop_active(void) { return !strcmp(loaded_scene.stage, "F004r"); }
+static bool first_pouch_opened(uint64_t fm, const FirstPouchReceipt *r) {
+    bool live = (r16(r->word) & r->mask) != 0, saved = (r16(r->saved) & r->mask) != 0;
+    bool carried = false;
+    for (unsigned i = 0; i < SST_POUCH_SLOTS; i++) {
+        uint32_t slot = r32(fm + 0x7d0 + i * 4);
+        carried |= sst_chest_first_pouch_word(r->item, slot);
+    }
+    uint32_t bit = 1u << (r->item - 116);
+    bool proof = live || saved || carried || (deferred_pouch_flags & bit);
+    if (pouch_shop_active() && proof && !(live && saved) && !(deferred_pouch_flags & bit)) {
+        deferred_pouch_flags |= bit;
+        LOG("[sst-%s] retained completion proof item=%u until Bazaar exit\n", sst_chest_ammo_quantity(r->item) ? "ammo" : "shield", r->item);
+    }
+    if (live && saved) deferred_pouch_flags &= ~bit;
+    return proof;
+}
+static bool repair_first_pouch(Cpu *c, uint64_t fm, uint16_t item) {
+    FirstPouchReceipt r;
+    if (!first_pouch_receipt(fm, item, &r)) return false;
+    if ((r16(r.word) & r.mask) && (r16(r.saved) & r.mask)) return true;
+    if (pouch_shop_active()) { deferred_pouch_flags |= 1u << (item - 116); return false; }
+    if (!backup(fm)) return false;
+    uint32_t pouch[SST_POUCH_SLOTS]; memcpy(pouch, (void *)(uintptr_t)(fm + 0x7d0), sizeof pouch);
+    if (!(r16(r.word) & r.mask)) call(c, r.setter, r.items.mgr, item | 0x4000, 0);
+    if (r64(FILE_MGR) != fm || !first_pouch_receipt(fm, item, &r) || !(r16(r.word) & r.mask) ||
+        memcmp(pouch, (void *)(uintptr_t)(fm + 0x7d0), sizeof pouch)) return false;
+    w16(r.saved, r16(r.saved) | r.mask);
+    LOG("[sst-%s] repaired acquired flag item=%u; pouch quantities preserved\n", sst_chest_ammo_quantity(item) ? "ammo" : "shield", item);
+    return true;
+}
+static bool insert_pouch(Cpu *c, uint64_t fm, unsigned index, uint16_t item) {
+    unsigned quantity = sst_chest_pouch_quantity(item);
+    if (!quantity) return false;
+    unsigned entry = r16(0x700139cbf4ull + item * 2);
+    unsigned cls = item == 125 ? 3 : 0;
+    if (entry > 0xa6 || r8(0x70013773e4ull + entry * 13 + 12) != cls ||
+        r16(0x7001377c6cull + entry * 8 + 4) != item ||
+        (item >= 128 && item <= 136 && r32(0x700139fed8ull + (item - 128) * 4) != quantity)) return false;
+    if (sst_chest_shield_durability(item) || sst_chest_ammo_quantity(item)) {
+        FirstPouchReceipt r;
+        if (pouch_shop_active() || !first_pouch_receipt(fm, item, &r) ||
+            (sst_chest_shield_durability(item) && r8(0x700135a16full + item - 116) != quantity)) return false;
+    }
+    unsigned slot = pouch_slot(fm);
+    if (slot == SST_POUCH_SLOTS || !backup(fm)) return false;
+    uint32_t before[SST_POUCH_SLOTS];
+    memcpy(before, (void *)(uintptr_t)(fm + 0x7d0), sizeof before);
+    Cpu saved = *c;
+    c->x[0] = slot; c->x[1] = item; c->x[2] = UINT32_MAX; c->x[3] = 0;
+    guest_call(c, POUCH_SET_ITEM);
+    unsigned result = (uint32_t)c->x[0]; *c = saved;
+    uint32_t after[SST_POUCH_SLOTS];
+    memcpy(after, (void *)(uintptr_t)(fm + 0x7d0), sizeof after);
+    SstPouchResult checked = sst_chest_pouch_result(slot, item, result, before, after);
+    if (r64(FILE_MGR) != fm || checked == SST_POUCH_CONFLICT) {
+        chests.conflict[index] = true;
+        notify("Pouch reward held: unexpected native inventory result", false); return false;
+    }
+    if (checked == SST_POUCH_WAIT) return false; // native refusal changed nothing; retry in normal gameplay
+    if ((sst_chest_shield_durability(item) || sst_chest_ammo_quantity(item)) && !repair_first_pouch(c, fm, item)) {
+        chests.conflict[index] = true;
+        notify("Pouch reward held: unexpected native completion result", false); return false;
+    }
+    LOG("[sst-pouch] inserted index=%u item=%u quantity=%u slot=%u; other slots preserved\n", index, item, quantity, slot);
+    return true;
+}
+typedef struct { Flags items; uint64_t word, saved, setter; uint16_t mask; } ShopItemReceipt;
+static bool shop_item_receipt(uint64_t fm, ShopItemReceipt *out) {
+    Flags f = flags(ITEM_MGR, 510, 64); uint64_t word; uint16_t mask;
+    uint64_t vt = f.mgr ? r64(f.mgr) : 0;
+    if (!f.mgr || !location(&f, 70, &word, &mask) || r8(f.defs + 140) != 12 || r8(f.defs + 141) != 0 ||
+        !ptr(vt, 0x70) || r64(vt + 0x38) != 0x7000b807acull ||
+        r64(vt + 0x50) != 0x7000b808a8ull || r64(vt + 0x48) != 0x7000b808a0ull) return false;
+    *out = (ShopItemReceipt){f, word, fm + 0x9f4 + 24, r64(vt + 0x38), mask}; return true;
+}
+static bool shop_item_opened(uint64_t fm, const ShopItemReceipt *r) {
+    bool live = (r16(r->word) & r->mask) != 0, saved = (r16(r->saved) & r->mask) != 0;
+    bool carried = false;
+    if (normal_inventory(fm)) for (unsigned i = 0; i < SST_POUCH_SLOTS; i++)
+        carried |= r32(fm + 0x7d0 + i * 4) == 0x00010046u;
+    bool proof = live || saved || carried || (deferred_shop_flags & 4);
+    if (!strcmp(loaded_scene.stage, "F002r") && proof && !(live && saved) && !(deferred_shop_flags & 4)) {
+        deferred_shop_flags |= 4;
+        LOG("[sst-shop] retained Bug Medal completion proof until shop exit\n");
+    }
+    if (live && saved) deferred_shop_flags &= ~4u;
+    return proof;
+}
+static bool repair_shop_item(Cpu *c, uint64_t fm) {
+    ShopItemReceipt r;
+    if (!shop_item_receipt(fm, &r) || !normal_inventory(fm)) return false;
+    if ((r16(r.word) & r.mask) && (r16(r.saved) & r.mask)) return true;
+    if (!strcmp(loaded_scene.stage, "F002r")) { deferred_shop_flags |= 4; return false; }
+    if (!backup(fm)) return false;
+    uint32_t pouch[SST_POUCH_SLOTS]; memcpy(pouch, (void *)(uintptr_t)(fm + 0x7d0), sizeof pouch);
+    if (!(r16(r.word) & r.mask)) call(c, r.setter, r.items.mgr, 70 | 0x4000, 0);
+    if (r64(FILE_MGR) != fm || !shop_item_receipt(fm, &r) || !(r16(r.word) & r.mask) ||
+        memcmp(pouch, (void *)(uintptr_t)(fm + 0x7d0), sizeof pouch)) return false;
+    w16(r.saved, r16(r.saved) | r.mask);
+    LOG("[sst-shop] Bug Medal acquired flag repaired; no inventory grant\n"); return true;
+}
+static bool grant_shop_item(Cpu *c, uint64_t fm) {
+    ShopItemReceipt r;
+    if (!shop_item_receipt(fm, &r) || !normal_inventory(fm)) return false;
+    if (shop_item_opened(fm, &r)) return repair_shop_item(c, fm);
+    if (!strcmp(loaded_scene.stage, "F002r") || !insert_pouch(c, fm, SST_BUG_MEDAL_CHEST, 70)) return false;
+    if (!repair_shop_item(c, fm)) {
+        chests.conflict[SST_BUG_MEDAL_CHEST] = true;
+        notify("Bug Medal held: unexpected native completion result", false); return false;
+    }
+    applied++; return true;
+}
+static bool grant_pouch_chest(Cpu *c, uint64_t fm, unsigned index, uint16_t item, ChestReceipt *receipt) {
+    if (item == 70) {
+        ShopItemReceipt unique;
+        if (!shop_item_receipt(fm, &unique)) return false;
+        if (shop_item_opened(fm, &unique)) {
+            if (!repair_shop_item(c, fm) || !backup(fm) || !prepare_receipt(c, receipt)) return false;
+            mark_receipt(receipt); applied++; return true;
+        }
+        if (!strcmp(loaded_scene.stage, "F002r")) return false;
+    }
+    if (pouch_slot(fm) == SST_POUCH_SLOTS || !backup(fm) || !prepare_receipt(c, receipt) ||
+        !insert_pouch(c, fm, index, item)) return false;
+    if (item == 70 && !repair_shop_item(c, fm)) {
+        chests.conflict[index] = true; notify("Bug Medal held: unexpected native completion result", false); return false;
+    }
+    mark_receipt(receipt); applied++;
+    LOG("[sst-chest] granted index=%u item=%u native pouch item\n", index, item);
+    return true;
+}
+typedef struct { Flags story; uint64_t word, saved, setter; uint16_t mask; unsigned flag; } QuestReceipt;
+static bool quest_receipt(uint64_t fm, unsigned index, QuestReceipt *out) {
+    unsigned flag = sst_chest_quest_flag(index);
+    if (!flag) flag = sst_chest_trial_flag(index);
+    if (!flag && (sst_chest_pouch_gift_item(index) || sst_chest_wallet_gift_item(index) || sst_chest_shop_item(index))) flag = index - SST_CONTAINER_CHESTS;
+    Flags f = flags(STORY_MGR, 1202, 128); uint64_t word; uint16_t mask;
+    if (!flag || !f.mgr || !location(&f, flag, &word, &mask)) return false;
+    uint64_t vt = r64(f.mgr), setter = ptr(vt, 0x40) ? r64(vt + 0x38) : 0;
+    if (!code(setter)) return false;
+    *out = (QuestReceipt){f, word, fm + 0x8f4 + r8(f.defs + flag * 2) * 2, setter, mask, flag};
+    return true;
+}
+static bool quest_opened(const QuestReceipt *r) {
+    bool live = (r16(r->word) & r->mask) != 0, saved = (r16(r->saved) & r->mask) != 0;
+    unsigned bit = r->flag == 813 ? 1 : r->flag == 814 ? 2 : 0;
+    if (bit && !strcmp(loaded_scene.stage, "F002r") && saved && !live && !(deferred_shop_flags & bit)) {
+        deferred_shop_flags |= bit;
+        LOG("[sst-shop] retained saved purchase proof flag=%u until shop exit\n", r->flag);
+    }
+    bool completed = live || saved || (deferred_shop_flags & bit);
+    if (live && saved) deferred_shop_flags &= ~bit;
+    return completed;
+}
+static bool parrow_needs_bottle(uint64_t fm) {
+    Flags story = flags(STORY_MGR, 1202, 128); uint64_t word; uint16_t mask;
+    if (!story.mgr || !location(&story, 382, &word, &mask)) return true;
+    uint64_t saved = fm + 0x8f4 + r8(story.defs + 764) * 2;
+    return !((r16(word) | r16(saved)) & mask);
+}
+// Preserve a locally chosen quest ending. An incoming reward from the other
+// ending satisfies the same crystal pack without setting both branch receipts.
+static bool quest_completed(uint64_t fm, unsigned index, QuestReceipt *out) {
+    QuestReceipt receipt;
+    if (!quest_receipt(fm, index, &receipt)) return false;
+    if (quest_opened(&receipt)) { *out = receipt; return true; }
+    unsigned alternative = sst_chest_quest_alternative(receipt.flag);
+    if (alternative && quest_receipt(fm, SST_CONTAINER_CHESTS + alternative, &receipt) && quest_opened(&receipt)) {
+        *out = receipt; return true;
+    }
+    return false;
+}
+static bool repair_quest_receipt(Cpu *c, uint64_t fm, const QuestReceipt *r) {
+    // A durable receipt on either side proves delivery. Repair its live/saved flags only;
+    // restoring a completion bit must never grant its crystals or rupees again.
+    for (unsigned i = 0; i <= SST_QUEST_AUX; i++) {
+        unsigned id = i ? sst_chest_quest_aux(r->flag, i - 1) : r->flag;
+        if (!id) break;
+        Flags f = flags(STORY_MGR, 1202, 128);
+        uint64_t word; uint16_t mask;
+        if (!f.mgr || !location(&f, id, &word, &mask)) return false;
+        uint64_t saved = fm + 0x8f4 + r8(f.defs + id * 2) * 2;
+        if ((r16(word) & mask) && (r16(saved) & mask)) continue;
+        if (!backup(fm)) return false;
+        call(c, r->setter, f.mgr, id, 0);
+        f = flags(STORY_MGR, 1202, 128);
+        if (!f.mgr || !location(&f, id, &word, &mask) || !(r16(word) & mask)) return false;
+        w16(saved, r16(saved) | mask);
+        LOG("[sst-quest] repaired flag=%u for completed receipt=%u; no inventory grant\n", id, r->flag);
+    }
+    return true;
+}
+static bool grant_pouch_gift(Cpu *c, uint64_t fm, unsigned index) {
+    QuestReceipt receipt; uint16_t item = sst_chest_pouch_gift_item(index);
+    if (!item || !quest_receipt(fm, index, &receipt)) return false;
+    if (quest_opened(&receipt)) return repair_quest_receipt(c, fm, &receipt);
+    if (pouch_slot(fm) == SST_POUCH_SLOTS || !backup(fm) || !insert_pouch(c, fm, index, item)) return false;
+    // Once inventory has changed, never retry an unproven completion write.
+    if (!repair_quest_receipt(c, fm, &receipt)) {
+        chests.conflict[index] = true;
+        notify("Pouch gift held: unexpected native completion result", false); return false;
+    }
+    applied++;
+    LOG("[sst-pouch] granted NPC gift flag=%u item=%u; personal receipt verified\n", receipt.flag, item);
+    return true;
+}
+static bool grant_wallet_gift(Cpu *c, uint64_t fm, unsigned index) {
+    uint16_t item = sst_chest_wallet_gift_item(index); QuestReceipt receipt;
+    if (!item || !quest_receipt(fm, index, &receipt) || !backup(fm)) return false;
+    bool completed = quest_opened(&receipt);
+    if ((!completed || !wallet_inventory_ready(item)) && !grant_gear(c, fm, SST_CHESTS, item)) return false;
+    if (!repair_quest_receipt(c, fm, &receipt)) {
+        chests.conflict[index] = true;
+        notify("Wallet reward held: unexpected native completion result", false); return false;
+    }
+    if (!completed) { applied++; LOG("[sst-wallet] granted final NPC wallet with story=%u\n", receipt.flag); }
+    return true;
+}
+static unsigned quest_target(uint64_t fm, unsigned index, bool *ambiguous) {
+    if (ambiguous) *ambiguous = false;
+    unsigned flag = sst_chest_quest_flag(index);
+    if (!sst_chest_quest_letter(flag)) return index;
+    Flags story = flags(STORY_MGR, 1202, 128);
+    uint64_t word[2]; uint16_t mask[2]; bool chosen[2];
+    const unsigned ids[2] = {552, 555}; // actual paper hand-over, never written by sync
+    for (unsigned i = 0; i < 2; i++) {
+        if (!story.mgr || !location(&story, ids[i], &word[i], &mask[i])) return SST_CHESTS;
+        uint64_t saved = fm + 0x8f4 + r8(story.defs + ids[i] * 2) * 2;
+        chosen[i] = ((r16(word[i]) | r16(saved)) & mask[i]) != 0;
+    }
+    if (ambiguous) *ambiguous = chosen[0] && chosen[1];
+    unsigned target = sst_chest_quest_target(flag, chosen[0], chosen[1]);
+    return target ? SST_CONTAINER_CHESTS + target : SST_CHESTS;
+}
+static bool trial_inventory_ready(unsigned index) {
+    uint16_t item = sst_chest_trial_item(index);
+    Flags f = flags(ITEM_MGR, 510, 64);
+    if (!item || !f.mgr || !tool_owned(f, item)) return false;
+    if (!sst_chest_tool(item)) return true;
+    Flags story = flags(STORY_MGR, 1202, 128);
+    return story.mgr && tool_owned(story, 58) && tool_prerequisites_ready(f, item);
+}
+static bool grant_trial(Cpu *c, uint64_t fm, unsigned index) {
+    uint16_t item = sst_chest_trial_item(index);
+    QuestReceipt receipt;
+    if (!item || !quest_receipt(fm, index, &receipt) || !backup(fm)) return false;
+    bool completed = quest_opened(&receipt);
+    // Gear/tool setters validate the native item class and ownership before completion can
+    // close the trial. They use no container receipt and do not fill these items' ammunition.
+    if (!trial_inventory_ready(index) && !(sst_chest_tool(item) ?
+        grant_tool(c, fm, SST_CHESTS, item) : grant_gear(c, fm, SST_CHESTS, item))) return false;
+    if (!completed) call(c, receipt.setter, receipt.story.mgr, receipt.flag, 0);
+    QuestReceipt done;
+    if (!quest_receipt(fm, index, &done) || !quest_opened(&done) || !trial_inventory_ready(index) ||
+        !repair_quest_receipt(c, fm, &done)) return false;
+    if (!completed) {
+        applied++;
+        LOG("[sst-trial] granted flag=%u item=%u; completion and personal reward verified\n", done.flag, item);
+    }
+    return true;
+}
+static bool grant_quest(Cpu *c, uint64_t fm, unsigned index) {
+    QuestReceipt receipt;
+    if (!quest_receipt(fm, index, &receipt)) return false;
+    QuestReceipt completed;
+    if (quest_completed(fm, index, &completed)) return repair_quest_receipt(c, fm, &completed);
+    unsigned target = quest_target(fm, index, NULL);
+    if (target >= SST_CHESTS || !quest_receipt(fm, target, &receipt)) return false;
+    bool bottle = receipt.flag == 384 && parrow_needs_bottle(fm);
+    if (bottle && pouch_slot(fm) == SST_POUCH_SLOTS) return false;
+    // Validate every completion definition before mutating inventory.
+    for (unsigned i = 0; i < SST_QUEST_AUX; i++) {
+        unsigned aux = sst_chest_quest_aux(receipt.flag, i);
+        uint64_t word; uint16_t mask;
+        if (!aux) break;
+        if (!location(&receipt.story, aux, &word, &mask)) return false;
+    }
+    Flags f = flags(ITEM_MGR, 510, 64); uint64_t own; uint16_t own_mask;
+    if (!f.mgr || !location(&f, 35, &own, &own_mask) ||
+        r8(f.defs + 1004) != 54 || r8(f.defs + 1005) != 0x36) return false;
+    uint64_t ivt = r64(f.mgr), item_setter = ptr(ivt, 0x40) ? r64(ivt + 0x38) : 0;
+    if (!code(item_setter)) return false;
+    // Mallara's first cleaning reward includes a red rupee after the five crystals.
+    unsigned counters = receipt.flag == 575 ? 2 : 1;
+    if (counters == 2 && !wallet_capacity_ready(c)) return false;
+    uint64_t rupee_own; uint16_t rupee_mask;
+    if (counters == 2 && !location(&f, 4, &rupee_own, &rupee_mask)) return false;
+    uint64_t ob[2], vt[2]; unsigned before[2], cap[2];
+    for (unsigned i = 0; i < counters; i++) {
+        ob[i] = r64(COUNTERS + (i ? 0 : 38) * 8); vt[i] = ptr(ob[i], 16) ? r64(ob[i]) : 0;
+        if (!ptr(vt[i], 0x38) || r16(ob[i] + 8) != (i ? 501 : 502) ||
+            r64(vt[i] + 0x10) != 0x7000b892f4ull || r64(vt[i] + 0x18) != 0x7000b893fcull ||
+            r64(vt[i] + 0x20) != (i ? 0x7000b8b50cull : 0x7000b89884ull) ||
+            r64(vt[i] + 0x28) != 0x7000b8941cull || r64(vt[i] + 0x30) != 0x7000b8943cull) return false;
+        before[i] = result_call(c, r64(vt[i] + 0x28), ob[i], 0) & 0xffff;
+        cap[i] = result_call(c, r64(vt[i] + 0x20), ob[i], 0) & 0xffff;
+        if (!cap[i] || cap[i] > 16383 || before[i] > cap[i] || (!i && cap[i] != 127)) return false;
+    }
+    if (!backup(fm)) return false;
+    if (bottle) {
+        if (!insert_pouch(c, fm, index, 153)) return false;
+        // Record personal bottle delivery before the crystal part. A retained loan flag
+        // prevents a second bottle if completion later needs repair.
+        QuestReceipt loan = receipt; loan.flag = 382;
+        if (!repair_quest_receipt(c, fm, &loan)) {
+            chests.conflict[index] = true;
+            notify("Parrow reward held: unexpected bottle receipt result", false); return false;
+        }
+    }
+    call(c, item_setter, f.mgr, 35, 0);
+    if (counters == 2) call(c, item_setter, f.mgr, 4, 0);
+    for (unsigned i = 0; i < counters; i++) call(c, r64(vt[i] + 0x10), ob[i], i ? 20 : 5, 0);
+    for (unsigned i = 0; i < counters; i++) {
+        unsigned expected = before[i] + (i ? 20 : 5);
+        if (expected > cap[i]) expected = cap[i];
+        if (result_call(c, r64(vt[i] + 0x28), ob[i], 0) != expected) {
+            chests.conflict[index] = true; notify("Quest reward held: unexpected native inventory result", false); return false;
+        }
+    }
+    call(c, receipt.setter, receipt.story.mgr, receipt.flag, 0);
+    QuestReceipt done;
+    if (!quest_receipt(fm, target, &done) || !(r16(done.word) & done.mask)) {
+        chests.conflict[index] = true; notify("Quest reward held: unexpected native completion result", false); return false;
+    }
+    if (!repair_quest_receipt(c, fm, &done)) return false;
+    applied++;
+    LOG("[sst-quest] granted flag=%u crystals=%u->%u rupees=%u->%u\n", receipt.flag,
+        before[0], before[0] + 5 < cap[0] ? before[0] + 5 : cap[0],
+        counters == 2 ? before[1] : 0, counters == 2 ? (before[1] + 20 < cap[1] ? before[1] + 20 : cap[1]) : 0);
+    return true;
+}
+// Counter::checkedAdd handles the wallet/material/key cap, dirty state and rupee statistics.
+// Keep this synchronous with the receipt: no deferred pickup can be saved between grant/receipt.
+static bool grant_chest(Cpu *c, uint64_t fm, unsigned index, uint16_t item) {
+    unsigned counter; int amount;
+    ChestReceipt receipt;
+    if (!chest_receipt(fm, index, &receipt)) return false;
+    unsigned flag;
+    if (sst_chest_dungeon(item, receipt.table, &flag))
+        return grant_dungeon_chest(c, fm, index, item, flag, &receipt);
+    if (sst_chest_sword_tier(item)) return grant_sword(c,fm,index,item);
+    if (sst_chest_tool(item)) return grant_tool(c, fm, index, item);
+    if (sst_chest_gear(item) || sst_chest_wallet(item)) return grant_gear(c, fm, index, item);
+    if (sst_chest_pouch_expansion(item)) return grant_pouch_expansion(c, fm, index);
+    if (sst_chest_pouch_quantity(item)) return grant_pouch_chest(c, fm, index, item, &receipt);
+    if (!sst_chest_item(item, &counter, &amount)) return false;
+    unsigned quantity = sst_chest_reward_quantity(index, item);
+    if (counter == 0 && !wallet_capacity_ready(c)) return false;
+    unsigned table = receipt.table;
+    bool key = item == 1, heart = item == 94, piece = item == 28, crystal = item == 48;
+    uint64_t heart_ob[2], heart_vt[2]; unsigned heart_before[2];
+    if (heart && !heart_counters(c, fm, heart_ob, heart_vt, heart_before)) return false;
+    uint64_t dm = 0, key_raw = 0;
+    if (key) {
+        // SmallKeyCounter targets the currently loaded dungeon. Keep rewards pending until BOTH
+        // managers identify their source table; never temporarily retarget a live flag manager.
+        LoadedDungeon d;
+        if (!sst_chest_key_table(table) || !loaded_dungeon(&receipt, &d) ||
+            r8(d.defs + 30) != 1 || r8(d.defs + 31) != 3) return false;
+        dm = d.mgr; key_raw = d.raw;
+    }
+    uint64_t ob = r64(COUNTERS + counter * 8), vt = ptr(ob, 16) ? r64(ob) : 0;
+    if (!ptr(vt, 0x38) || r64(vt + 0x10) != (key ? 0x7000b89250ull : heart ? 0x7000b8b15cull : 0x7000b892f4ull) ||
+        r64(vt + 0x28) != (key ? 0x7000b89530ull : 0x7000b8941cull) ||
+        r64(vt + 0x30) != (key ? 0x7000b89578ull : 0x7000b8943cull) ||
+        r16(ob + 8) != (key ? 15 : heart ? 489 : piece ? 505 : crystal ? 502 : counter ? 421 + counter - 22 : 501) ||
+        !code(r64(vt + 0x20))) return false;
+    Flags f = flags(ITEM_MGR, 510, 64); if (!f.mgr) return false;
+    // HD moved gratitude out of the Wii logical flag 437. Require the actual seven-bit counter
+    // and native cap before calling it; crystal packs/NPC rewards are not this receipt type.
+    if (crystal && (!sst_chest_crystal_pickup(index) || r64(vt + 0x20) != 0x7000b89884ull ||
+        r8(f.defs + 1004) != 54 || r8(f.defs + 1005) != 0x36)) return false;
+    Flags story = {0}; uint64_t completion = 0, story_setter = 0; uint16_t completion_mask = 0;
+    if (piece) {
+        story = flags(STORY_MGR, 1202, 128);
+        uint64_t svt = story.mgr ? r64(story.mgr) : 0;
+        story_setter = ptr(svt, 0x40) ? r64(svt + 0x38) : 0;
+        if (!sst_chest_key_piece(index) || r64(vt + 0x20) != 0x7000b8b438ull ||
+            r8(f.defs + 1010) != 60 || r8(f.defs + 1011) != 3 ||
+            !story.mgr || !location(&story, 120, &completion, &completion_mask) || !code(story_setter)) return false;
+    }
+    uint64_t own; uint16_t mask;
+    if (!key && !location(&f, item, &own, &mask)) return false;
+    uint64_t item_vt = r64(f.mgr);
+    uint64_t setter = ptr(item_vt, 0x40) ? r64(item_vt + 0x38) : 0;
+    if (!code(setter)) return false;
+    unsigned before = result_call(c, r64(vt + 0x28), ob, 0) & 0xffff;
+    unsigned cap = result_call(c, r64(vt + 0x20), ob, 0) & 0xffff;
+    if (!cap || cap > 16383 || before > cap || (piece && cap != 5) || (crystal && cap != 127) ||
+        (key && (cap != 15 || before == cap)) || !backup(fm)) return false;
+    if (!prepare_receipt(c, &receipt)) return false;
+    // Small keys have no item-ownership flag; their only inventory effect is this dungeon counter.
+    if (!key) call(c, setter, f.mgr, item, 0);
+    for (unsigned unit = 0; unit < quantity; unit++) call(c, r64(vt + 0x10), ob, amount, 0);
+    amount *= quantity;
+    unsigned old_capacity = r16(fm + 0x5312);
+    if (heart) {
+        call(c, r64(heart_vt[1] + 0x10), heart_ob[1], 1, 0);
+        if (heart_before[0] == 3) call(c, HEART_CAPACITY, 0, 0, 0);
+        // Same capped healing routine/flags as native pickup Part2. Eighty quarter hearts fills
+        // the native limit, including equipped Life Medals, without recreating its pouch rules.
+        Cpu saved = *c;
+        c->x[0] = r64(PLAYER); c->x[1] = 80; c->x[2] = 1; c->x[3] = 1;
+        guest_call(c, PLAYER_HEAL); *c = saved;
+    }
+    unsigned after = result_call(c, r64(vt + 0x28), ob, 0) & 0xffff;
+    unsigned expected = heart ? (before + 1) % 4 : before + amount < cap ? before + amount : cap;
+    unsigned expected_capacity = old_capacity + (heart && before == 3 && old_capacity < 80 ? 4 : 0);
+    bool heart_ok = !heart ||
+        ((result_call(c, r64(heart_vt[1] + 0x28), heart_ob[1], 0) & 0xffff) ==
+            (heart_before[1] < 24 ? heart_before[1] + 1 : 24) &&
+         r16(fm + 0x5312) == expected_capacity && r16(fm + 0x5316) >= expected_capacity &&
+         r16(fm + 0x5316) <= 80);
+    if (after != expected || !heart_ok) {
+        // An unexpected native result is ambiguous: don't retry and risk another grant.
+        chests.conflict[index] = true;
+        notify("Chest sync paused: unexpected native reward result", false); return false;
+    }
+    if (key) {
+        key_raw = r64(dm + 0x18); // native setter may copy the FlagSpace
+        uint64_t saved_word = fm + 0xa74 + table * 16 + 2;
+        w16(saved_word, (r16(saved_word) & 0xfff0) | (r16(key_raw + 2) & 15));
+    }
+    mark_receipt(&receipt);
+    if (piece && after == 5) {
+        // Native pickup's completion event sets this bit. Remote grants complete it locally too;
+        // only a full native key may finish the quest or turn off key-piece dowsing.
+        call(c, story_setter, story.mgr, 120, 0);
+    }
+    applied++;
+    LOG("[sst-chest] granted index=%u item=%u counter=%u %u->%u\n", index, item, counter, before, after);
+    if (heart) LOG("[sst-chest] heart capacity=%u->%u health=%u total=%u\n", old_capacity,
+        r16(fm + 0x5312), r16(fm + 0x5316),
+        (unsigned)(result_call(c, r64(heart_vt[1] + 0x28), heart_ob[1], 0) & 0xffff));
+    return true;
+}
+static void chest_rewards(Cpu *c, uint64_t fm, bool apply, bool announce) {
+    uint64_t tm = r64(TBOX_MGR), sm = r64(SCENE_MGR);
+    if (!ptr(tm, 0x30) || !ptr(sm, 0x50)) return;
+    unsigned table = r16(tm + 0x28), scene_table = r16(sm + 0x4a);
+    if (table >= 26 || scene_table >= 26) return;
+    // Validate local metadata before admitting cached rewards. Only native opened receipts count;
+    // a chest opening animation is not proof that the player accepted its reward.
+    for (unsigned i = 0; i < chest_count; i++) {
+        uint64_t a = chest_actors[i]; unsigned index = actor_chest_index(a, table, scene_table);
+        if (r16(a + 0x10) == 0x281) continue; // remembered below, including after native deletion
+        if (index >= SST_CHESTS) continue; // temporary/zone flags cannot be durable receipts
+        SstChestReward r = {.index = index, .item = chest_item(a)};
+        if (chests.item[r.index] && chests.item[r.index] != r.item) {
+            chests.conflict[r.index] = true; continue;
+        }
+        if (!sst_chest_valid(&r)) continue;
+        ChestReceipt receipt;
+        if (apply && chest_receipt(fm, r.index, &receipt) && receipt_opened(&receipt) &&
+            sst_chest_learn(&chests, &r)) send_chest(&r, NULL);
+    }
+    // Freestanding rewards can delete themselves before the item-get event ends. Keep
+    // native metadata across actor/area lifetimes; only a completed personal receipt proves pickup.
+    // Other placed rewards are protected from switches but need their own acquisition review.
+    if (apply) for (unsigned sc = 0; sc < SST_SCENE_CHESTS; sc++) {
+        // A collected placed actor will not spawn on a fresh process. These reviewed vanilla
+        // locations can also be rediscovered directly from their own permanent save receipts.
+        unsigned index = SST_TBOX_CHESTS + sc;
+        uint16_t known_item = sst_chest_heart_pickup(index) ? 94 : sst_chest_crystal_pickup(index) ? 48 : 0;
+        if (known_item) {
+            SstChestReward known = {.index = index, .item = known_item};
+            sst_chest_remember_pickup(&chests, &known);
+        }
+        if (chests.pickup[sc] != 94 && chests.pickup[sc] != 48) continue;
+        SstChestReward r = {.index = index, .item = chests.pickup[sc]};
+        ChestReceipt receipt;
+        if (chest_receipt(fm, r.index, &receipt) && receipt_opened(&receipt) &&
+            sst_chest_learn(&chests, &r)) send_chest(&r, NULL);
+    }
+    if (apply) for (unsigned index = 0; index < SST_CHESTS; index++) {
+        uint16_t first_item = sst_chest_first_pouch_item(index);
+        if (first_item) {
+            FirstPouchReceipt receipt;
+            if (!first_pouch_receipt(fm, first_item, &receipt)) continue;
+            SstChestReward known = {.index = index, .item = first_item};
+            if (first_pouch_opened(fm, &receipt)) {
+                if (repair_first_pouch(c, fm, first_item) && sst_chest_learn(&chests, &known)) send_chest(&known, NULL);
+            } else if (chests.item[index] == first_item && !chests.conflict[index] && insert_pouch(c, fm, index, first_item)) applied++;
+            continue;
+        }
+        if (sst_chest_unique_pouch_item(index)) {
+            ShopItemReceipt receipt;
+            if (!shop_item_receipt(fm, &receipt) || !normal_inventory(fm)) continue;
+            SstChestReward known = {.index = index, .item = 70};
+            if (shop_item_opened(fm, &receipt)) {
+                if (repair_shop_item(c, fm) && sst_chest_learn(&chests, &known)) send_chest(&known, NULL);
+            } else if (chests.item[index] == 70 && !chests.conflict[index]) grant_shop_item(c, fm);
+            continue;
+        }
+        unsigned shop_flag, ordinal;
+        if (sst_chest_shop_counter(index, &shop_flag, &ordinal)) {
+            ShopCounter receipt;
+            if (!shop_counter(fm, shop_flag, &receipt)) continue;
+            SstChestReward known = {.index = index, .item = sst_chest_shop_item(index)};
+            if (receipt.count >= ordinal) {
+                if (grant_shop_purchase(c, fm, index) && sst_chest_learn(&chests, &known)) send_chest(&known, NULL);
+            } else if (chests.item[index] == known.item && !chests.conflict[index]) grant_shop_purchase(c, fm, index);
+            continue;
+        }
+        uint16_t shop_item = sst_chest_shop_item(index);
+        if (shop_item) {
+            QuestReceipt receipt;
+            if (!quest_receipt(fm, index, &receipt)) continue;
+            SstChestReward known = {.index = index, .item = shop_item};
+            if (quest_opened(&receipt)) {
+                if (!strcmp(loaded_scene.stage, "F002r") && !(r16(receipt.word) & receipt.mask)) continue;
+                if (repair_quest_receipt(c, fm, &receipt) && sst_chest_learn(&chests, &known)) send_chest(&known, NULL);
+            } else if (strcmp(loaded_scene.stage, "F002r") && chests.item[index] == shop_item && !chests.conflict[index]) {
+                // Native stock actors cache their current offer. Apply after leaving the shop;
+                // their next creation reads the completed purchase before enabling interaction.
+                if (shop_item == 94) grant_chest(c, fm, index, shop_item);
+                else grant_pouch_gift(c, fm, index);
+            }
+            continue;
+        }
+        uint16_t wallet_gift = sst_chest_wallet_gift_item(index);
+        if (wallet_gift) {
+            QuestReceipt receipt;
+            if (!quest_receipt(fm, index, &receipt)) continue;
+            SstChestReward known = {.index = index, .item = wallet_gift};
+            if (quest_opened(&receipt)) {
+                if (grant_wallet_gift(c, fm, index) && sst_chest_learn(&chests, &known)) send_chest(&known, NULL);
+            } else if (chests.item[index] == wallet_gift && !chests.conflict[index]) grant_wallet_gift(c, fm, index);
+            continue;
+        }
+        uint16_t pouch_gift = sst_chest_pouch_gift_item(index);
+        if (pouch_gift) {
+            QuestReceipt receipt;
+            if (!quest_receipt(fm, index, &receipt)) continue;
+            SstChestReward known = {.index = index, .item = pouch_gift};
+            if (quest_opened(&receipt)) {
+                if (repair_quest_receipt(c, fm, &receipt) && sst_chest_learn(&chests, &known)) send_chest(&known, NULL);
+            } else if (chests.item[index] == pouch_gift && !chests.conflict[index]) grant_pouch_gift(c, fm, index);
+            continue;
+        }
+        if (sst_chest_trial_flag(index)) {
+            QuestReceipt receipt;
+            if (!quest_receipt(fm, index, &receipt)) continue;
+            SstChestReward known = {.index = index, .item = sst_chest_trial_item(index)};
+            if (quest_opened(&receipt)) {
+                if (grant_trial(c, fm, index) && sst_chest_learn(&chests, &known)) send_chest(&known, NULL);
+            } else if (chests.item[index] == known.item && !chests.conflict[index]) grant_trial(c, fm, index);
+            continue;
+        }
+        if (sst_chest_quest_flag(index)) {
+            QuestReceipt receipt;
+            if (!quest_receipt(fm, index, &receipt)) continue;
+            SstChestReward known = {.index = index, .item = 35};
+            if (quest_opened(&receipt)) {
+                repair_quest_receipt(c, fm, &receipt);
+                if (sst_chest_learn(&chests, &known)) send_chest(&known, NULL);
+            } else if (chests.item[index] == 35 && !chests.conflict[index]) grant_quest(c, fm, index);
+            continue;
+        }
+        uint16_t saved_item = sst_chest_saved_reward(index);
+        if (saved_item) {
+            SstChestReward known = {.index = index, .item = saved_item};
+            ChestReceipt source;
+            if (chests.item[index] && chests.item[index] != saved_item) chests.conflict[index] = true;
+            if (chest_receipt(fm, index, &source) && receipt_opened(&source) && sst_chest_learn(&chests, &known))
+                send_chest(&known, NULL);
+        }
+        if (!chests.item[index] || chests.conflict[index]) continue;
+        ChestReceipt receipt;
+        if (!chest_receipt(fm, index, &receipt)) continue;
+        if (receipt_opened(&receipt)) {
+            if (sst_chest_sword_tier(chests.item[index]) && !sword_ready(fm,chests.item[index])) grant_sword(c,fm,index,chests.item[index]);
+            if (chests.item[index] == 70) repair_shop_item(c, fm);
+            if (sst_chest_shield_durability(chests.item[index]) || sst_chest_ammo_quantity(chests.item[index])) repair_first_pouch(c, fm, chests.item[index]);
+            if (sst_chest_pouch_expansion(chests.item[index]) && !pouch_expansion_inventory_ready(fm))
+                grant_pouch_expansion(c, fm, index);
+            if (sst_chest_wallet(chests.item[index]) && !wallet_inventory_ready(chests.item[index]))
+                grant_gear(c, fm, index, chests.item[index]);
+            continue;
+        }
+        if (grant_chest(c, fm, index, chests.item[index]) && receipt.loaded) {
+            // Active unopened boxes must stop offering their reward immediately. Native deletion
+            // unregisters interaction/collision/dowsing; re-entering displays the saved opened box.
+            for (unsigned i = 0; i < chest_count; i++) {
+                uint64_t a = chest_actors[i];
+                unsigned profile = r16(a + 0x10);
+                if (actor_chest_index(a, table, scene_table) == index &&
+                    ((profile == 0x1e8 && !r8(a + 0x1994)) || profile == 0x1eb || profile == 0x281))
+                    call(c, DELETE_REQUEST, a, 0, 0);
+            }
+        }
+    }
+    // Boxes with both receipt types also set a scene switch natively. Once the canonical TBox
+    // receipt proves delivery, mirror that switch so chest-dependent doors/scripts can update.
+    if (apply) for (unsigned i = 0; i < chest_count; i++) {
+        uint64_t a = chest_actors[i]; unsigned index = actor_chest_index(a, table, scene_table);
+        unsigned scene_bit = chest_scene_flag(a);
+        if (index >= SST_TBOX_CHESTS || scene_bit >= 128 || !chests.item[index] || chests.conflict[index]) continue;
+        ChestReceipt canonical, auxiliary;
+        if (!chest_receipt(fm, index, &canonical) || !receipt_opened(&canonical) ||
+            !chest_receipt(fm, sst_chest_index(true, scene_table, scene_bit), &auxiliary) ||
+            receipt_opened(&auxiliary) || !backup(fm) || !prepare_receipt(c, &auxiliary)) continue;
+        mark_receipt(&auxiliary);
+    }
+    if (announce) sst_chest_announce(&chests, send_chest, NULL);
+}
+static void send_enemy(const SstEnemyEvent *e, void *u) {
+    (void)u; sst_net_send_enemy(e);
+    if (ENV("SST_TRACE")) LOG("[sst-enemy] sent key=%llx sequence=%u hp=%u damage=%u snapshot=%u\n",
+        (unsigned long long)e->key,e->sequence,e->health,e->damage,e->snapshot);
+}
+static void remote_enemy(const SstEnemyEvent *e, void *u) {
+    if (!sst_world_same_area(&enemies.scene, &e->scene) || !sst_world_enemy_profile(e->profile) ||
+        !backup(r64(FILE_MGR))) return;
+    Cpu *c = u; SstEnemyTrack *t = sst_enemies_exchange(&enemies, e, send_enemy, NULL); if (!t) return;
+    for (unsigned i = 0; i < actor_count; i++) {
+        Actor *a = &actors[i];
+        if (a->key != t->key || a->instance != t->instance || r8(a->address + 0x13)) continue;
+        w16(a->address + 0x42e, t->health);
+        if (!t->health) {
+            // dAcBase::deleteWithFlagNoItemDrop semantics: no duplicate drops; record the placed
+            // enemy defeat through its copy-on-write FlagSpace, then invoke native deleteRequest.
+            w32(a->address + 0x12c, r32(a->address + 0x12c) | 0xff000000);
+            uint64_t m = r64(ENEMY_MGR); unsigned id = r16(a->address + 0x136);
+            if (ptr(m, 0x28)) {
+                uint64_t vt = r64(m + 0x10), fn = ptr(vt, 8) ? r64(vt) : 0;
+                if (code(fn)) call(c, fn, m + 0x10, 0, 0);
+                uint64_t raw = r64(m + 0x18);
+                if (ptr(raw, 8192)) {
+                    w16(raw + (id / 16) * 2, r16(raw + (id / 16) * 2) | (1u << (id % 16)));
+                    *(uint8_t *)(uintptr_t)(m + 8) = 1;
+                }
+            }
+            call(c, DELETE_REQUEST, a->address, 0, 0);
+        }
+        enemy_updates++;
+        if (ENV("SST_TRACE")) LOG("[sst-world] enemy profile=%x id=%u hp=%u\n", a->profile, r16(a->address + 0x136), t->health);
+        break;
+    }
+}
+static void discard_enemy(const SstEnemyEvent *e, void *u) { (void)e; (void)u; }
+static uint32_t retained_defeat(const SstEnemyEvent *e) {
+    for (unsigned i=0;i<SST_ENEMIES;i++) {
+        const SstEnemyTrack *a=&enemies.actors[i];
+        if (a->used && !a->provisional && !a->health && a->key==e->key && a->profile==e->profile) return a->instance;
+    }
+    return 0;
+}
+
+static void defer_enemy(const SstEnemyEvent *e, void *u) {
+    (void)u;
+    for (unsigned i = 0; i < actor_count; i++) {
+        Actor *a = &actors[i];
+        if (a->key != e->key || a->profile != e->profile || r8(a->address + 0x13)) continue;
+        if (sst_enemy_inbox_push(&enemy_inbox, e, a->instance) && ENV("SST_TRACE"))
+            LOG("[sst-enemy] held key=%llx sequence=%u instance=%u pending=%u during native menu/event\n",
+                (unsigned long long)e->key, e->sequence, a->instance, enemy_inbox.count);
+        return;
+    }
+    // A deleted actor has no live entry to bind, but its same-visit defeat can still
+    // answer a spawn probe. Keep its original instance and FIFO order across menus.
+    uint32_t instance=e->snapshot && e->health ? retained_defeat(e) : 0;
+    if (instance) sst_enemy_inbox_push(&enemy_inbox,e,instance);
+}
+static void resume_enemy(const SstEnemyEvent *e, uint32_t instance, void *u) {
+    for (unsigned i = 0; i < actor_count; i++)
+        if (actors[i].key == e->key && actors[i].instance == instance) { remote_enemy(e, u); return; }
+    if (e->snapshot && e->health && retained_defeat(e)==instance) remote_enemy(e,u);
+}
+static void incoming_motion(const SstEnemyMotion *m, void *u) {
+    (void)u;
+    if (sst_motion_receive(&motion, m, sst_now_ms())) motion_received++;
+}
+static void movement(const SstLocal *l, uint32_t load, uint64_t now) {
+    uint16_t mine = sst_net_my_id();
+    uint16_t owner = sst_net_motion_owner(&l->scene, l->pose.health > 0);
+    sst_motion_begin(&motion, &l->scene, load, owner);
+    bool send = owner && owner == mine && now - motion_last_send >= 100;
+    for (unsigned i = 0; i < actor_count; i++) {
+        Actor *a = &actors[i];
+        if (r8(a->address + 0x13) || (int16_t)r16(a->address + 0x42e) <= 0) continue;
+        sst_motion_observe(&motion, a->key, a->instance, a->profile);
+        if (send) {
+            SstEnemyMotion m = {.scene = l->scene, .key = a->key, .profile = a->profile,
+                                .sequence = ++motion_sequence};
+            memcpy(m.pos, (void *)(uintptr_t)(a->address + 0x144), 12);
+            memcpy(m.rot, (void *)(uintptr_t)(a->address + 0x13c), 6);
+            memcpy(m.velocity, (void *)(uintptr_t)(a->address + 0x1e8), 12);
+            if (sst_motion_valid(&m)) { sst_net_send_motion(&m); motion_sent++; }
+        }
+    }
+    if (send) motion_last_send = now;
+    sst_net_poll_motion(owner && owner != mine ? incoming_motion : NULL, NULL);
+    if (owner && owner != mine) for (unsigned i = 0; i < actor_count; i++) {
+        Actor *a = &actors[i]; float pos[3], vel[3]; int16_t rot[3];
+        if (r8(a->address + 0x13) || (int16_t)r16(a->address + 0x42e) <= 0 ||
+            !sst_motion_sample(&motion, a->key, a->instance, now, pos, rot, vel)) continue;
+        // Write only the active transform and velocity. Spawn/return-home copies, animation
+        // state, health and script data belong to the native actor and remain untouched here.
+        memcpy((void *)(uintptr_t)(a->address + 0x144), pos, 12);
+        memcpy((void *)(uintptr_t)(a->address + 0x13c), rot, 6);
+        memcpy((void *)(uintptr_t)(a->address + 0x1e8), vel, 12);
+        motion_applied++;
+    }
+    if (ENV("SST_TRACE") && now - motion_last_trace >= 1000) {
+        motion_last_trace = now;
+        LOG("[sst-motion] owner=%u mine=%u actors=%u sent=%u received=%u applied=%u\n",
+            owner, mine, actor_count, motion_sent, motion_received, motion_applied);
+    }
+}
+static void reward_waiting(uint64_t fm, SstRewardPause pause) {
+    SstRewardStatus status = {.pause = pause};
+    SongState songs;bool have_songs=song_state(fm,&songs);
+    for(unsigned slot=0;slot<8;slot++) {
+        unsigned bit=1u<<slot;
+        bool pending=sst_world_pending(&world,SST_WORLD_ITEM,186+slot) || (have_songs && (held_songs&bit));
+        if(pending && (!have_songs || !(songs.live&songs.saved&bit))) {status.pending++;status.song_wait++;}
+    }
+    for(unsigned tier=1;tier<=6;tier++) {
+        uint16_t item=sst_chest_sword_item(tier);
+        if(sst_world_pending(&world,SST_WORLD_ITEM,item) && !sword_ready(fm,item)) {
+            status.pending++;if(!normal_inventory(fm))status.sword_wait++;
+        }
+    }
+    if (!strcmp(loaded_scene.stage, "F002r")) for (unsigned n = 0; n < 2; n++) {
+        unsigned item = n ? 140 : 71;
+        if (sst_world_pending(&world, SST_WORLD_ITEM, item) && shop_tool_waiting(item)) { status.pending++; status.shop_wait++; }
+    }
+    for (unsigned i = 0; i < SST_CHESTS; i++) {
+        if (!chests.item[i]) continue;
+        uint16_t first_item = sst_chest_first_pouch_item(i);
+        if (first_item) {
+            FirstPouchReceipt r;
+            if (!first_pouch_receipt(fm, first_item, &r)) continue;
+            bool owned = first_pouch_opened(fm, &r);
+            if (owned && (r16(r.word) & r.mask) && (r16(r.saved) & r.mask)) continue;
+            if (chests.conflict[i]) { status.conflicts++; continue; }
+            status.pending++;
+            if (pouch_shop_active()) status.shop_wait++;
+            if (!owned && pouch_slot(fm) == SST_POUCH_SLOTS) status.pouch_wait++;
+            continue;
+        }
+        if (sst_chest_unique_pouch_item(i)) {
+            ShopItemReceipt receipt;
+            if (!shop_item_receipt(fm, &receipt)) continue;
+            bool owned = shop_item_opened(fm, &receipt);
+            if (owned && (r16(receipt.word) & receipt.mask) && (r16(receipt.saved) & receipt.mask)) continue;
+            if (chests.conflict[i]) { status.conflicts++; continue; }
+            status.pending++;
+            if (!strcmp(loaded_scene.stage, "F002r")) status.shop_wait++;
+            if (!owned && pouch_slot(fm) == SST_POUCH_SLOTS) status.pouch_wait++;
+            continue;
+        }
+        unsigned shop_flag, ordinal;
+        if (sst_chest_shop_counter(i, &shop_flag, &ordinal)) {
+            ShopCounter receipt;
+            if (!shop_counter(fm, shop_flag, &receipt) || shop_purchase_ready(fm, i)) continue;
+            if (chests.conflict[i]) { status.conflicts++; continue; }
+            status.pending++;
+            if (!strcmp(loaded_scene.stage, "F002r") && (receipt.count < ordinal || receipt.live < receipt.count)) status.shop_wait++;
+            if (shop_flag == 707) { Flags f; if (!pouch_inventory(fm, &f)) status.pouch_wait++; }
+            for (unsigned preceding = receipt.count; preceding + 1 < ordinal; preceding++) {
+                unsigned earlier = i - ordinal + 1 + preceding;
+                if (chests.item[earlier] != chests.item[i] || chests.conflict[earlier]) { status.shop_order++; break; }
+            }
+            continue;
+        }
+        if (sst_chest_quest_flag(i) || sst_chest_trial_flag(i) || sst_chest_pouch_gift_item(i) || sst_chest_wallet_gift_item(i) || sst_chest_shop_item(i)) {
+            QuestReceipt receipt;
+            if (quest_receipt(fm, i, &receipt) && (!quest_completed(fm, i, &receipt) ||
+                (sst_chest_trial_flag(i) && !trial_inventory_ready(i)) ||
+                (sst_chest_shop_item(i) && !strcmp(loaded_scene.stage, "F002r") && !(r16(receipt.word) & receipt.mask)) ||
+                (sst_chest_wallet_gift_item(i) && !wallet_inventory_ready(sst_chest_wallet_gift_item(i))))) {
+                if (chests.conflict[i]) { status.conflicts++; continue; }
+                // Opposite cached endings still represent one personal reward.
+                unsigned alt = sst_chest_quest_alternative(i - SST_CONTAINER_CHESTS);
+                if (alt && SST_CONTAINER_CHESTS + alt < i && chests.item[SST_CONTAINER_CHESTS + alt]) continue;
+                status.pending++;
+                if (sst_chest_shop_item(i) && !strcmp(loaded_scene.stage, "F002r")) status.shop_wait++;
+                if ((sst_chest_pouch_gift_item(i) || (receipt.flag == 384 && parrow_needs_bottle(fm))) && pouch_slot(fm) == SST_POUCH_SLOTS)
+                    status.pouch_wait++;
+                bool ambiguous = false;
+                if (sst_chest_quest_letter(i - SST_CONTAINER_CHESTS) && quest_target(fm, i, &ambiguous) >= SST_CHESTS) {
+                    if (ambiguous) status.quest_ambiguous++; else status.quest_choice++;
+                }
+            }
+            continue;
