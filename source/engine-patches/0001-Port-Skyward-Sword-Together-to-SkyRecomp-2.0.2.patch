+static bool grant_tool(Cpu *c, uint64_t fm, unsigned index, uint16_t item);
+static bool grant_gear(Cpu *c, uint64_t fm, unsigned index, uint16_t item);
+static bool normal_inventory(uint64_t fm);
+static bool sword_ready(uint64_t fm, uint16_t item);
+static bool grant_sword(Cpu *c, uint64_t fm, unsigned index, uint16_t item);
+static bool tool_prerequisites_ready(Flags f, uint16_t item) {
+    for (unsigned i = 0; i < 3; i++) {
+        uint16_t required = sst_chest_tool_prerequisite(item, i);
+        uint64_t a; uint16_t mask;
+        if (required && (!location(&f, required, &a, &mask) || !(r16(a) & mask))) return false;
+    }
+    return true;
+}
+static bool tool_owned(Flags f, uint16_t item) {
+    uint64_t a; uint16_t mask;
+    return location(&f, item, &a, &mask) && (r16(a) & mask);
+}
+static void logical_flags(Cpu *c, Flags f, unsigned k, bool apply, uint64_t fm) {
+    if (!f.mgr) return;
+    for (unsigned id = 0; id < f.count; id++) {
+        if (!sst_world_flag_allowed(k, id)) continue;
+        if (k == SST_WORLD_ITEM && sst_world_song(id)) continue; // checked permanent-song path
+        // The completed-key story bit must not outrun personal inventory/collection receipts.
+        if (k == SST_WORLD_STORY && id == 120 && !key_pieces_complete()) continue;
+        // Opening Sky Keep cannot outrun the receiver's personal Hylia reward transaction.
+        if (k == SST_WORLD_STORY && id == 22) {
+            Flags items = flags(ITEM_MGR, 510, 64);
+            if (!items.mgr || !tool_owned(items, 180) || !tool_owned(f, 209)) continue;
+        }
+        // Original gifts and upgrades have no permanent chest receipt. Publish only after
+        // acquisition finishes; receivers use checked ownership, wheel and first-ammo paths.
+        if (k == SST_WORLD_ITEM && sst_chest_sword_tier(id) && (!apply || !normal_inventory(fm))) continue;
+        if (k == SST_WORLD_ITEM && (sst_chest_tool_gift(id) || sst_chest_gear(id)) && !apply) continue;
+        uint64_t a; uint16_t mask;
+        if (!location(&f, id, &a, &mask)) { sst_world_applied(&world, k, id); continue; }
+        bool set = (r16(a) & mask) != 0;
+        if (set && sst_world_learn(&world, k, id)) sst_net_send_flag(k, id, 1);
+        if (!sst_world_pending(&world, k, id) || !apply) continue;
+        if (k == SST_WORLD_ITEM && sst_chest_sword_tier(id)) {
+            if (sword_ready(fm, id) || grant_sword(c, fm, SST_CHESTS, id)) {
+                sst_world_applied(&world, k, id); applied++;
+            }
+            continue;
+        }
+        if (k == SST_WORLD_ITEM && sst_chest_tool_gift(id)) {
+            // Older ownership-only grants may lack the wheel. Repair it without refilling
+            // ammunition on an already-owned Slingshot.
+            Flags story = flags(STORY_MGR, 1202, 128); uint64_t wheel; uint16_t wheel_mask;
+            bool ready = story.mgr && location(&story, 58, &wheel, &wheel_mask) && (r16(wheel) & wheel_mask);
+            if (set && ready && tool_prerequisites_ready(f, id)) { sst_world_applied(&world, k, id); continue; }
+            if (grant_tool(c, fm, SST_CHESTS, id)) {
+                sst_world_applied(&world, k, id); applied++;
+            }
+            continue;
+        }
+        if (set) { sst_world_applied(&world, k, id); continue; }
+        if (k == SST_WORLD_ITEM && sst_chest_gear(id)) {
+            if (grant_gear(c, fm, SST_CHESTS, id)) {
+                sst_world_applied(&world, k, id); applied++;
+            }
+            continue;
+        }
+        uint64_t vt = r64(f.mgr), fn = ptr(vt, 0x40) ? r64(vt + 0x38) : 0;
+        if (!code(fn) || !backup(fm)) continue;
+        call(c, fn, f.mgr, id, 0);
+        if (r16(a) & mask) {
+            sst_world_applied(&world, k, id); applied++;
+            if (ENV("SST_TRACE")) LOG("[sst-world] applied kind=%u id=%u\n", k, id);
+        }
+    }
+}
+static void history_load(uint64_t fm,unsigned si,uint64_t sr) {
+    if (!history_loaded) {
+        extern const char *g_save_dir;
+        int n=snprintf(history_path,sizeof history_path,"%s/save_0/sst-scenes-v1.bin",g_save_dir);
+        SstHistoryResult result=n<0 || (size_t)n>=sizeof history_path?SST_HISTORY_IO:
+            sst_scene_history_load(&scene_history,history_path);
+        history_loaded=true;history_disabled=result!=SST_HISTORY_OK && result!=SST_HISTORY_MISSING;
+        if(history_disabled)notify("Saved area recovery unavailable; existing history was preserved",false);
+        LOG("[sst-scenes] history load result=%u\n",result);
+    }
+    if(history_disabled)return;
+    sst_scene_history_prune(&scene_history,&world);
+    uint8_t owned[SST_WORLD_BYTES]={0};
+    for(unsigned t=0;t<26;t++)for(unsigned w=0;w<8;w++) {
+        uint16_t bits=r16(fm+0x1a74+t*16+w*2)|(t==si?r16(sr+w*2):0);
+        owned[t*16+w*2]=(uint8_t)bits;owned[t*16+w*2+1]=(uint8_t)(bits>>8);
+    }
+    unsigned recovered=sst_scene_history_recover(&scene_history,owned,&world);
+    if(recovered) {
+        history_announce_pending=true;
+        LOG("[sst-scenes] recovered %u previously admitted, still-owned scene changes\n",recovered);
+    }
+}
+static void tables(uint64_t fm, bool apply, bool boss, bool announce) {
+    uint64_t sm = r64(SCENE_MGR);
+    if (!ptr(sm, 0x50)) { scene_primed = false; return; }
+    unsigned si = r16(sm + 0x4a); uint64_t sr = r64(sm + 8);
+    if (si >= 26 || !ptr(sr, 16)) { scene_primed = false; return; }
+    if(!boss && (!history_loaded || announce || history_announce_pending))history_load(fm,si,sr);
+    if(!boss && history_loaded && !history_disabled)sst_scene_history_prune(&scene_history,&world);
+    for (unsigned t = 0; t < 26; t++) for (unsigned w = 0; w < 8; w++) {
+        uint64_t sa = fm + 0x1a74 + t * 16 + w * 2;
+        uint16_t scene = r16(sa) | (t == si ? r16(sr + w * 2) : 0);
+        uint16_t rose = scene_primed && !boss ? scene & ~scene_before[t][w] : 0;
+        for (unsigned bit = 0; bit < 16; bit++) {
+            unsigned id = t * 128 + w * 16 + bit; uint16_t mask = 1u << bit;
+            if ((rose & mask) && sst_world_learn(&world, SST_WORLD_SCENE, id)) {
+                sst_net_send_flag(SST_WORLD_SCENE, id, 1);
+                // Durable proof requires the source table's live metadata too.
+                if(t==si && !history_disabled)sst_scene_history_record(&scene_history,&world,id);
+            }
+            // Wait for local metadata to protect personal container receipts before switching
+            // their scene table. Dungeon inventory is exclusively handled by chest transactions.
+            if (!apply || t != si || !sst_world_pending(&world, SST_WORLD_SCENE, id)) continue;
+            uint64_t live = sr + w * 2;
+            if (!(r16(sa) & mask) || !(r16(live) & mask)) {
+                if (!backup(fm)) continue;
+                w16(sa, r16(sa) | mask); w16(live, r16(live) | mask);
+                *(uint8_t *)(uintptr_t)(sm + 0x4c) = 1; applied++;
+            }
+            sst_world_applied(&world, SST_WORLD_SCENE, id);
+            if(!boss && !history_disabled)sst_scene_history_record(&scene_history,&world,id);
+        }
+        scene_before[t][w] = r16(sa) | (t == si ? r16(sr + w * 2) : 0);
+    }
+    scene_primed = true;
+    if(!boss && history_loaded && !history_disabled && scene_history.dirty && sst_now_ms()>=history_retry_at) {
+        if(sst_scene_history_save(&scene_history,history_path)) {
+            history_retry_at=0;
+            LOG("[sst-scenes] admitted scene history saved\n");
+        } else {
+            if(!history_retry_at)notify("Current area changes could not be saved for later team recovery",false);
+            history_retry_at=sst_now_ms()+5000;
+        }
+    }
+}
+typedef struct { uint64_t address, key; uint32_t instance; uint16_t profile; } Actor;
+static Actor actors[SST_ENEMIES];
+static unsigned actor_count;
+#define REWARD_ACTORS 256
+static uint64_t chest_actors[REWARD_ACTORS];
+static unsigned chest_count;
+// fManager's search list has eight buckets. Use its connection tree instead; bound traversal and
+// check owner backlinks so a tree under construction cannot hang the game or match a stale actor.
+static bool find_actors(uint64_t player, uint8_t room) {
+    actor_count = chest_count = 0;
+    uint64_t sm = r64(SCENE_MGR);
+    unsigned scene_table = ptr(sm, 0x50) ? r16(sm + 0x4a) : 26;
+    uint64_t node = player + 0x18;
+    for (int i = 0; i < 64; i++) {
+        if (!ptr(node, 0x28)) return true;
+        uint64_t parent = r64(node); if (!parent) break;
+        node = parent; if (i == 63) return true;
+    }
+    uint64_t stack[4096], visited[4096]; unsigned count = 0, top = 0;
+    stack[top++] = node; bool boss = false;
+    while (top && count < 4096) {
+        node = stack[--top]; if (!ptr(node, 0x28)) return true;
+        for (unsigned i = 0; i < count; i++) if (visited[i] == node) return true;
+        visited[count++] = node;
+        uint64_t a = r64(node + 0x20);
+        if (!ptr(a, 0x18) || a + 0x18 != node) return true;
+        uint16_t profile = r16(a + 0x10);
+        if (r8(a + 0x12) == 1) {
+            if (sst_world_boss_profile(profile)) {
+                if (!ptr(a, 0x17d)) return true;
+                if (sst_world_boss_actor(profile, r8(a + 0x17c), room)) boss = true;
+            }
+            if (sst_world_enemy_profile(profile) && ptr(a, 0x430) &&
+                (r8(a + 0x17c) == room || r8(a + 0x17c) == 0xff) &&
+                actor_count < SST_ENEMIES && r16(a + 0x136) != 0xffff &&
+                !(debug_enemy_delay && r16(a + 0x136)==debug_enemy_id))
+                actors[actor_count++] = (Actor){a, sst_world_enemy_key(profile, r16(a + 0x136), r32(a + 0xc)), r32(a + 8), profile};
+            if (profile == 0x1e8 && ptr(a, 0x19a8) && !r8(a + 0x13) && chest_count < REWARD_ACTORS)
+                chest_actors[chest_count++] = a;
+            if (profile == 0x8b && ptr(a, 0x17d) && !r8(a + 0x13) && chest_count < REWARD_ACTORS)
+                chest_actors[chest_count++] = a; // wardrobe: reward/receipt live in params1
+            if (profile == 0x1eb && ptr(a, 0xadc) && (r32(a + 0xc) & 15) == 4 &&
+                r8(a + 0xacc) == 0 && r8(a + 0xac8) == ((r32(a + 0xc) >> 4) & 255) &&
+                !r8(a + 0x13) && chest_count < REWARD_ACTORS)
+                chest_actors[chest_count++] = a; // initialized key-piece digging spot
+            if (profile == 0x281 && ptr(a, 0x1288) && !r8(a + 0x13) && chest_count < REWARD_ACTORS &&
+                sst_chest_pickup(r32(a + 0xc), r16(a + 0x136), r16(a + 0x410), scene_table, NULL))
+                chest_actors[chest_count++] = a; // fixed placed pickup, never a chest presentation/drop
+        }
+        uint64_t next = r64(node + 0x18), child = r64(node + 8);
+        if (next && top < 4096) stack[top++] = next;
+        if (child && top < 4096) stack[top++] = child;
+    }
+    return boss || top != 0;
+}
