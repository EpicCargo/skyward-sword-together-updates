+static bool wallet_flags(Flags f, unsigned *owned) {
+    unsigned bits = 0;
+    for (unsigned i = 0; i < 4; i++) {
+        uint64_t word; uint16_t mask;
+        if (!f.mgr || !location(&f, 108 + i, &word, &mask)) return false;
+        if (r16(word) & mask) bits |= 1u << i;
