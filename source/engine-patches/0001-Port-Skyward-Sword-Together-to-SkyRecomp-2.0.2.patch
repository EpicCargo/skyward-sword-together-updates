+// Multiplayer tab (Skyward Sword Together): connection settings, status and the player list.
+#include <stdio.h>
+#include <string.h>
+
+#include "imgui.h"
+#include "osk.h"
+extern "C" {
+#include "../settings.h"
+}
+#include "../sst/sst_game.h"
+#include "../sst/sst_net.h"
+#include "../sst/sst_host.h"
+#include "../sst/sst_world.h"
+
+
+static void field(const char *label, const char *id, char *buf, size_t cap, const char *hint, float w) {
+    ImGui::AlignTextToFramePadding();
+    ImGui::TextUnformatted(label);
+    ImGui::SameLine(w * 0.28f);
+    ImGui::SetNextItemWidth(w * 0.6f);
+    if (ui_input_text(id, buf, cap, 0, hint, label)) settings_save();
+}
+
+void tab_multiplayer(float scale) {
+    float w = ImGui::GetContentRegionAvail().x;
+    char why[160];
+    SstStatus st = sst_net_status(why, sizeof why);
+    static const char *const names[] = {"Offline", "Connecting...", "Online", "Failed"};
+    static const ImVec4 colors[] = {{0.7f, 0.7f, 0.7f, 1}, {0.93f, 0.76f, 0.33f, 1}, {0.45f, 0.85f, 0.45f, 1}, {0.95f, 0.4f, 0.35f, 1}};
+    ImGui::TextColored(colors[st], "%s", names[st]);
+    if (why[0] && st != SST_ONLINE) { ImGui::SameLine(); ImGui::TextDisabled("(%s)", why); }
+    uint16_t host_port = sst_host_port();
+    if (host_port) ImGui::Text("Session role: Hosting (port %u)", host_port);
+    else if (st == SST_ONLINE) ImGui::TextUnformatted("Session role: Joined another host");
+    else if (st == SST_CONNECTING) ImGui::TextUnformatted("Session role: Joining another host");
+    else ImGui::TextDisabled("Session role: Disconnected");
+    if (st == SST_ONLINE) {
+        SstPlayer peers[SST_MAX_PLAYERS];
+        int peer_count = sst_net_players(peers, SST_MAX_PLAYERS);
+        ImGui::Text("Other players in this room: %d", peer_count);
+        if (!peer_count) ImGui::TextWrapped("No other players are connected to this room. Friends must join the same host and room.");
+    }
+    SstConnectionStats connection = sst_net_stats();
+    if (connection.queue_recoveries)
+        ImGui::TextWrapped("Refreshed team state after a network backlog: %u", connection.queue_recoveries);
+    if (connection.online) {
+        ImGui::TextDisabled("Movement: %s", connection.udp_active ? "UDP" : "TCP");
+        if (connection.udp_fallbacks) ImGui::TextDisabled("UDP fallback recoveries: %u", connection.udp_fallbacks);
+        if (connection.has_rtt) ImGui::TextDisabled("Host/relay round trip: %u ms", connection.rtt_ms);
+        else ImGui::TextDisabled("Measuring host/relay round trip...");
+        ImGui::TextDisabled("Last packet: %.1f s ago | TCP send queue: %.1f KiB",
+            connection.last_packet_age_ms / 1000.0, connection.queued_bytes / 1024.0);
+    }
+    ImGui::Spacing();
+
+    bool busy = st == SST_ONLINE || st == SST_CONNECTING;
+    ImGui::BeginDisabled(busy);  // name, room, team and server apply on the next connect
+    field("Name", "##sst_name", g_sst.name, sizeof g_sst.name, "Player", w);
+    field("Host address", "##sst_server", g_sst.server, sizeof g_sst.server, "friend's IP:7623", w);
+    field("Room", "##sst_room", g_sst.room, sizeof g_sst.room, "(public)", w);
+    field("Team", "##sst_team", g_sst.team, sizeof g_sst.team, "(no team)", w);
+    if (ImGui::Checkbox("Reconnect automatically", &g_sst.auto_reconnect)) settings_save();
+    if (ImGui::Checkbox("Use UDP for movement", &g_sst.use_udp)) settings_save();
+    if (ImGui::IsItemHovered()) ImGui::SetTooltip("Uses TCP automatically if UDP is blocked. Story progress, rewards and damage always use TCP. Applies on the next connection.");
+    int port = g_sst.host_port;
+    ImGui::SetNextItemWidth(w * 0.3f);
+    if (ImGui::InputInt("Hosting port", &port, 0, 0) && port > 0 && port <= 65535) {
+        g_sst.host_port = (uint16_t)port; settings_save();
+    }
+    ImGui::EndDisabled();
