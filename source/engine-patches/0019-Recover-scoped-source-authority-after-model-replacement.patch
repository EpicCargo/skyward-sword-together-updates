@@ -481,6 +512,7 @@ static void vis72_model_callback(Cpu *c,GuestFn original,unsigned kind) {
         }
         pthread_mutex_unlock(&vis72_log_mu);
     }
+    if(emission_use)sst_origin_emission_leave(); // covers every post-original native diagnostic read
 }
