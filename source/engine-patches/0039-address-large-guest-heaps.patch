+                                               .pHostPointer = pointer};
+    VkMemoryDedicatedAllocateInfo only = {
+        .sType = VK_STRUCTURE_TYPE_MEMORY_DEDICATED_ALLOCATE_INFO, .pNext = &import, .buffer = buffer};
+    VkMemoryAllocateFlagsInfo flags = {.sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_FLAGS_INFO,
+                                       .flags = VK_MEMORY_ALLOCATE_DEVICE_ADDRESS_BIT,
+                                       .pNext = dedicated.requiresDedicatedAllocation ? (void *)&only : (void *)&import};
+    VkMemoryAllocateInfo allocation = {.sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+                                       .pNext = &flags,
+                                       .allocationSize = size,
+                                       .memoryTypeIndex = (uint32_t)__builtin_ctz(compatible)};
+    result = vkAllocateMemory(device, &allocation, NULL, &memory);
+    if (result != VK_SUCCESS) goto failed;
+    result = vkBindBufferMemory(device, buffer, memory, 0);
+    if (result != VK_SUCCESS) goto failed;
+    VkBufferDeviceAddressInfo address = {.sType = VK_STRUCTURE_TYPE_BUFFER_DEVICE_ADDRESS_INFO, .buffer = buffer};
+    VkDeviceAddress location = vkGetBufferDeviceAddress(device, &address);
+    if (!location) {
+        result = VK_ERROR_INITIALIZATION_FAILED;
+        goto failed;
+    }
+    *out = (GuestMemoryBuffer){buffer, memory, location, size};
+    return VK_SUCCESS;
+failed:
+    vkDestroyBuffer(device, buffer, NULL);
+    if (memory) vkFreeMemory(device, memory, NULL);
+    return result;
+}
diff --git a/tools/test_shader_bounds.c b/tools/test_shader_bounds.c
new file mode 100644
index 0000000..4659f94
--- /dev/null
+++ b/tools/test_shader_bounds.c
@@ -0,0 +1,41 @@
+// Boundary checks for the Maxwell translator's operand helpers. No game files are used.
+#include <assert.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "../runtime/nvn/maxwell/translate.c"
+
+int main(int argc, char **argv) {
+    assert(argc == 2);
+    unsigned mode = (unsigned)strtoul(argv[1], NULL, 10);
+    assert(mode >= 1 && mode <= 12);
+    Ctx *context = calloc(1, sizeof *context);
+    ShaderInfo info = {0};
+    context->info = &info;
+    char buffer[256];
+    if (mode <= 2)
+        reg(context, mode == 1 ? -1 : 256, buffer);
+    else if (mode <= 4)
+        set_reg(context, mode == 3 ? -1 : 256, "0u");
+    else if (mode <= 6)
+        cbuf_ref(context, mode == 5 ? -1 : 18, 0, NULL, buffer);
+    else if (mode == 7)
+        assert(!strcmp(reg(context, 0, buffer), "r0") && context->reg_used[0]);
+    else if (mode == 8)
+        assert(!strcmp(reg(context, 254, buffer), "r254") && context->reg_used[254]);
+    else if (mode == 9)
+        assert(!strcmp(reg(context, 255, buffer), "0u") && !context->reg_used[255]);
+    else if (mode == 10) {
+        set_reg(context, 0, "0u");
+        assert(context->reg_used[0]);
+    } else
+        cbuf_ref(context, mode == 11 ? 17 : 0, 0, NULL, buffer);
+    if (mode <= 6)
+        assert(context->fail && strstr(info.error, "out of range"));
+    else
+        assert(!context->fail);
+    free(context->body.buf);
+    free(context);
+    printf("shader operand mode %u PASS\n", mode);
+    return 0;
+}
