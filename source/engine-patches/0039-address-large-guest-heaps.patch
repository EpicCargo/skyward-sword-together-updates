+    if (result != VK_SUCCESS) goto failed_zero;
+    result = vkBindBufferMemory(device, buffer, memory, 0);
+    if (result != VK_SUCCESS) goto failed_zero;
+    void *mapped = NULL;
+    result = vkMapMemory(device, memory, 0, 4096, 0, &mapped);
+    if (result != VK_SUCCESS) goto failed_zero;
