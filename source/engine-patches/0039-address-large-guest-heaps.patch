@@ -95,6 +95,16 @@ static void fail(Ctx *c, const char *fmt, ...) {
     va_end(ap);
 }
 
+static bool use_reg(Ctx *c, int r) {
+    if (r < 0 || r > RZ) {
+        c->fail = true;
+        snprintf(c->info->error, sizeof c->info->error, "register %d out of range", r);
+        return false;
+    }
+    c->reg_used[r] = 1;
+    return true;
+}
