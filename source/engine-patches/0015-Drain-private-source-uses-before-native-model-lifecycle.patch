diff --git a/runtime/hle/sst_source_lifecycle.c b/runtime/hle/sst_source_lifecycle.c
new file mode 100644
index 0000000..1a9b72e
--- /dev/null
+++ b/runtime/hle/sst_source_lifecycle.c
@@ -0,0 +1,43 @@
+// Private experiment: permanent revocation, never a resumable allocation epoch.
+#include "../hle.h"
+#include "sst_source_lifecycle.h"
+#include "../sst/sst_origin.h"
+#include <stdatomic.h>
+#include <string.h>
+
+static GuestFn source76_original[3];
+static _Atomic bool source76_ready;
+struct { _Atomic uint64_t entries[3],revoked[3]; } sst_source76_lifecycle_stats;
+static const uint64_t source76_addresses[3]={
+    UINT64_C(0x7000ab1334),UINT64_C(0x7000ab3c08),UINT64_C(0x7000ab6dfc)};
+static void source76_lifecycle(Cpu *c,unsigned kind) {
+    atomic_fetch_add(&sst_source76_lifecycle_stats.entries[kind],1);
+    // No guest reads or live actor/health/global/membership eligibility. Arm watch
+    // before registration, not after publication. Even an unarmed original is
+    // bracketed so concurrent first admission cannot pass through its mutation.
+    sst_origin_lifecycle_begin();
+    if(sst_origin_unsupported())atomic_fetch_add(&sst_source76_lifecycle_stats.revoked[kind],1);
+    source76_original[kind](c); // exactly once, unchanged full input/output Cpu
+    sst_origin_lifecycle_end(); // no native reads; all locks released before original
+}
+static void source76_init_models(Cpu *c){source76_lifecycle(c,0);}
+static void source76_dtor(Cpu *c){source76_lifecycle(c,1);}
+static void source76_heap_dtor(Cpu *c){source76_lifecycle(c,2);}
+bool sst_source_lifecycle_ready(void){return atomic_load(&source76_ready);}
+void sst_source_lifecycle_dispatch_init(void) {
+    if(sst_source_lifecycle_ready() || !g_is_skyward || !getenv("SST_VIS73_QUEUE_MODELS") || !getenv("LARECOMP_DEBUG_DATA"))return;
+    const uint32_t guard[3][2]={{0xd10303ff,0xa9066ffc},{0xa9bc5ff8,0xa90157f6},{0xf81e0ff3,0xa9017bfd}};
+    GuestFn originals[3];HostFn hooks[3]={source76_init_models,source76_dtor,source76_heap_dtor};
+    for(unsigned i=0;i<3;i++) {
+        uint32_t words[2];uint64_t method;
+        memcpy(words,(void *)(uintptr_t)source76_addresses[i],sizeof words);
+        memcpy(&method,(void *)(uintptr_t)(UINT64_C(0x7001637d28)+0x78+i*8),sizeof method);
+        if(words[0]!=guard[i][0] || words[1]!=guard[i][1] || method!=source76_addresses[i])return;
+        originals[i]=dispatch_lookup(method);if(!originals[i])return;
+    }
+    // Validate the entire set before installing any hook. dispatch_lookup returns
+    // native originals, not our overrides. This runs before guest dispatch caches.
+    memcpy(source76_original,originals,sizeof originals);
+    for(unsigned i=0;i<3;i++)hle_override(source76_addresses[i],hooks[i],"SST private source lifetime revocation");
+    atomic_store(&source76_ready,true);
+}
