-            source75_in_delayed=false;source75_delayed_ready=false;sst_source75_delay_stats.executed_after_exit++;
+            SstAnimationStats new_palette=sst_animation_stats();SstOriginStats new_origin=sst_origin_stats();
+            bool palette_unchanged=old_palette_hash==sst_animation_teaching_hash() && old_palette.bytes==new_palette.bytes && old_palette.samples==new_palette.samples && old_palette.captures==new_palette.captures && old_palette.attachments==new_palette.attachments;
