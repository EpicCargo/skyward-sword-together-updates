+    if(!sst_origin_replay_requested() || sst_origin_unsupported() || atomic_load(&vis73_failed) || !vis73_queue.active || vis73_queue.seen || vis73_scene_dispatch_depth || !vis72_registered || !vis72_entry_original)return;
     const char *switch_path=getenv("SST_VIS73_QUEUE_SWITCH");int enabled=0;FILE *switch_file=switch_path?fopen(switch_path,"r"):NULL;
     if(switch_file){if(fscanf(switch_file,"%d",&enabled)!=1)enabled=0;fclose(switch_file);}if(enabled!=1)return;
     bool correct_thread;
diff --git a/runtime/nvn/source_policy.h b/runtime/nvn/source_policy.h
new file mode 100644
index 0000000..f36110e
--- /dev/null
+++ b/runtime/nvn/source_policy.h
@@ -0,0 +1,24 @@
+// Consumer guard for the bounded direct-draw source experiment.
+#pragma once
+#include <string.h>
+#include "nvn.h"
+#include "../sst/sst_origin.h"
+// Runs before command payload/child-handle dereference. Forced calls are not
+// supported yet: do not traverse them and hope descendant draws alone are safe.
+static inline bool nvn_source_command_allowed(const CmdRec *record,SstOriginMarker invocation,SstOriginMarker *effective) {
+    SstOriginMarker intrinsic;memcpy(intrinsic.bytes,record->source_origin,sizeof intrinsic.bytes);
+    *effective=sst_origin_combine(intrinsic,invocation);
+    if(!sst_origin_is_forced(*effective))return true;
+    switch(record->op) {
+    case CMD_CALL:
+    case CMD_CLEAR_COLOR: case CMD_CLEAR_DEPTH_STENCIL: case CMD_CLEAR_TEXTURE: case CMD_CLEAR_BUFFER:
+    case CMD_DISPATCH: case CMD_DISPATCH_INDIRECT:
+    case CMD_COPY_BUFFER_TO_BUFFER: case CMD_COPY_BUFFER_TO_TEXTURE: case CMD_COPY_TEXTURE_TO_BUFFER:
+    case CMD_COPY_TEXTURE_TO_TEXTURE: case CMD_DOWNSAMPLE: case CMD_UPDATE_UNIFORM_BUFFER:
+    case CMD_FENCE_SYNC: case CMD_WAIT_SYNC: case CMD_SIGNAL_EVENT: case CMD_WAIT_EVENT:
+    case CMD_REPORT_COUNTER: case CMD_DISCARD_COLOR: case CMD_DISCARD_DEPTH_STENCIL: case CMD_RESOLVE_DEPTH:
+    case CMD_DRAW_ARRAYS_INDIRECT: case CMD_DRAW_ELEMENTS_INDIRECT: case CMD_DRAW_TEXTURE:
+        sst_origin_latch_unsupported();return false;
+    default:return true; // state binds and direct draws use their normal guarded paths
+    }
+}
