+        }
         sst_animation_source_frame(&forced_local.scene,&forced_local.pose,renderer_present_count(),false);
-        if(forced_local.pose.action!=104){sst_source74_render_stats.forced_invalid++;sst_source74_render_stats.native_suppressed++;return;}
+        if(forced_local.pose.action!=104){
+            if(source75_in_delayed && forced_local.pose.action==0)sst_source75_delay_stats.proof_valid_after_exit++;
