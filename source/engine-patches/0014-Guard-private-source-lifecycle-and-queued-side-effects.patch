+uint64_t sst_source75_rebuild_stops;
+static void source75_before_actor_update(uint64_t player) {
+    // These pending bits enter verified same-actor allocation/rebuild paths.
+    // Do not touch the actor's bits or infer complete coverage of other paths.
+    if(ENV("SST_NO_PLAYER_READ") || !ptr(player,0x6b00))return;
+    uint32_t instance=read32(player+8);if(!actor_same(player,instance) || !(read32(player+0x448)&(0x20u|0x80u|0x10000u)))return;
+    bool known=false;
+    pthread_mutex_lock(&source74_mu);
+    for(unsigned role=0;role<4;role++)if(source74_members[role].id.actor_address==player && source74_members[role].id.actor_instance==instance && source74_members[role].id.model_registration_generation)known=true;
+    pthread_mutex_unlock(&source74_mu);
+    if(known && sst_origin_stats().published && !sst_origin_unsupported()) {
+        sst_origin_reset(); // discard optional replay authority, not historical FORCE markers
+        sst_origin_latch_unsupported();sst_source75_rebuild_stops++;
+    }
+}
