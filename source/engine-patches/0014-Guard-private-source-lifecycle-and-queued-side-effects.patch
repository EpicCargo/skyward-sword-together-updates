+            uint64_t old_palette_hash=sst_animation_teaching_hash(),old_hand_hash=sst_hand_teaching_hash();
+            uint64_t old_suppressed=sst_source74_render_stats.native_suppressed,old_peer=sst_source74_render_stats.remote_draws,old_census=sst_source74_render_stats.native_census;
+            draw(&source75_delayed_record,source75_delayed_record.op==CMD_DRAW_ELEMENTS,sst_origin_none());
+            SstAnimationStats new_palette=sst_animation_stats();
+            if(old_palette_hash==sst_animation_teaching_hash() && old_palette.bytes==new_palette.bytes && old_palette.samples==new_palette.samples && old_palette.captures==new_palette.captures && old_palette.attachments==new_palette.attachments)sst_source75_delay_stats.no_palette_teaching++;
+            if(old_hand_hash==sst_hand_teaching_hash())sst_source75_delay_stats.no_hand_teaching++;
