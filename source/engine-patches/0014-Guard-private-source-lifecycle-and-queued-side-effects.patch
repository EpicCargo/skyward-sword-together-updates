@@ -2677,8 +2682,15 @@ static void draw_(CmdRec *r, bool indexed,SstOriginMarker origin) {
     if(forced) {
         sst_source74_render_stats.forced_draws++;
         if(!source74_resolve(origin,&source_proof,&forced_local)){sst_source74_render_stats.forced_invalid++;sst_source74_render_stats.native_suppressed++;return;}
+        const char *request=getenv("SST_TEST_DELAY_SOURCE_REQUEST");
