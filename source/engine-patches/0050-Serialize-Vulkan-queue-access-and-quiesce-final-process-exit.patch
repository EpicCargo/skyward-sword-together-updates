diff --git a/tools/test_queue_guard.c b/tools/test_queue_guard.c
new file mode 100644
index 0000000..97a2c3c
--- /dev/null
+++ b/tools/test_queue_guard.c
@@ -0,0 +1,78 @@
+#define _POSIX_C_SOURCE 200809L
+#include <assert.h>
+#include <pthread.h>
+#include <sched.h>
+#include <stdatomic.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <sys/wait.h>
+#include <time.h>
+#include <unistd.h>
+#include "../runtime/nvn/vulkan/queue_guard.h"
+
+static atomic_uint active, peak, calls, fail_next, trying, finished;
+static pthread_barrier_t start;
+static VkResult driver(void) {
+    unsigned n = atomic_fetch_add(&active, 1) + 1, old = atomic_load(&peak);
+    while (n > old && !atomic_compare_exchange_weak(&peak, &old, n)) {}
+    for (unsigned i = 0; i < 4; ++i) sched_yield();
+    atomic_fetch_add(&calls, 1);
+    atomic_fetch_sub(&active, 1);
+    return atomic_exchange(&fail_next, 0) ? VK_ERROR_DEVICE_LOST : VK_SUCCESS;
+}
+VKAPI_ATTR VkResult VKAPI_CALL vkQueueSubmit2(VkQueue q, uint32_t n, const VkSubmitInfo2 *s, VkFence f) {
+    (void)q; (void)n; (void)s; (void)f; return driver();
+}
+VKAPI_ATTR VkResult VKAPI_CALL vkQueuePresentKHR(VkQueue q, const VkPresentInfoKHR *p) {
+    (void)q; (void)p; return driver();
+}
+VKAPI_ATTR VkResult VKAPI_CALL vkDeviceWaitIdle(VkDevice d) { (void)d; return driver(); }
+
+static void *work(void *argument) {
+    uintptr_t kind = (uintptr_t)argument;
+    pthread_barrier_wait(&start);
+    for (unsigned i = 0; i < 1000; ++i) {
+        if (kind == 0) assert(vk_queue_submit2(VK_NULL_HANDLE, 0, NULL, VK_NULL_HANDLE) == VK_SUCCESS);
+        else if (kind == 1) assert(vk_queue_present(VK_NULL_HANDLE, NULL) == VK_SUCCESS);
+        else if (kind == 2) assert(vk_queue_wait_idle(VK_NULL_HANDLE) == VK_SUCCESS);
+        else {
+            // ImGui performs multiple driver operations under the same public gate.
+            vk_queue_lock(); assert(driver() == VK_SUCCESS); assert(driver() == VK_SUCCESS); vk_queue_unlock();
+        }
+    }
+    return NULL;
+}
+static void *late_submit(void *unused) {
+    (void)unused;
+    atomic_store(&trying, 1);
+    vk_queue_submit2(VK_NULL_HANDLE, 0, NULL, VK_NULL_HANDLE);
+    atomic_store(&finished, 1);
+    return NULL;
+}
+int main(void) {
+    assert(!pthread_barrier_init(&start, NULL, 4));
+    pthread_t threads[4];
+    for (uintptr_t i = 0; i < 4; ++i) assert(!pthread_create(&threads[i], NULL, work, (void *)i));
+    for (unsigned i = 0; i < 4; ++i) assert(!pthread_join(threads[i], NULL));
+    assert(!pthread_barrier_destroy(&start));
+    assert(atomic_load(&calls) == 5000 && atomic_load(&peak) == 1 && !atomic_load(&active));
+    atomic_store(&fail_next, 1);
+    assert(vk_queue_submit2(VK_NULL_HANDLE, 0, NULL, VK_NULL_HANDLE) == VK_ERROR_DEVICE_LOST);
+    assert(vk_queue_wait_idle(VK_NULL_HANDLE) == VK_SUCCESS); // failure did not retain the gate
+    pid_t child = fork();
+    assert(child >= 0);
+    if (!child) {
+        unsigned before = atomic_load(&calls);
+        assert(vk_queue_shutdown_wait_idle(VK_NULL_HANDLE) == VK_SUCCESS);
+        pthread_t late;
+        assert(!pthread_create(&late, NULL, late_submit, NULL));
+        while (!atomic_load(&trying)) sched_yield();
+        struct timespec pause = {.tv_nsec = 50000000};
+        nanosleep(&pause, NULL);
+        _exit(!atomic_load(&finished) && atomic_load(&calls) == before + 1 ? 0 : 1);
+    }
+    int status = 0;
+    assert(waitpid(child, &status, 0) == child && WIFEXITED(status) && WEXITSTATUS(status) == 0);
+    puts("Queue host synchronization PASS: 5000 concurrent calls, error release and terminal gate");
+    return 0;
+}
