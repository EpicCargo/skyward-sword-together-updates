+++ b/runtime/nvn/vulkan/device.c
@@ -365,7 +365,7 @@ static void create_swapchain(void) {
 }
 
 static void recreate_swapchain(void) {
-    vkDeviceWaitIdle(g_vk.dev);
+    vk_queue_wait_idle(g_vk.dev);
     create_swapchain();
 }
 
@@ -493,7 +493,7 @@ void vk_frame_end(const char *shot_path) {
     vk_submit_extra(cur_frame.acquired, done_sem[img], VK_NULL_HANDLE);
     VkPresentInfoKHR pi = {.sType = VK_STRUCTURE_TYPE_PRESENT_INFO_KHR, .waitSemaphoreCount = 1, .pWaitSemaphores = &done_sem[img],
                            .swapchainCount = 1, .pSwapchains = &g_vk.swapchain, .pImageIndices = &img};
-    VkResult r = vkQueuePresentKHR(g_vk.queue, &pi);
+    VkResult r = vk_queue_present(g_vk.queue, &pi);
     if (r == VK_ERROR_OUT_OF_DATE_KHR || r == VK_SUBOPTIMAL_KHR) recreate_swapchain();
     cur_frame.ok = false;
     if (shot_path) {
@@ -704,7 +704,7 @@ static void quick_exit_handler(void) {
     if (trace < 0) trace = getenv("LARECOMP_VK_TRACE") != NULL;
     if (trace) LOG("[vk] exit: waiting for the GPU\n");
     if (g_vk.dev) {
-        vkDeviceWaitIdle(g_vk.dev);
+        vk_queue_shutdown_wait_idle(g_vk.dev);
         if (trace) LOG("[vk] exit: saving the pipeline cache\n");
         vk_pipeline_cache_save();
     }
@@ -839,7 +839,7 @@ void backend_init(void) {
 // ---- in-place reboot (runtime/main.c teardown; main thread, guest threads stopped)
 void backend_reset(void) {
     if (!g_vk.dev) return;
-    vkDeviceWaitIdle(g_vk.dev);
+    vk_queue_wait_idle(g_vk.dev);
     extern void vk_textures_reset(void);
     extern void vk_exec_reset(void);
