diff --git a/runtime/nvn/vulkan/queue_guard.c b/runtime/nvn/vulkan/queue_guard.c
new file mode 100644
index 0000000..cbf5603
--- /dev/null
+++ b/runtime/nvn/vulkan/queue_guard.c
@@ -0,0 +1,29 @@
+#include <pthread.h>
+#include "queue_guard.h"
+
+static pthread_mutex_t queue_gate = PTHREAD_MUTEX_INITIALIZER;
+void vk_queue_lock(void) { pthread_mutex_lock(&queue_gate); }
+void vk_queue_unlock(void) { pthread_mutex_unlock(&queue_gate); }
+
+VkResult vk_queue_submit2(VkQueue queue, uint32_t count, const VkSubmitInfo2 *submits, VkFence fence) {
+    vk_queue_lock();
+    VkResult result = vkQueueSubmit2(queue, count, submits, fence);
+    vk_queue_unlock();
+    return result;  // callers handle errors after releasing the gate
+}
+VkResult vk_queue_present(VkQueue queue, const VkPresentInfoKHR *present) {
+    vk_queue_lock();
+    VkResult result = vkQueuePresentKHR(queue, present);
+    vk_queue_unlock();
+    return result;
+}
+VkResult vk_queue_wait_idle(VkDevice device) {
+    vk_queue_lock();
+    VkResult result = vkDeviceWaitIdle(device);
+    vk_queue_unlock();
+    return result;
+}
+VkResult vk_queue_shutdown_wait_idle(VkDevice device) {
+    vk_queue_lock();
+    return vkDeviceWaitIdle(device);
+}
diff --git a/runtime/nvn/vulkan/queue_guard.h b/runtime/nvn/vulkan/queue_guard.h
new file mode 100644
index 0000000..65271c8
--- /dev/null
+++ b/runtime/nvn/vulkan/queue_guard.h
@@ -0,0 +1,17 @@
+// All host access to the device's queue shares this gate, including ImGui uploads.
+#pragma once
+#include <vulkan/vulkan.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+void vk_queue_lock(void);
+void vk_queue_unlock(void);
+VkResult vk_queue_submit2(VkQueue queue, uint32_t count, const VkSubmitInfo2 *submits, VkFence fence);
+VkResult vk_queue_present(VkQueue queue, const VkPresentInfoKHR *present);
+VkResult vk_queue_wait_idle(VkDevice device);
+// Final process exit only: retains the gate until plat_terminate(), preventing
+// new submissions after idle while the pipeline cache is saved.
+VkResult vk_queue_shutdown_wait_idle(VkDevice device);
+#ifdef __cplusplus
+}
+#endif
