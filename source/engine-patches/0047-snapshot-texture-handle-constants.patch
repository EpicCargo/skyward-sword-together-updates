     uint64_t seq = vk_pending_seq();
@@ -2030,6 +2032,13 @@ static VkDescriptorBufferInfo cbuf_info(int stage, ShaderInfo *si, int k, uint32
         if (size < si->cbuf_size[1]) size = si->cbuf_size[1];
