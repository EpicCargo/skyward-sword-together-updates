diff --git a/tools/test_texture_cbuf.c b/tools/test_texture_cbuf.c
new file mode 100644
index 0000000..5efda0d
--- /dev/null
+++ b/tools/test_texture_cbuf.c
@@ -0,0 +1,51 @@
+// Asset-free c2 layout and submission-snapshot regression.
+#include <assert.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include "../runtime/nvn/texture_cbuf.h"
+
+int main(void) {
+    const uint32_t required[] = {0, 1, 16, 256, 288, 289, 512, 65535, 65536, UINT32_MAX};
+    const size_t expected[] = {288, 288, 288, 288, 288, 304, 512, 65536, 65536, 65536};
+    unsigned cases = 0;
+    for (unsigned i = 0; i < sizeof required / sizeof required[0]; ++i) {
+        assert(nvn_texture_cbuf_size(required[i], false) == expected[i]);
+        assert(nvn_texture_cbuf_size(required[i], true) == 65536);
+        cases += 2;
+    }
+    uint64_t handles[32];
+    for (unsigned i = 0; i < 32; ++i) handles[i] = UINT64_C(0xfedcba9876543200) + i;
+    handles[7] = 0;  // unbound slot between live handles
+    const size_t lengths[] = {0, 1, 31, 32, 33, 39, 40, 287, 288, 289, 512, 65536};
+    for (unsigned i = 0; i < sizeof lengths / sizeof lengths[0]; ++i) {
+        size_t n = lengths[i];
+        uint8_t *allocation = malloc(n + 32);
+        memset(allocation, 0xa5, n + 32);
+        nvn_texture_cbuf_snapshot(allocation + 16, n, handles);
+        for (size_t j = 0; j < n; ++j) {
+            unsigned value = j < 32 || j >= 288 ? 0 :
+                (unsigned)((handles[(j - 32) / 8] >> (8 * ((j - 32) % 8))) & 255);
+            assert(allocation[16 + j] == value);
+        }
+        for (size_t j = 0; j < 16; ++j) assert(allocation[j] == 0xa5 && allocation[16 + n + j] == 0xa5);
+        free(allocation);
+        ++cases;
+    }
+    uint8_t first[288], second[288];
+    nvn_texture_cbuf_snapshot(first, sizeof first, handles);
+    handles[31] = UINT64_C(0x0123456789abcdef);
+    nvn_texture_cbuf_snapshot(second, sizeof second, handles);
+    assert(first[280] == 0x1f && second[280] == 0xef && first[287] == 0xfe && second[287] == 0x01);
+    ++cases;  // rebinding does not mutate the previous submission's snapshot
+    handles[0] = 0;
+    nvn_texture_cbuf_snapshot(second, sizeof second, handles);
+    for (unsigned i = 32; i < 40; ++i) assert(second[i] == 0);
+    assert(first[39] == 0xfe);
+    ++cases;  // unbinding clears all eight bytes without changing the earlier snapshot
+    memset(handles, 0, sizeof handles);
+    nvn_texture_cbuf_snapshot(second, sizeof second, handles);
+    for (unsigned i = 0; i < sizeof second; ++i) assert(second[i] == 0);
+    ++cases;
+    printf("Texture c2 snapshot PASS: %u cases\n", cases);
+    return 0;
+}
