diff --git a/runtime/nvn/texture_cbuf.h b/runtime/nvn/texture_cbuf.h
new file mode 100644
index 0000000..f0d3b6d
--- /dev/null
+++ b/runtime/nvn/texture_cbuf.h
@@ -0,0 +1,29 @@
+// Hardware c2: the same per-stage 64-bit handles used by bound texture reads.
+#pragma once
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+enum { NVN_TEXTURE_CBUF_PREFIX = 0x20, NVN_TEXTURE_CBUF_SLOTS = 32,
+       NVN_TEXTURE_CBUF_MAX = 0x10000 };
+
+static inline size_t nvn_texture_cbuf_size(uint32_t required, bool indexed) {
+    if (indexed || required >= NVN_TEXTURE_CBUF_MAX) return NVN_TEXTURE_CBUF_MAX;
+    size_t size = required;
+    const size_t table_end = NVN_TEXTURE_CBUF_PREFIX + NVN_TEXTURE_CBUF_SLOTS * sizeof(uint64_t);
+    if (size < table_end) size = table_end;
+    return (size + 15) & ~(size_t)15;
+}
+
+// Snapshot into ordinary CPU memory before uploading to a transient GPU buffer.
+// Reserved bytes and reads beyond the bound handle table remain zero.
+static inline void nvn_texture_cbuf_snapshot(void *dst, size_t bytes,
+                                              const uint64_t handles[NVN_TEXTURE_CBUF_SLOTS]) {
+    memset(dst, 0, bytes);
+    if (bytes > NVN_TEXTURE_CBUF_PREFIX) {
+        size_t copy = bytes - NVN_TEXTURE_CBUF_PREFIX;
+        if (copy > NVN_TEXTURE_CBUF_SLOTS * sizeof(uint64_t)) copy = NVN_TEXTURE_CBUF_SLOTS * sizeof(uint64_t);
+        memcpy((uint8_t *)dst + NVN_TEXTURE_CBUF_PREFIX, handles, copy);
+    }
+}
