From b5b53a54055d12d0c7347a533f3efd0a1697e009 Mon Sep 17 00:00:00 2001
From: SST continuation <sst-continuation@localhost>
Date: Fri, 13 Nov 2026 14:16:58 -0500
Subject: [PATCH] Complete four-module manual game rebuilds

---
 Makefile                 | 13 ++++++++++---
 tools/test_build_game.py | 15 +++++++++++++++
 2 files changed, 25 insertions(+), 3 deletions(-)

diff --git a/Makefile b/Makefile
index 6ead281..ff249e9 100644
--- a/Makefile
+++ b/Makefile
@@ -40,7 +40,12 @@ GENFLAGS := -O0 -fno-strict-aliasing -Wno-return-type -Wno-unused-label -fvisibi
 
 # The game code (made by `make gen` from your own game files) is its own library next to the app (runtime/gamelib.h);
 # the app itself holds none of it
-GEN_SRC  := $(wildcard $(GEN)/main/*.c) $(wildcard $(GEN)/sdk/*.c)
+GEN_MODULES := main sdk subsdk0 subsdk1
+GEN_BASE_main := 0x7000000000
+GEN_BASE_sdk := 0x7030000000
+GEN_BASE_subsdk0 := 0x7032000000
+GEN_BASE_subsdk1 := 0x7034000000
+GEN_SRC  := $(foreach module,$(GEN_MODULES),$(wildcard $(GEN)/$(module)/*.c))
 GEN_OBJ  := $(patsubst %.c,$(B)/obj/%.o,$(patsubst $(GEN)/%,%,$(GEN_SRC))) $(B)/obj/tools/gamelib_entry.o
 RT_SRC   := $(wildcard runtime/*.c) $(wildcard runtime/hle/*.c) $(wildcard runtime/services/*.c) \
             $(wildcard runtime/nvn/*.c) $(wildcard runtime/nvn/maxwell/*.c) runtime/platform/$(PLATFORM).c \
@@ -193,8 +198,10 @@ $(B)/imgui/imgui_impl_metal.o: $(IMGUI)/backends/imgui_impl_metal.mm
 PY := $(firstword $(wildcard tools/venv/bin/python) $(wildcard tools/venv/Scripts/python.exe))
 
 gen:
-	cd tools && ../$(PY) gen.py sdk ../extracted/exefs/sdk 0x7004000000 ../$(GEN)/sdk --hle ../runtime/hle/hle_symbols.txt $(GENSIMD)
-	cd tools && ../$(PY) gen.py main ../extracted/exefs/main 0x7000000000 ../$(GEN)/main $(GENSIMD)
+	cd tools && ../$(PY) gen.py main ../extracted/exefs/main $(GEN_BASE_main) ../$(GEN)/main $(GENSIMD)
+	cd tools && ../$(PY) gen.py sdk ../extracted/exefs/sdk $(GEN_BASE_sdk) ../$(GEN)/sdk --hle ../runtime/hle/hle_symbols.txt $(GENSIMD)
+	cd tools && ../$(PY) gen.py subsdk0 ../extracted/exefs/subsdk0 $(GEN_BASE_subsdk0) ../$(GEN)/subsdk0 $(GENSIMD)
+	cd tools && ../$(PY) gen.py subsdk1 ../extracted/exefs/subsdk1 $(GEN_BASE_subsdk1) ../$(GEN)/subsdk1 $(GENSIMD)
 
 gen-objs: $(GEN_OBJ)
 
diff --git a/tools/test_build_game.py b/tools/test_build_game.py
index b8dfc05..d348074 100644
--- a/tools/test_build_game.py
+++ b/tools/test_build_game.py
@@ -1,6 +1,7 @@
 """A new generator version must not reuse objects from an older build."""
 import importlib.util
 from pathlib import Path
+import re
 import tempfile
 import unittest
 from unittest.mock import patch
@@ -29,6 +30,20 @@ class BuildCacheTest(unittest.TestCase):
                     self.assertTrue(builder.compile_unit(str(src), str(obj))[0])
                     self.assertEqual(run.called, not valid)
 
+    def test_makefile_generates_every_loaded_module_at_its_runtime_base(self):
+        root = Path(__file__).resolve().parents[1]
+        makefile = (root / 'Makefile').read_text()
+        runtime = (root / 'runtime/rt.h').read_text()
+        modules = re.search(r'^GEN_MODULES\s*:=\s*(.+)$', makefile, re.MULTILINE).group(1).split()
+        self.assertEqual(modules, ['main', 'sdk', 'subsdk0', 'subsdk1'])
+        runtime_names = {'main': 'MAIN', 'sdk': 'SDK', 'subsdk0': 'SUBSDK0', 'subsdk1': 'SUBSDK1'}
+        for module in modules:
+            with self.subTest(module=module):
+                make_base = re.search(rf'^GEN_BASE_{module}\s*:=\s*(0x[0-9a-f]+)$', makefile, re.MULTILINE).group(1)
+                runtime_base = re.search(rf'^#define\s+{runtime_names[module]}_BASE\s+(0x[0-9a-f]+)ull$', runtime, re.MULTILINE).group(1)
+                self.assertEqual(make_base, runtime_base)
+                self.assertIn(f'gen.py {module} ../extracted/exefs/{module} $(GEN_BASE_{module}) ../$(GEN)/{module}', makefile)
+
 
 if __name__ == '__main__':
     unittest.main()
